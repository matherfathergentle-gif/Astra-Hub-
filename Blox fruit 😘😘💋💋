-- Wraps the game's CommF_ remote. Its calls are undocumented and may change.
local Remotes = { commF = nil, lastWarning = 0 }

---Find CommF_ without throwing.
---@return RemoteFunction?
function Remotes.getCommF()
	if Remotes.commF and Remotes.commF.Parent then
		return Remotes.commF
	end

	local folder = replicatedStorage:FindFirstChild("Remotes")
	local remote = folder and folder:FindFirstChild("CommF_")

	if remote and remote:IsA("RemoteFunction") then
		Remotes.commF = remote
		return remote
	end

	if os.clock() - Remotes.lastWarning > 30 then
		Remotes.lastWarning = os.clock()
		Logger.warn("Remotes", "ReplicatedStorage.Remotes.CommF_ not found")
	end

	return nil
end

---Invoke CommF_ safely.
---@return boolean, any
function Remotes.invoke(...)
	local commF = Remotes.getCommF()
	if not commF then
		return false, "CommF_ unavailable"
	end

	local success, result = pcall(commF.InvokeServer, commF, ...)
	if not success then
		return false, firstLine(result)
	end

	return true, result
end

--------------------------------------------------------------------------------
-- Movement: one controller, one owner at a time.
--------------------------------------------------------------------------------

local Movement = {
	owner = nil,
	tween = nil,
	token = 0,
	originals = {},
	noclipConnection = nil,
}

---Enable or disable temporary noclip. Original collision values are restored.
---@param enabled boolean
function Movement.setNoclip(enabled)
	if enabled then
		if Movement.noclipConnection then
			return
		end

		local model = Character.get()
		if not model then
			return
		end

		local parts = {}

		for _, descendant in model:GetDescendants() do
			if descendant:IsA("BasePart") then
				Movement.originals[descendant] = descendant.CanCollide
				table.insert(parts, descendant)
			end
		end

		Movement.noclipConnection = runService.Stepped:Connect(function()
			for _, part in parts do
				part.CanCollide = false
			end

			local _, _, root = Character.get()
			if root then
				root.AssemblyLinearVelocity = Vector3.zero
			end
		end)

		return
	end

	if Movement.noclipConnection then
		Movement.noclipConnection:Disconnect()
		Movement.noclipConnection = nil
	end

	for part, original in Movement.originals do
		if part.Parent then
			part.CanCollide = original
		end
	end

	table.clear(Movement.originals)
end

---Cancel the current movement. Pass an owner to cancel only that owner's movement.
---@param owner string?
function Movement.cancel(owner)
	if owner and Movement.owner ~= owner then
		return
	end

	Movement.token += 1

	if Movement.tween then
		Movement.tween:Cancel()
		Movement.tween = nil
	end

	Movement.owner = nil
	Movement.setNoclip(false)
end

---Place the character instantly if nobody else owns movement.
---@param owner string
---@param targetCFrame CFrame
---@return boolean
function Movement.place(owner, targetCFrame)
	if Movement.owner and Movement.owner ~= owner then
		return false
	end

	local _, _, root = Character.get()
	if not root then
		return false
	end

	root.CFrame = targetCFrame
	root.AssemblyLinearVelocity = Vector3.zero
	return true
end

---Move to a CFrame. Returns true on arrival, or false plus a reason.
---@param owner string
---@param targetCFrame CFrame
---@param shouldAbort function?
---@return boolean, string?
function Movement.moveTo(owner, targetCFrame, shouldAbort)
	if Movement.owner and Movement.owner ~= owner then
		return false, "busy"
	end

	local _, _, root = Character.get()
	if not root then
		return false, "character lost"
	end

	local distance = (root.Position - targetCFrame.Position).Magnitude
	if distance <= DIRECT_MOVE_RANGE then
		if Movement.place(owner, targetCFrame) then
			return true, nil
		end

		return false, "character lost"
	end

	Movement.token += 1
	local token = Movement.token
	Movement.owner = owner

	local duration = distance / Config.get("moveSpeed")
	local tween = tweenService:Create(root, TweenInfo.new(duration, Enum.EasingStyle.Linear), { CFrame = targetCFrame })

	Movement.tween = tween
	Movement.setNoclip(true)
	tween:Play()

	local startedAt = os.clock()
	local arrived, reason = true, nil

	while os.clock() - startedAt < duration do
		task.wait()

		if Movement.token ~= token then
			arrived, reason = false, "cancelled"
			break
		end

		if shouldAbort and shouldAbort() then
			arrived, reason = false, "aborted"
			break
		end

		if not Character.get() then
			arrived, reason = false, "character lost"
			break
		end
	end

	-- Only clean up if a newer move has not taken over.
	if Movement.token == token then
		tween:Cancel()
		Movement.tween = nil
		Movement.owner = nil
		Movement.setNoclip(false)

		if arrived then
			Movement.place(owner, targetCFrame)
		end
	end

	return arrived, reason
end

---Hold the character in place, running an update callback every frame. Returns a release function,
---or nil when another owner is moving the character.
---@param owner string
---@param update function
---@return function?
function Movement.hold(owner, update)
	if Movement.owner and Movement.owner ~= owner then
		return nil
	end

	Movement.owner = owner
	Movement.token += 1

	local token = Movement.token
	local failures = 0
	local connection = nil

	Movement.setNoclip(true)

	connection = runService.Heartbeat:Connect(function()
		if Movement.token ~= token then
			connection:Disconnect()
			return
		end

		local success, errorMessage = pcall(update)

		if not success then
			failures += 1
			Logger.error("Movement", "Hold update failed: %s", firstLine(errorMessage))

			if failures >= 20 then
				connection:Disconnect()
			end
		end
	end)

	local released = false

	return function()
		if released then
			return
		end

		released = true
		connection:Disconnect()

		-- A newer move or cancel owns the state now, leave it alone.
		if Movement.token == token then
			Movement.owner = nil
			Movement.setNoclip(false)
		end
	end
end

