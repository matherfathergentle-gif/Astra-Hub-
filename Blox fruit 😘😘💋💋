local playerGui = localPlayer:WaitForChild("PlayerGui")

-- Owns the character lifecycle so no other module caches stale references.
local Character = {
	model = nil,
	humanoid = nil,
	root = nil,
	alive = false,
	changed = Signal.new(),
	maid = Maid.new(),
}

---Bind a new character model and wait for its parts.
---@param model Model
function Character.bind(model)
	Character.maid:clean()
	Character.model = model
	Character.humanoid = nil
	Character.root = nil
	Character.alive = false
	Character.changed:fire("replaced")

	task.spawn(function()
		local humanoid = model:WaitForChild("Humanoid", 10)
		local root = model:WaitForChild("HumanoidRootPart", 10)

		-- A newer character may have replaced this one while we waited.
		if Character.model ~= model then
			return
		end

		if not (humanoid and root) then
			Logger.warn("Character", "Humanoid or HumanoidRootPart missing")
			return
		end

		Character.humanoid = humanoid
		Character.root = root
		Character.alive = humanoid.Health > 0

		Character.maid:add(humanoid.Died:Connect(function()
			Character.alive = false
			Character.changed:fire("died")
		end))

		Character.maid:add(model.AncestryChanged:Connect(function(_, parent)
			if not parent then
				Character.alive = false
				Character.changed:fire("removed")
			end
		end))

		Character.changed:fire("ready")
	end)
end

---Return model, humanoid and root when the character is usable.
---@return Model?, Humanoid?, BasePart?
function Character.get()
	local humanoid, root = Character.humanoid, Character.root

	if not (Character.alive and humanoid and root and root.Parent and humanoid.Health > 0) then
		return nil, nil, nil
	end

	return Character.model, humanoid, root
end

---Current health as a percentage, or nil without a character.
---@return number?
function Character.healthPercent()
	local _, humanoid = Character.get()
	if not humanoid or humanoid.MaxHealth <= 0 then
		return nil
	end

	return humanoid.Health / humanoid.MaxHealth * 100
end

---Start listening for characters.
function Character.init()
	Character.connection = localPlayer.CharacterAdded:Connect(Character.bind)

	if localPlayer.Character then
		Character.bind(localPlayer.Character)
	end
end

---Disconnect everything.
function Character.destroy()
	if Character.connection then
		Character.connection:Disconnect()
		Character.connection = nil
	end

	Character.maid:clean()
end

-- Reads progression values defensively.
local Progression = {}

---@param name string
---@return number?
local function readDataValue(name)
	local data = localPlayer:FindFirstChild("Data")
	local value = data and data:FindFirstChild(name)

	if value and type(value.Value) == "number" then
		return value.Value
	end

	return nil
end

---@return number?
function Progression.level()
	return readDataValue("Level")
end

---@return number?
function Progression.points()
	return readDataValue("Points")
