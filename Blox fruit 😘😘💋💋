	filterButton = logButton(1, "Filter: All", function()
		local index = table.find(logFilters, logFilter) or 0
		logFilter = logFilters[index % #logFilters + 1]
		filterButton.Text = "Filter: " .. logFilter
		lastLogVersion = -1
	end)

	logButton(2, "Diagnose", function()
		task.spawn(function()
			local success, errorMessage = pcall(Diagnostics.run)
			if not success then
				Logger.error("Diag", "Diagnostics failed: %s", firstLine(errorMessage))
			end
		end)
	end)

	logButton(3, "Copy", function()
		if not Dependencies.has("setclipboard") then
			Notify.push("Copy needs setclipboard", "WARN")
			return
		end

		local lines = {}

		for _, entry in Logger.entries do
			table.insert(lines, string.format("%s [%s] %s: %s", entry.time, entry.level, entry.category, entry.message))
		end

		setclipboard(table.concat(lines, "\n"))
		Notify.push("Logs copied", "INFO")
	end)

	logButton(4, "Clear", function()
		Logger.clear()
	end)

	for index = 1, LOG_VIEW_LIMIT do
		logLabels[index] = create("TextLabel", {
			LayoutOrder = nextOrder(logsPage),
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundTransparency = 1,
			Font = Enum.Font.Code,
			Text = "",
			TextColor3 = THEME.subtext,
			TextSize = 11,
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			Visible = false,
			Parent = logsPage,
		})
	end

	table.insert(refreshers, function()
		if lastLogVersion == Logger.version or not pages.Logs.Visible then
			return
		end

		lastLogVersion = Logger.version

		local nearBottom = logsPage.CanvasPosition.Y + logsPage.AbsoluteWindowSize.Y >= logsPage.AbsoluteCanvasSize.Y - 40
		local visible = {}

		for index = #Logger.entries, 1, -1 do
			local entry = Logger.entries[index]
			local include = logFilter == "All"
				or (logFilter == "Errors" and entry.level ~= "INFO")
				or (logFilter == "State" and entry.category == "State")

			if include then
				table.insert(visible, 1, entry)

				if #visible >= LOG_VIEW_LIMIT then
					break
				end
			end
		end

		for index, label in logLabels do
			local entry = visible[index]

			if entry then
				local suffix = entry.count > 1 and string.format(" (x%d)", entry.count) or ""
				label.Text = string.format("%s %s %s: %s%s", entry.time, entry.level, entry.category, entry.message, suffix)
				label.TextColor3 = LEVEL_COLORS[entry.level] or THEME.subtext
				label.Visible = true
			else
				label.Visible = false
			end
		end

		if nearBottom then
			task.delay(0.05, function()
				if logsPage.Parent then
					logsPage.CanvasPosition = Vector2.new(0, 1e6)
				end
			end)
		end
	end)

	-- Refresh loop. Interval comes from settings and every refresher is isolated.
	local refreshActive = true
	maid:add(function()
		refreshActive = false
	end)

	task.spawn(function()
		while refreshActive do
			for _, refresher in refreshers do
				local success, errorMessage = pcall(refresher)
				if not success then
					Logger.error("Gui", "%s", firstLine(errorMessage))
				end
			end

			task.wait(Config.get("refreshInterval"))
		end
	end)

	selectTab("Dashboard")
end

---Destroy the interface.
function Gui.destroy()
	Gui.maid:clean()
	Gui.root = nil
end

--------------------------------------------------------------------------------
-- Application lifecycle.
--------------------------------------------------------------------------------

local Vantex = { maid = Maid.new() }

---Apply settings that touch the engine.
---@param key string
---@param value any
local function onConfigChanged(key, value)
	if key == "notifications" then
		Notify.mode = value
	elseif key == "hoverHeight" then
		-- A new setting deserves a fresh reach test.
		Combat.hoverCap = nil
		Combat.verifiedHover = nil
		Combat.hoverMisses = 0
	elseif key == "bringMobs" then
		if value and Farm.running then
			Bring.start()
		elseif not value then
			Bring.stop()
		end
	elseif key == "fpsCap" and value > 0 and Dependencies.has("setfpscap") then
		setfpscap(value)
	end
end

---Stop everything and release every resource.
function Vantex.detach()
	Logger.info("Core", "Detaching")
	Features.stopAll()
	Farm.stop("detached")
	Bring.stop()
	Navigation.cancel()
	Movement.cancel()
	Config.save()
	Character.destroy()
	Gui.destroy()
	Vantex.maid:clean()

	if shared.VantexHub == Vantex then
		shared.VantexHub = nil
	end
end

---Start the hub.
function Vantex.init()
	Logger.info("Core", "%s starting", HUB_NAME)

	local missing = Dependencies.missing({ "request", "writefile", "readfile", "isfile", "setclipboard", "setfpscap", "mouse1click", "gethui" })
	if #missing > 0 then
		Logger.warn("Core", "Optional executor functions missing: %s", table.concat(missing, ", "))
	end

	Config.load()
	Notify.mode = Config.get("notifications")

	local problems = Quests.validate()
	if problems > 0 then
		Logger.error("Quests", "%d invalid quest entries were found", problems)
	end

	if not currentSea() then
		Logger.warn("Core", "Place %d is not a known sea. Pick the sea in Settings to enable Auto Farm", game.PlaceId)
	end

	Vantex.maid:add(Config.changed:connect(onConfigChanged).disconnect)

	Vantex.maid:add(teleportService.TeleportInitFailed:Connect(function(_, result, message)
		Notify.push(string.format("Teleport failed: %s", tostring(message ~= "" and message or result)), "ERROR")
	end))

	-- Anti-AFK so the idle kick does not interrupt long sessions.
	Vantex.maid:add(localPlayer.Idled:Connect(function()
		virtualUser:CaptureController()
		virtualUser:ClickButton2(Vector2.new())
	end))

	Character.init()

	-- Movement must not outlive the character it was moving.
	Vantex.maid:add(Character.changed:connect(function(event)
		if event == "died" or event == "removed" or event == "replaced" then
			Movement.cancel()
		end
	end).disconnect)

	Vantex.maid:add(Farm.changed:connect(function()
		Features.changed:fire("AutoFarm")
	end).disconnect)

	local built, errorMessage = pcall(Gui.build)
	if not built then
		Logger.error("Gui", "Interface failed to build: %s", firstLine(errorMessage))
		warn("[VANTEX] " .. firstLine(errorMessage))
	end

	for key, value in Config.values do
		onConfigChanged(key, value)
	end

	Notify.push(HUB_NAME .. " ready. Right Ctrl hides the window.", "INFO")
end

shared.VantexHub = Vantex
Vantex.init()
