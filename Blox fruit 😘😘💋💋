}

---Run a callback on an interval. Returns a stop function, repeated failures stop the loop.
---@param name string
---@param interval number
---@param callback function
---@param onFatal function?
---@return function
local function startLoop(name, interval, callback, onFatal)
	local active = true

	task.spawn(function()
		local failures = 0

		while active do
			local success, errorMessage = xpcall(callback, function(message)
				return tostring(message)
			end)

			if success then
				failures = 0
			else
				failures += 1
				Logger.error(name, "%s", firstLine(errorMessage))

				if failures >= LOOP_FATAL_ERRORS then
					active = false

					if onFatal then
						onFatal(name .. " stopped after repeated errors")
					end

					break
				end
			end

			task.wait(interval)
		end
	end)

	return function()
		active = false
	end
end

---@param definition table
local function defineFeature(definition)
	definition.maid = Maid.new()
	definition.enabled = false
	table.insert(Features.list, definition)
	Features.byKey[definition.key] = definition
end

---@param feature table
---@return boolean
function Features.isEnabled(feature)
	if feature.isEnabled then
		return feature.isEnabled()
	end

	return feature.enabled
end

---Report whether a feature can run right now.
---@param feature table
---@return boolean, string?
function Features.available(feature)
	if feature.compat == "UNSUPPORTED" then
		return false, feature.note or "Unsupported"
	end

	if feature.requires then
		local missing = Dependencies.missing(feature.requires)
		if #missing > 0 then
			return false, "Missing executor functions: " .. table.concat(missing, ", ")
		end
	end

	return true, nil
end

---Effective compatibility key, accounting for missing dependencies.
---@param feature table
---@return string
function Features.effectiveCompat(feature)
	if feature.compat ~= "UNSUPPORTED" and feature.requires and #Dependencies.missing(feature.requires) > 0 then
		return "DEPENDENCIES"
	end

	return feature.compat
end

---@param key string
---@return string
function Features.status(key)
	local feature = Features.byKey[key]
	if not (feature and Features.isEnabled(feature)) then
		return "OFF"
	end

	if key == "AutoFarm" and Farm.paused then
		return "PAUSED"
	end

	return "ON"
end

---Enable or disable a feature through one code path.
---@param key string
---@param enabled boolean
---@return boolean
function Features.setEnabled(key, enabled)
	local feature = Features.byKey[key]
	if not feature then
		return false
	end

	if Features.isEnabled(feature) == enabled then
		return true
	end

	if enabled then
		local available, reason = Features.available(feature)
		if not available then
			Notify.push(feature.name .. " unavailable: " .. tostring(reason), "WARN")
			return false
		end

		feature.enabled = true
		local success, errorMessage = pcall(feature.start, feature)

		if not success then
			feature.enabled = false
			feature.maid:clean()
			Logger.error("Features", "%s failed to start: %s", feature.name, firstLine(errorMessage))
			Features.changed:fire(key)
			return false
		end
	else
		feature.enabled = false

		local success, errorMessage = pcall(feature.stop, feature)
		if not success then
			Logger.error("Features", "%s failed to stop cleanly: %s", feature.name, firstLine(errorMessage))
		end

		feature.maid:clean()
	end

	Logger.info("Features", "%s %s", feature.name, enabled and "enabled" or "disabled")
	Features.changed:fire(key)
	return true
end

---Disable every feature.
function Features.stopAll()
	for _, feature in Features.list do
		if feature.kind == "toggle" and Features.isEnabled(feature) then
			Features.setEnabled(feature.key, false)
		end
	end
end

---@param feature table
---@return function
local function fatalHandler(feature)
	return function(message)
		Notify.push(feature.name .. ": " .. message, "ERROR")
		task.defer(Features.setEnabled, feature.key, false)
	end
end

