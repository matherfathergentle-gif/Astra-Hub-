local Quests = {}

---Check every quest list for malformed entries.
---@return number
function Quests.validate()
	local problems = 0

	for sea, list in QUEST_LISTS do
		local previous = 0

		for index, entry in list do
			local valid = type(entry[1]) == "number"
				and type(entry[2]) == "string"
				and type(entry[3]) == "number"
				and type(entry[4]) == "string"
				and entry[1] > previous
				and (entry[5] == nil or typeof(entry[5]) == "Vector3")
				and (entry[6] == nil or typeof(entry[6]) == "Vector3")
				and (entry[7] == nil or typeof(entry[7]) == "Vector3")
				and (entry[8] == nil or type(entry[8]) == "string")

			if not valid then
				problems += 1
				Logger.error("Quests", "Invalid quest entry %d in sea %d", index, sea)
			end

			previous = type(entry[1]) == "number" and entry[1] or previous
		end
	end

	return problems
end

---Select the highest quest unlocked at a level.
---@param level number
---@return table?, string?
function Quests.select(level)
	local list = QUEST_LISTS[currentSea() or 0]
	if not list then
		return nil, "No quest data for this place, set the sea in Settings"
	end

	local picked = nil

	for _, entry in list do
		if level >= entry[1] then
			picked = entry
		end
	end

	if not picked then
		return nil, "No quest unlocked at level " .. tostring(level)
	end

	return {
		name = picked[2],
		index = picked[3],
		mob = picked[4],
		npcPosition = picked[5],
		campPosition = picked[6],
		entrance = picked[7],
		entry = picked[8],
		minLevel = picked[1],
	}, nil
end

---Read the quest UI. Returns a table or nil plus a reason.
---@return table?, string?
function Quests.readActive()
	local main = playerGui:FindFirstChild("Main")
	local questGui = main and main:FindFirstChild("Quest")

	if not questGui then
		return nil, "Quest UI not found"
	end

	local container = questGui:FindFirstChild("Container")
	local holder = container and container:FindFirstChild("QuestTitle")
	local label = holder and holder:FindFirstChild("Title")
	local title = label and label:IsA("TextLabel") and label.Text or ""

	return { visible = questGui.Visible, title = title }, nil
end

---Check whether the active quest targets this quest's mob.
---@param quest table
---@return boolean, string?
function Quests.isActiveFor(quest)
	local info, reason = Quests.readActive()
	if not info then
		return false, reason
	end

	return info.visible and string.find(info.title, quest.mob, 1, true) ~= nil, nil
end

