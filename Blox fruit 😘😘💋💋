local Diagnostics = {}

---Run every dependency and state check, report it in the log, and copy the report.
---@return number, number
function Diagnostics.run()
	local lines = {}
	local passed, failed = 0, 0

	---@param name string
	---@param ok boolean
	---@param detail string?
	local function check(name, ok, detail)
		local text = detail and string.format("%s: %s", name, detail) or name
		table.insert(lines, (ok and "PASS " or "FAIL ") .. text)

		if ok then
			passed += 1
			Logger.info("Diag", "PASS %s", text)
		else
			failed += 1
			Logger.warn("Diag", "FAIL %s", text)
		end
	end

	local sea = currentSea()
	check("Supported place", sea ~= nil, string.format("PlaceId %d, sea %s", game.PlaceId, tostring(sea or "unknown, set it in Settings")))

	local model, _, root = Character.get()
	check("Live character", root ~= nil)

	local location = localPlayer:GetAttribute("CurrentLocation")
	check("CurrentLocation attribute", location ~= nil, tostring(location))

	local level = Progression.level()
	check("Data.Level readable", level ~= nil, level and ("level " .. tostring(level)) or "Player.Data.Level missing")

	local questInfo, questProblem = Quests.readActive()
	local questDetail = questProblem

	if questInfo then
		questDetail = questInfo.visible and "quest visible" or "no active quest"
	end

	check("Quest UI found", questInfo ~= nil, questDetail)

	local quest = level and Quests.select(level) or nil
	check("Quest selected", quest ~= nil, quest and (quest.name .. " -> " .. quest.mob) or "none for this level or place")
	check("workspace.Enemies", workspace:FindFirstChild("Enemies") ~= nil)

	if quest and root then
		local enemy, distance = Enemies.nearest(quest.mob, root.Position)
		local detail = "none loaded, travel to the camp first"

		if enemy then
			detail = string.format("%d studs away", math.floor(distance))
		end

		check("Quest mob loaded", enemy ~= nil, detail)
	end

	check("CommF_ remote", Remotes.getCommF() ~= nil)

	local toolType = Config.get("weaponType")
	local hasTool = false
	local containers = {}
	local backpack = localPlayer:FindFirstChild("Backpack")

	if model then
		table.insert(containers, model)
	end

	if backpack then
		table.insert(containers, backpack)
	end

	for _, container in containers do
		for _, child in container:GetChildren() do
			if child:IsA("Tool") and child.ToolTip == toolType then
				hasTool = true
			end
		end
	end

	check(toolType .. " tool available", hasTool, not hasTool and ("equip or buy a " .. toolType .. " weapon") or nil)

	local attackRemote, hitRemote = Combat.resolveRemotes(true)
	check("RegisterAttack remote", attackRemote ~= nil)
	check("RegisterHit remote", hitRemote ~= nil)
	check("Hit session value", Combat.sessionId() ~= nil, "only the session profiles use it")

	local profile = Combat.currentProfile()
	local verified = Combat.verifiedIndex == Combat.profileIndex and "verified" or "not verified yet"
	check("Hit profile", true, profile.name .. " (" .. verified .. ")")

	local controller, controllerReason = Combat.controller()
	local controllerDetail = controllerReason

	if controller then
		controllerDetail = type(controller.active) == "table" and "weapon active" or "found, equip a weapon to activate it"
	end

	check("Game combat controller", controller ~= nil, controllerDetail)

	local missing = Dependencies.missing({ "request", "writefile", "readfile", "isfile", "setclipboard", "gethui", "getgenv", "getrenv" })
	check("Executor functions", #missing == 0, #missing > 0 and ("missing " .. table.concat(missing, ", ")) or nil)
	check("debug.getupvalues", type(debug.getupvalues) == "function")

	local canRaiseRadius = Dependencies.has("setsimulationradius") or Dependencies.has("sethiddenproperty")
	check("Simulation radius control", canRaiseRadius, not canRaiseRadius and "bring mobs will not replicate" or nil)

	local canCheckOwner = Dependencies.has("isnetworkowner")
	check("isnetworkowner", canCheckOwner, not canCheckOwner and "failed bring cannot be detected" or nil)

	if Dependencies.has("setclipboard") then
		pcall(setclipboard, table.concat(lines, "\n"))
	end

	Notify.push(string.format("Diagnostics: %d passed, %d failed", passed, failed), failed > 0 and "WARN" or "INFO")
	return passed, failed
end

