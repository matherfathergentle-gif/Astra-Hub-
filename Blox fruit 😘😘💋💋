---@param name string
---@return boolean
function Dependencies.has(name)
	local cached = Dependencies.cache[name]
	if cached ~= nil then
		return cached
	end

	local success, value = pcall(function()
		return getgenv()[name]
	end)

	local found = success and value ~= nil

	-- Some executors only expose functions in the running script's environment.
	if not found then
		local envSuccess, envValue = pcall(function()
			return getfenv(1)[name]
		end)

		found = envSuccess and envValue ~= nil
	end

	Dependencies.cache[name] = found
	return found
end

---Return the names from a list that are missing.
---@param names table
---@return table
function Dependencies.missing(names)
	local missing = {}

	for _, name in names do
		if not Dependencies.has(name) then
			table.insert(missing, name)
		end
	end

	return missing
end

-- Ring-buffer log shared by every module.
local Logger = {
	entries = {},
	changed = Signal.new(),
	lastNotice = "No notices yet",
	version = 0,
}

---Add a log entry. Identical consecutive entries are merged.
---@param level string
---@param category string
---@param message string
function Logger.add(level, category, message)
	local previous = Logger.entries[#Logger.entries]
	Logger.version += 1

	if previous and previous.level == level and previous.category == category and previous.message == message then
		previous.count += 1
	else
		table.insert(Logger.entries, {
			time = os.date("%H:%M:%S"),
			level = level,
			category = category,
			message = message,
			count = 1,
		})

		if #Logger.entries > LOG_LIMIT then
			table.remove(Logger.entries, 1)
		end
	end

	if level ~= "INFO" or category == "Notice" then
		Logger.lastNotice = string.format("%s [%s] %s", os.date("%H:%M:%S"), level, message)
	end

	Logger.changed:fire()
end

---Log an informational entry.
function Logger.info(category, ...)
	Logger.add("INFO", category, formatMessage(...))
end

---Log a warning.
function Logger.warn(category, ...)
	Logger.add("WARN", category, formatMessage(...))
end

---Log an error.
function Logger.error(category, ...)
	Logger.add("ERROR", category, formatMessage(...))
end

---Remove every entry.
function Logger.clear()
	table.clear(Logger.entries)
	Logger.version += 1
	Logger.changed:fire()
end

-- User-visible notifications, filtered by the notification setting.
local Notify = { shown = Signal.new(), mode = "All", lastMessage = nil, lastAt = 0 }

---Push a notification and log it.
---@param message string
---@param level string?
function Notify.push(message, level)
	level = level or "INFO"
	Logger.add(level, "Notice", message)

	if Notify.mode == "Off" then
		return
	end

	if Notify.mode == "Errors" and level == "INFO" then
		return
	end

	-- Skip a toast identical to the previous one so loops cannot spam the screen.
	local now = os.clock()
	if message == Notify.lastMessage and now - Notify.lastAt < 2 then
		return
	end

	Notify.lastMessage, Notify.lastAt = message, now
	Notify.shown:fire(message, level)
end

--------------------------------------------------------------------------------
-- Configuration with schema validation.
--------------------------------------------------------------------------------

local SCHEMA = {
	uiScale = { kind = "number", default = 1, min = 0.7, max = 1.4 },
	notifications = { kind = "enum", default = "All", options = { "All", "Errors", "Off" } },
	refreshInterval = { kind = "number", default = 0.5, min = 0.25, max = 2 },
	autoQuest = { kind = "boolean", default = true },
	hoverHeight = { kind = "number", default = 20, min = 4, max = 150 },
	attackRate = { kind = "number", default = 30, min = 4, max = 120 },
	maxTargets = { kind = "number", default = 8, min = 1, max = 20 },
	bringMobs = { kind = "boolean", default = true },
	bringRange = { kind = "number", default = 250, min = 60, max = 400 },
	hitRange = { kind = "number", default = 150, min = 20, max = 500 },
	multiHit = { kind = "boolean", default = true },
	seaOverride = { kind = "enum", default = "Auto", options = { "Auto", "1", "2", "3" } },
	stopAtLevel = { kind = "number", default = 0, min = 0, max = 3000 },
	moveSpeed = { kind = "number", default = 250, min = 100, max = 350 },
	retreatPercent = { kind = "number", default = 35, min = 0, max = 60 },
	inputMethod = { kind = "enum", default = "VirtualUser", options = { "VirtualUser", "Mouse" } },
	hitMethod = { kind = "enum", default = "Auto", options = { "Auto", "Game", "Remote", "Click" } },
	hitProfileSaved = { kind = "string", default = "", maxLength = 60 },
	weaponType = { kind = "enum", default = "Melee", options = { "Melee", "Sword" } },
	statTarget = { kind = "enum", default = "Melee", options = { "Melee", "Defense", "Sword", "Gun", "Demon Fruit" } },
	fpsCap = { kind = "number", default = 0, min = 0, max = 360 },
}

local Config = { values = {}, changed = Signal.new(), saveQueued = false }

---Validate a raw value against a field definition. Returns nil when invalid.
---@param field table
---@param value any
---@return any
local function coerce(field, value)
	if field.kind == "number" then
		if type(value) ~= "number" or value ~= value or math.abs(value) == math.huge then
			return nil
		end

		return math.clamp(value, field.min, field.max)
	end

	if field.kind == "boolean" then
		if type(value) ~= "boolean" then
			return nil
		end

		return value
	end

	if field.kind == "string" then
		if type(value) ~= "string" or #value > field.maxLength then
			return nil
		end

		return value
	end

	if field.kind == "enum" and table.find(field.options, value) then
		return value
	end

	return nil
end

---Reset values to defaults without firing change events.
function Config.reset()
	for key, field in SCHEMA do
		Config.values[key] = field.default
	end
end

---Read a value.
---@param key string
---@return any
function Config.get(key)
	return Config.values[key]
end

---Validate and store a value.
---@param key string
---@param value any
---@return boolean
function Config.set(key, value)
	local field = SCHEMA[key]
	if not field then
		return false
	end

	local valid = coerce(field, value)
	if valid == nil then
		Logger.warn("Config", "Rejected invalid value for %s", key)
		return false
	end

	if Config.values[key] == valid then
		return true
	end

	Config.values[key] = valid
	Config.changed:fire(key, valid)
	Config.queueSave()
	return true
end

---Restore every setting to its default and notify listeners.
function Config.resetToDefaults()
	for key, field in SCHEMA do
		Config.set(key, field.default)
	end

	Logger.info("Config", "Settings reset to defaults")
end

---Save after a short delay so rapid slider drags write once.
function Config.queueSave()
	if Config.saveQueued then
		return
	end

	Config.saveQueued = true
	task.delay(0.5, Config.save)
end

---Write the config file.
---@return boolean
function Config.save()
	Config.saveQueued = false

	if not Dependencies.has("writefile") then
		return false
	end

	local success, errorMessage = pcall(function()
		writefile(CONFIG_FILE, httpService:JSONEncode({ version = CONFIG_VERSION, values = Config.values }))
	end)

	if not success then
		Logger.error("Config", "Save failed: %s", firstLine(errorMessage))
	end

	return success
end

---Load and validate the config file. Invalid fields fall back to defaults.
---@return boolean
function Config.load()
	Config.reset()

	if not (Dependencies.has("isfile") and Dependencies.has("readfile")) then
		Logger.warn("Config", "File functions unavailable, settings will not persist")
		return false
	end

	if not isfile(CONFIG_FILE) then
		Logger.info("Config", "No saved config, using defaults")
		return true
	end

	local success, decoded = pcall(function()
		return httpService:JSONDecode(readfile(CONFIG_FILE))
	end)

	if not (success and type(decoded) == "table" and type(decoded.values) == "table") then
		Logger.warn("Config", "Saved config is malformed and was ignored")
		return false
	end

	if decoded.version ~= CONFIG_VERSION then
		Logger.warn("Config", "Saved config has an unknown version and was ignored")
		return false
	end

	local rejected = 0

	for key, field in SCHEMA do
		local raw = decoded.values[key]

		if raw ~= nil then
			local valid = coerce(field, raw)

			if valid == nil then
				rejected += 1
			else
				Config.values[key] = valid
			end
		end
	end

	if rejected > 0 then
		Logger.warn("Config", "%d invalid saved values were replaced by defaults", rejected)
	end

	return true
end

---The sea this place belongs to. Unknown places can be forced in Settings.
---@return number?
local function currentSea()
	local override = Config.get("seaOverride")

	if override ~= "Auto" then
		return tonumber(override)
	end

	return PLACE_SEAS[game.PlaceId]
end

