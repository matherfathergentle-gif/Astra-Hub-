	local entry = Navigation.list()[Navigation.selected]
	return entry and entry[1] or "No destinations"
end

function Navigation.cycle()
	local list = Navigation.list()
	if #list == 0 then
		return
	end

	Navigation.selected = Navigation.selected % #list + 1
end

function Navigation.go()
	local entry = Navigation.list()[Navigation.selected]
	if not entry then
		Notify.push("No navigation data for this place", "WARN")
		return
	end

	if Navigation.busy then
		Notify.push("Already travelling", "WARN")
		return
	end

	Navigation.busy = true

	task.spawn(function()
		local arrived, reason = Movement.moveTo("nav", CFrame.new(entry[2] + Vector3.new(0, 5, 0)))
		Navigation.busy = false

		if arrived then
			Notify.push("Arrived at " .. entry[1], "INFO")
		else
			Notify.push(string.format("Travel to %s failed: %s", entry[1], tostring(reason)), "WARN")
		end
	end)
end

function Navigation.cancel()
	Movement.cancel("nav")
	Navigation.busy = false
end

