local Enemies = { warned = false }

---@return Folder?
function Enemies.folder()
	local folder = workspace:FindFirstChild("Enemies")

	if not folder and not Enemies.warned then
		Enemies.warned = true
		Logger.warn("Enemies", "workspace.Enemies not found, is this a supported place?")
	end

	return folder
end

---Match an enemy name, allowing older "[Lv. N]" suffixes.
---@param name string
---@param mobName string
---@return boolean
function Enemies.matches(name, mobName)
	if name == mobName then
		return true
	end

	-- Level tags such as "[Lv. 5]" can sit anywhere in the name.
	local cleaned = string.gsub(name, "%s*%[.-%]", "")
	return string.gsub(cleaned, "%s+$", "") == mobName
end

---@param model Instance?
---@return boolean
function Enemies.isAlive(model)
	if not (model and model.Parent) then
		return false
	end

	local humanoid = model:FindFirstChildOfClass("Humanoid")
	return humanoid ~= nil and humanoid.Health > 0 and model:FindFirstChild("HumanoidRootPart") ~= nil
end

---Find the nearest living enemy, optionally restricted to one mob name.
---@param mobName string?
---@param origin Vector3
---@return Model?, number?
function Enemies.nearest(mobName, origin)
	local folder = Enemies.folder()
	if not folder then
		return nil, nil
	end

	local closest, closestDistance = nil, math.huge

	for _, enemy in folder:GetChildren() do
		if mobName and not Enemies.matches(enemy.Name, mobName) then
			continue
		end

		if not Enemies.isAlive(enemy) then
			continue
		end

		local distance = (enemy.HumanoidRootPart.Position - origin).Magnitude
		if distance < closestDistance then
			closest, closestDistance = enemy, distance
		end
	end

	return closest, closestDistance
end

---Pick where mobs of a quest spawn: live spawn points first, saved data second.
---@param quest table
---@param origin Vector3
---@return Vector3?
function Enemies.campPosition(quest, origin)
	local worldOrigin = workspace:FindFirstChild("_WorldOrigin")
	local spawns = worldOrigin and worldOrigin:FindFirstChild("EnemySpawns")
	local best, bestDistance = nil, math.huge

	if spawns then
		for _, spawnPart in spawns:GetChildren() do
			if spawnPart:IsA("BasePart") and Enemies.matches(spawnPart.Name, quest.mob) then
				local distance = (spawnPart.Position - origin).Magnitude
				if distance < bestDistance then
					best, bestDistance = spawnPart.Position, distance
				end
			end
		end
	end

	return best or quest.campPosition
end

-- A pile is every living mob of one type near a point, nearest first.
local Pile = {}

---@param mobName string
---@param origin Vector3
---@param range number
---@param include Model?
---@return table, table
function Pile.collect(mobName, origin, range, include)
	local list, distances = {}, {}
	local folder = Enemies.folder()

	if folder then
		for _, enemy in folder:GetChildren() do
			if Enemies.matches(enemy.Name, mobName) and Enemies.isAlive(enemy) then
				local distance = (enemy.HumanoidRootPart.Position - origin).Magnitude

				if distance <= range then
					distances[enemy] = distance
					table.insert(list, enemy)
				end
			end
		end
	end

	-- The current target always belongs to the pile, even before it arrives.
	if include and distances[include] == nil and Enemies.isAlive(include) then
		distances[include] = 0
		table.insert(list, include)
	end

	table.sort(list, function(a, b)
		return distances[a] < distances[b]
	end)

	while #list > MAX_PILE do
		table.remove(list)
	end

	return list, distances
end

---@param list table
---@return Model?
function Pile.firstAlive(list)
	for _, enemy in list do
		if Enemies.isAlive(enemy) then
			return enemy
		end
	end

	return nil
end

---Record member health, adding new members to an existing snapshot.
---@param list table
---@param snapshot table?
---@return table
function Pile.snapshot(list, snapshot)
	snapshot = snapshot or {}

	for _, enemy in list do
		if snapshot[enemy] == nil then
			local humanoid = enemy:FindFirstChildOfClass("Humanoid")

			if humanoid then
				snapshot[enemy] = humanoid.Health
			end
		end
	end

	return snapshot
end

---@param snapshot table
---@return number
function Pile.count(snapshot)
	local count = 0

	for _ in snapshot do
		count += 1
	end

	return count
end

---How many snapshot members are dead or gone.
---@param snapshot table
---@return number
function Pile.deaths(snapshot)
	local deaths = 0

	for enemy in snapshot do
		if not Enemies.isAlive(enemy) then
			deaths += 1
		end
	end

	return deaths
end

---Whether any snapshot member other than `ignore` lost health, died or vanished.
---@param snapshot table
---@param ignore Model?
---@return boolean
function Pile.damaged(snapshot, ignore)
	for enemy, health in snapshot do
		if enemy ~= ignore then
			local humanoid = enemy.Parent and enemy:FindFirstChildOfClass("Humanoid")

			if not humanoid or humanoid.Health < health - 0.5 then
				return true
			end
		end
	end

	return false
end

---The greatest recorded distance among snapshot members that lost health, or nil.
---@param snapshot table
---@param distances table
---@return number?
function Pile.farthestDamaged(snapshot, distances)
	local farthest = nil

	for enemy, health in snapshot do
		local distance = distances[enemy]

		if distance then
			local humanoid = enemy.Parent and enemy:FindFirstChildOfClass("Humanoid")

			if not humanoid or humanoid.Health < health - 0.5 then
				farthest = math.max(farthest or 0, distance)
			end
		end
	end

	return farthest
end

-- Moves mobs onto one point. It needs the executor to raise the simulation radius so this client owns
-- them, and it notices when ownership never arrives.
local Bring = { active = false, originalRadius = nil, originalMax = nil, lastRefresh = 0, stilled = setmetatable({}, { __mode = "k" }) }

---@param radius number
---@param maxRadius number
function Bring.applyRadius(radius, maxRadius)
	if Dependencies.has("setsimulationradius") then
		pcall(setsimulationradius, radius, maxRadius)
	end

	if Dependencies.has("sethiddenproperty") then
		pcall(sethiddenproperty, localPlayer, "SimulationRadius", radius)
	end

	pcall(function()
		localPlayer.MaximumSimulationRadius = maxRadius
	end)
end

---Raise the simulation radius, remembering the originals so they can be restored.
function Bring.start()
	if Bring.active then
		return
	end

	Bring.active = true

	if Dependencies.has("getsimulationradius") then
		local success, value = pcall(getsimulationradius)

		if success and type(value) == "number" then
			Bring.originalRadius = value
		end
	end

	pcall(function()
		Bring.originalMax = localPlayer.MaximumSimulationRadius
	end)

	Bring.applyRadius(math.huge, math.huge)

	if not (Dependencies.has("setsimulationradius") or Dependencies.has("sethiddenproperty")) then
		Logger.warn("Bring", "No way to raise the simulation radius, mobs may not follow the pile")
	end
end

---The engine lowers the radius again on its own, so the farm claims it back several times a second.
function Bring.refresh()
	if not Bring.active or os.clock() - Bring.lastRefresh < 0.25 then
		return
	end

	Bring.lastRefresh = os.clock()
	Bring.applyRadius(math.huge, math.huge)
end

---Restore the simulation radius.
function Bring.stop()
	if not Bring.active then
		return
	end

	Bring.active = false
	Bring.applyRadius(Bring.originalRadius or 1000, Bring.originalMax or 1000)
	Bring.originalRadius = nil
	Bring.originalMax = nil
end

---Place every pile member on one point.
---@param list table
---@param point Vector3
function Bring.pin(list, point)
	local pinned = CFrame.new(point)

	for _, enemy in list do
		local enemyRoot = enemy:FindFirstChild("HumanoidRootPart")

		if enemyRoot then
			enemyRoot.CFrame = pinned
			enemyRoot.AssemblyLinearVelocity = Vector3.zero
			enemyRoot.CanCollide = false

			if not Bring.stilled[enemy] then
				Bring.stilled[enemy] = true

				local humanoid = enemy:FindFirstChildOfClass("Humanoid")
				if humanoid then
					humanoid.WalkSpeed = 0
				end
			end
		end
	end
end

---Count pile members whose physics this client owns, or nil when that cannot be checked.
---@param list table
---@return number?
function Bring.ownedCount(list)
	if not Dependencies.has("isnetworkowner") then
		return nil
	end

	local owned = 0

	for _, enemy in list do
		local enemyRoot = enemy:FindFirstChild("HumanoidRootPart")

		if enemyRoot then
			local success, result = pcall(isnetworkowner, enemyRoot)

			if success and result then
				owned += 1
			end
		end
	end

	return owned
end

local Combat = {
	warned = {},
	remotes = {},
	lastScan = -10,
	sessionValue = nil,
	sessionStamp = -10,
	profileIndex = nil,
	verifiedIndex = nil,
	noDamageBursts = 0,
	failedProfiles = 0,
	multiMisses = 0,
	multiConfirmed = false,
	lastActivate = -10,
	cursor = 0,
	hitsSent = 0,
	rate = 0,
	rateSampleAt = os.clock(),
	rateSampleCount = 0,
	hoverCap = nil,
	hoverCapAt = 0,
	hoverMisses = 0,
	verifiedHover = nil,
	farthestHit = 0,
	framework = nil,
	frameworkTried = -10,
}

-- Hit profiles, newest public format first. "pair" sends { model, part } pairs the way the most recent
-- community hubs do, "session" adds the combat session value some builds expect. multi = "calls" fires
-- one hit per target in the pile, "list" names the whole pile in a single call, false hits one target.
-- "activate" and "click" use the game's own tool input and need no remotes. The farm verifies damage,
-- rotates profiles that do nothing, and steps pile profiles down when only the primary takes damage.
local HIT_PROFILES = {
	{ kind = "controller", multi = "game", name = "Game combat controller" },
	{ kind = "remote", shape = "pair", part = "Head", multi = "calls", attackArg = 0, name = "Pair / Head / each target" },
	{ kind = "remote", shape = "pair", part = "Head", multi = "list", attackArg = 0, name = "Pair / Head / one call" },
	{ kind = "remote", shape = "pair", part = "Head", multi = false, attackArg = 0, name = "Pair / Head" },
	{ kind = "remote", shape = "session", part = "RightLowerLeg", third = "nil", multi = "calls", attackArg = 0.5, name = "Session / RightLowerLeg / each target" },
	{ kind = "remote", shape = "session", part = "RightLowerLeg", third = "nil", multi = false, attackArg = 0.5, name = "Session / RightLowerLeg" },
	{ kind = "remote", shape = "session", part = "Head", third = "table", multi = "calls", attackArg = false, name = "Session / Head / each target" },
	{ kind = "remote", shape = "session", part = "Head", third = "table", multi = false, attackArg = false, name = "Session / Head" },
	{ kind = "activate", multi = false, name = "Tool activate" },
	{ kind = "click", multi = false, name = "Click input" },
}

local HIT_ACTIVATE_INDEX = 1
local HIT_FIRST_REMOTE_INDEX = 1

for index, profile in HIT_PROFILES do
	if profile.kind == "activate" then
		HIT_ACTIVATE_INDEX = index
	end
end

for index = #HIT_PROFILES, 1, -1 do
	if HIT_PROFILES[index].kind == "remote" then
		HIT_FIRST_REMOTE_INDEX = index
	end
end

---@param key string
---@param message string
function Combat.warnOnce(key, message)
	if not Combat.warned[key] then
		Combat.warned[key] = true
		Logger.warn("Combat", "%s", message)
	end
end

---Equip a tool of the configured type. Returns true when one is held.
---@return boolean
function Combat.equipWeapon()
	local model, humanoid = Character.get()
	if not (model and humanoid) then
		return false
	end

	local toolTip = Config.get("weaponType")

	for _, child in model:GetChildren() do
		if child:IsA("Tool") and child.ToolTip == toolTip then
			return true
		end
	end

	local backpack = localPlayer:FindFirstChild("Backpack")
	if not backpack then
		return false
	end

	for _, tool in backpack:GetChildren() do
		if tool:IsA("Tool") and tool.ToolTip == toolTip then
			humanoid:EquipTool(tool)
			task.wait(0.15)
			return tool.Parent == model
		end
	end

	return false
end

---Send one primary click using the configured input method.
function Combat.click()
	if Config.get("inputMethod") == "Mouse" then
		if Dependencies.has("mouse1click") and (not Dependencies.has("isrbxactive") or isrbxactive()) then
			mouse1click()
			return
		end

		Combat.warnOnce("mouse", "Mouse input needs mouse1click and a focused window, using VirtualUser")
	end

	local camera = workspace.CurrentCamera
	local cameraCFrame = camera and camera.CFrame or CFrame.new()
	local position = Vector2.new(851, 158)

	virtualUser:CaptureController()
	virtualUser:Button1Down(position, cameraCFrame)
	task.wait(0.03)
	virtualUser:Button1Up(position, cameraCFrame)
end

---Find a combat remote in the net module, falling back to a scan of ReplicatedStorage.
---@param remoteName string
---@return RemoteEvent?
function Combat.findRemote(remoteName)
	local modules = replicatedStorage:FindFirstChild("Modules")
	local net = modules and modules:FindFirstChild("Net")
	local direct = net and net:FindFirstChild(remoteName)

	if direct and direct:IsA("RemoteEvent") then
		return direct
	end

	local shortName = string.match(remoteName, "[^/]+$")

	for _, descendant in replicatedStorage:GetDescendants() do
		if descendant:IsA("RemoteEvent") and (descendant.Name == remoteName or descendant.Name == shortName) then
			return descendant
		end
	end

	return nil
end

---Resolve both combat remotes. Scans are throttled so a missing remote cannot cause lag.
---@param force boolean?
---@return RemoteEvent?, RemoteEvent?
function Combat.resolveRemotes(force)
	local remotes = Combat.remotes
	local attackReady = remotes.attack and remotes.attack.Parent
	local hitReady = remotes.hit and remotes.hit.Parent

	if not (attackReady and hitReady) and (force or os.clock() - Combat.lastScan > 5) then
		Combat.lastScan = os.clock()

		if not attackReady then
			remotes.attack = Combat.findRemote("RE/RegisterAttack")
		end

		if not hitReady then
			remotes.hit = Combat.findRemote("RE/RegisterHit")
		end
	end

	return remotes.attack, remotes.hit
end

---Build the combat session value the game's own hit sender uses. Never logged.
---@return string?
function Combat.sessionId()
	if Combat.sessionValue and os.clock() - Combat.sessionStamp < 5 then
		return Combat.sessionValue
	end

	local success, result = pcall(function()
		local sendHits = getrenv()._G.SendHitsToServer
		if type(sendHits) ~= "function" then
			error("_G.SendHitsToServer is not a function")
		end

		local upvalues = debug.getupvalues(sendHits)
		local combatThread = nil

		for _, upvalue in upvalues do
			if type(upvalue) == "thread" then
				combatThread = upvalue
				break
			end
		end

		combatThread = combatThread or upvalues[1]
		if combatThread == nil then
			error("combat thread upvalue not found")
		end

		return string.sub(tostring(localPlayer.UserId), 2, 4) .. string.sub(tostring(combatThread), 11, 15)
	end)

	Combat.sessionStamp = os.clock()

	if success then
		Combat.sessionValue = result
		return result
	end

	Combat.sessionValue = nil
	Combat.warnOnce("session", "Hit session value unavailable: " .. firstLine(result))
	return nil
end

---Whether the configured hit method allows a profile.
---@param index number
---@return boolean
function Combat.profileAllowed(index)
	local profile = HIT_PROFILES[index]
	local method = Config.get("hitMethod")

	if profile.multi and not Config.get("multiHit") then
		return false
	end

	if method == "Game" then
		return profile.kind == "controller"
	end

	if method == "Remote" then
		return profile.kind == "remote"
	end

	if method == "Click" then
		return profile.kind == "click" or profile.kind == "activate"
	end

	return true
end

---Select a profile and reset every per-profile counter.
---@param index number
function Combat.setProfile(index)
	Combat.profileIndex = index
	Combat.noDamageBursts = 0
	Combat.multiMisses = 0
	Combat.multiConfirmed = false
end

---The profile currently in use, choosing a valid one when needed.
---@return table
function Combat.currentProfile()
	if Combat.profileIndex and Combat.profileAllowed(Combat.profileIndex) then
		return HIT_PROFILES[Combat.profileIndex]
	end

	local savedName = Config.get("hitProfileSaved")
	local saved = nil

	for index, candidate in HIT_PROFILES do
		if candidate.name == savedName then
			saved = index
		end
	end

	local chosen = nil

	if saved and Combat.profileAllowed(saved) then
		chosen = saved
	else
		for index = 1, #HIT_PROFILES do
			if Combat.profileAllowed(index) then
				chosen = index
				break
			end
		end
	end

	Combat.setProfile(chosen or #HIT_PROFILES)
	return HIT_PROFILES[Combat.profileIndex]
end

---The game's own combat controller. Its hit packet is built by the game, so it names every mob inside
---the hitbox with whatever session data the current build expects.
---@return table?, string?
function Combat.controller()
	if Combat.framework == false and os.clock() - Combat.frameworkTried > 10 then
		Combat.framework = nil
	end

	if Combat.framework == nil then
		Combat.framework = false
		Combat.frameworkTried = os.clock()

		local scripts = localPlayer:FindFirstChild("PlayerScripts")
		local moduleScript = scripts and scripts:FindFirstChild("CombatFramework")

		if not moduleScript then
			return nil, "PlayerScripts.CombatFramework not found"
		end

		-- Required at identity 2 so the game module cannot see executor globals.
		local canSwitch = Dependencies.has("setthreadidentity") and Dependencies.has("getthreadidentity")
		local previous = canSwitch and getthreadidentity() or nil

		if canSwitch then
			setthreadidentity(2)
		end

		local success, result = pcall(require, moduleScript)

		if canSwitch then
			setthreadidentity(previous or 8)
		end

		if not success then
			return nil, "CombatFramework could not be required: " .. firstLine(result)
		end

		Combat.framework = result
	end

	if type(Combat.framework) ~= "table" then
		return nil, "CombatFramework is unavailable"
	end

	local controller = Combat.framework.activeController

	if type(controller) ~= "table" then
		return nil, "no active combat controller"
	end

	return controller, nil
end

---Fire the game's own attack with a hitbox as large as the hit range.
---@return boolean, string?
function Combat.controllerAttack()
	local controller, reason = Combat.controller()
	if not controller then
		return false, reason
	end

	local active = controller.active

	if type(active) ~= "table" or active.attacker == nil or active.weapon == nil then
		return false, "no weapon is active in the combat controller"
	end

	local success, errorMessage = pcall(function()
		if type(controller.hitboxMagnitude) == "number" then
			controller.hitboxMagnitude = Config.get("hitRange")
		end

		active.attacker:hitServerCode()
		active.weapon:attack()
	end)

	if not success then
		return false, firstLine(errorMessage)
	end

	return true, nil
end

---Activate the equipped tool, the game's own input path.
---@return boolean, string?
function Combat.activate()
	local model = Character.get()
	if not model then
		return false, "no character"
	end

	for _, child in model:GetChildren() do
		if child:IsA("Tool") and child.ToolTip == Config.get("weaponType") then
			child:Activate()
			return true, nil
		end
	end

	return false, "no equipped tool to activate"
end

---Pick the targets for one attack tick. The nearest half of the budget always goes to the closest
---mobs, the rest rotates over the pile so a pile bigger than the limit is still hit evenly.
---@param target Model
---@param pile table
---@param limit number
---@return table
function Combat.batch(target, pile, limit)
	local batch = { target }
	local count = #pile

	if count == 0 then
		return batch
	end

	local seen = { [target] = true }
	local nearBudget = math.max(1, math.ceil(limit / 2))

	for _, enemy in pile do
		if #batch >= nearBudget then
			break
		end

		if not seen[enemy] and Enemies.isAlive(enemy) then
			seen[enemy] = true
			table.insert(batch, enemy)
		end
	end

	Combat.cursor = Combat.cursor % count + 1
	local index = Combat.cursor

	for _ = 1, count do
		if #batch >= limit then
			break
		end

		local enemy = pile[index]

		if not seen[enemy] and Enemies.isAlive(enemy) then
			seen[enemy] = true
			table.insert(batch, enemy)
		end

		index = index % count + 1
	end

	return batch
end

---Send one attack tick with the current profile. Returns true, or false plus a reason.
---@param target Model
---@param pile table?
---@return boolean, string?
function Combat.attack(target, pile)
	local profile = Combat.currentProfile()

	if profile.kind == "controller" then
		local fired, reason = Combat.controllerAttack()

		if fired then
			Combat.hitsSent += 1
			return true, nil
		end

		if Config.get("hitMethod") == "Auto" then
			Combat.warnOnce("controller", "Game combat controller unavailable (" .. tostring(reason) .. "), trying remote profiles")
			Combat.setProfile(HIT_FIRST_REMOTE_INDEX)
			return true, nil
		end

		return false, reason
	end

	if profile.kind == "activate" then
		Combat.hitsSent += 1
		return Combat.activate()
	end

	if profile.kind == "click" then
		Combat.hitsSent += 1
		Combat.click()
		return true, nil
	end

	local attackRemote, hitRemote = Combat.resolveRemotes()

	if not (attackRemote and hitRemote) then
		if Config.get("hitMethod") == "Auto" then
			Combat.warnOnce("noremotes", "Combat remotes not found, using tool input instead")
			Combat.setProfile(HIT_ACTIVATE_INDEX)
			return Combat.activate()
		end

		return false, "combat remotes not found"
	end

	-- The game's own M1 start, which the public hubs trigger before the remote hits.
	if os.clock() - Combat.lastActivate >= ACTIVATE_INTERVAL then
		Combat.lastActivate = os.clock()
		Combat.activate()
	end

	local batch = { target }

	if profile.multi and pile then
		batch = Combat.batch(target, pile, Config.get("maxTargets"))
	end

	local session = profile.shape == "session" and Combat.sessionId() or nil

	local success, errorMessage = pcall(function()
		if profile.attackArg == false then
			attackRemote:FireServer()
		else
			attackRemote:FireServer(profile.attackArg)
		end

		if profile.multi == "list" then
			local list = {}

			for _, enemy in batch do
				local enemyPart = enemy:FindFirstChild(profile.part) or enemy:FindFirstChild("HumanoidRootPart")

				if enemyPart then
					table.insert(list, { enemy, enemyPart })
				end
			end

			if #list > 0 then
				hitRemote:FireServer(list[1][2], list)
			end

			return
		end

		for _, enemy in batch do
			local enemyPart = enemy:FindFirstChild(profile.part) or enemy:FindFirstChild("HumanoidRootPart")

			if enemyPart then
				if profile.shape == "pair" then
					hitRemote:FireServer(enemyPart, { { enemy, enemyPart } })
				elseif profile.third == "table" then
					hitRemote:FireServer(enemyPart, {}, {}, session)
				else
					hitRemote:FireServer(enemyPart, {}, nil, session)
				end
			end
		end
	end)

	if not success then
		return false, firstLine(errorMessage)
	end

	Combat.hitsSent += #batch
	return true, nil
end

---The hover height in use: the setting, or a lower value learned when hits stopped landing.
---@return number
function Combat.effectiveHover()
	local configured = Config.get("hoverHeight")

	if Combat.hoverCap and Combat.hoverCap < configured then
		return Combat.hoverCap
	end

	return configured
end

---Called after a burst with no damage. Moves the hover closer before the hit profile is blamed.
---Returns true while it is still handling the problem.
---@return boolean
function Combat.cutHover()
	local current = Combat.effectiveHover()
	local floor = math.max(HOVER_FLOOR, Combat.verifiedHover or 0)

	-- A height that already dealt damage once is known to be in reach.
	if current <= floor then
		Combat.hoverMisses = 0
		return false
	end

	Combat.hoverMisses += 1

	if Combat.hoverMisses < 2 then
		return true
	end

	Combat.hoverMisses = 0

	local nextHover = math.max(floor, math.floor(current * 0.6))
	Combat.hoverCap = nextHover
	Combat.hoverCapAt = os.clock()
	Logger.warn("Combat", "No damage from %d studs up, moving closer to %d", math.floor(current), nextHover)
	return true
end

---Slowly test a higher hover again after the limit was lowered.
function Combat.growHover()
	local configured = Config.get("hoverHeight")

	if not Combat.hoverCap or Combat.hoverCap >= configured then
		return
	end

	if os.clock() - Combat.hoverCapAt < HOVER_GROW_INTERVAL then
		return
	end

	local grown = math.min(configured, math.ceil(Combat.hoverCap * 1.3))
	Combat.hoverCapAt = os.clock()
	Combat.hoverCap = grown < configured and grown or nil
	Logger.info("Combat", "Damage is landing, trying a %d stud hover", grown)
end

---Record that the current profile dealt damage.
function Combat.reportDamage()
	Combat.noDamageBursts = 0
	Combat.failedProfiles = 0

	if Combat.profileIndex and Combat.verifiedIndex ~= Combat.profileIndex then
		Combat.verifiedIndex = Combat.profileIndex
		Logger.info("Combat", "Hit profile works: %s", HIT_PROFILES[Combat.profileIndex].name)
		Config.set("hitProfileSaved", HIT_PROFILES[Combat.profileIndex].name)
	end
end

---Record a burst without damage. Returns "waiting", "advanced" or "exhausted".
---@return string
function Combat.reportNoDamage()
	Combat.currentProfile()
	Combat.noDamageBursts += 1

	-- A profile that worked before gets more patience, mobs can be briefly invulnerable.
	local patience = Combat.verifiedIndex == Combat.profileIndex and NO_DAMAGE_BURSTS * 3 or NO_DAMAGE_BURSTS
	if Combat.noDamageBursts < patience then
		return "waiting"
	end

	Combat.noDamageBursts = 0
	Combat.failedProfiles += 1

	local allowed, nextIndex = 0, nil
	local count = #HIT_PROFILES

	for index = 1, count do
		if Combat.profileAllowed(index) then
			allowed += 1
		end
	end

	for step = 1, count do
		local candidate = (Combat.profileIndex + step - 1) % count + 1

		if candidate ~= Combat.profileIndex and Combat.profileAllowed(candidate) then
			nextIndex = candidate
			break
		end
	end

	if Combat.failedProfiles >= allowed or not nextIndex then
		Combat.failedProfiles = 0
		return "exhausted"
	end

	Combat.setProfile(nextIndex)
	Logger.warn("Combat", "No damage registered, trying hit profile: %s", HIT_PROFILES[nextIndex].name)
	return "advanced"
end

---Step a pile profile down a tier when only the primary target takes damage: "calls" falls back to
---"list", and "list" falls back to single-target hits.
function Combat.downgradeMulti()
	local profile = HIT_PROFILES[Combat.profileIndex]

	-- The game's own packet only reached one mob, so let the remote profiles try to spread the damage.
	if profile.kind == "controller" then
		if Combat.profileAllowed(HIT_FIRST_REMOTE_INDEX) then
			Logger.warn("Combat", "The game's hit packet only reached the primary target, trying remote profiles")
			Combat.setProfile(HIT_FIRST_REMOTE_INDEX)
		else
			Combat.multiConfirmed = true
			Logger.warn("Combat", "Only the primary target took damage. Raise Hit range or move the pile closer")
		end

		return
	end
	local wanted = profile.multi == "calls" and "list" or false
	local fallback = nil
	local chosen = nil

	for index, candidate in HIT_PROFILES do
		local sameFamily = candidate.kind == "remote"
			and candidate.shape == profile.shape
			and candidate.part == profile.part
			and candidate.third == profile.third

		if sameFamily and candidate.multi == wanted then
			chosen = index
		elseif sameFamily and candidate.multi == false then
			fallback = index
		end
	end

	chosen = chosen or fallback

	if chosen then
		Logger.warn("Combat", "Only the primary target took damage, switching to %s", HIT_PROFILES[chosen].name)
		Combat.setProfile(chosen)
		Combat.verifiedIndex = chosen
		Config.set("hitProfileSaved", HIT_PROFILES[chosen].name)
	end
end

---Fold one burst into the profile state. Returns "ok", or the no-damage verdict.
---@param damaged boolean
---@param othersDamaged boolean
---@param pileSize number
---@return string
function Combat.reportBurst(damaged, othersDamaged, pileSize)
	if not damaged then
		return Combat.reportNoDamage()
	end

	Combat.reportDamage()

	local profile = HIT_PROFILES[Combat.profileIndex]

	if profile and profile.multi and pileSize >= 2 and not Combat.multiConfirmed then
		if othersDamaged then
			Combat.multiConfirmed = true
			Combat.multiMisses = 0
			Logger.info("Combat", "Pile hits confirmed (%d mobs in the burst)", pileSize)
		else
			Combat.multiMisses += 1

			if Combat.multiMisses >= MULTI_CHECK_BURSTS then
				Combat.downgradeMulti()
			end
		end
	end

	return "ok"
end

---One-line combat status for the dashboard.
---@return string
function Combat.statusText()
	local profile = Combat.currentProfile()
	local attackRemote, hitRemote = Combat.resolveRemotes()
	local verified = Combat.verifiedIndex == Combat.profileIndex and "verified" or "not verified yet"
	local remotes = (attackRemote and hitRemote) and "remotes found" or "remotes missing"

	local now = os.clock()
	if now - Combat.rateSampleAt >= 1 then
		Combat.rate = (Combat.hitsSent - Combat.rateSampleCount) / (now - Combat.rateSampleAt)
		Combat.rateSampleAt, Combat.rateSampleCount = now, Combat.hitsSent
	end

	return string.format("%s  -  %s  -  %s  -  %d hits/s", profile.name, verified, remotes, math.floor(Combat.rate))
end

--------------------------------------------------------------------------------
-- Auto Farm state machine.
--
-- Allowed transitions (anything else is logged as an error and sent to RECOVERING):
--   INITIALIZING        -> CHECKING_CHARACTER, RECOVERING, PAUSED, STOPPED
--   CHECKING_CHARACTER  -> SELECTING_QUEST, WAITING_FOR_RESPAWN, RECOVERING, PAUSED, STOPPED
--   SELECTING_QUEST     -> VERIFYING_QUEST, FINDING_TARGET, WAITING_FOR_RESPAWN, RECOVERING, PAUSED, STOPPED
--   VERIFYING_QUEST     -> FINDING_TARGET, NAVIGATING, EXECUTING_ACTION, WAITING_FOR_RESPAWN, RECOVERING, PAUSED, STOPPED
--   FINDING_TARGET      -> SELECTING_QUEST, NAVIGATING, EXECUTING_ACTION, WAITING_FOR_RESPAWN, RECOVERING, PAUSED, STOPPED
--   NAVIGATING          -> VERIFYING_QUEST, FINDING_TARGET, EXECUTING_ACTION, CHECKING_CHARACTER,
--                          WAITING_FOR_RESPAWN, RECOVERING, PAUSED, STOPPED
--   EXECUTING_ACTION    -> VERIFYING_QUEST, VERIFYING_PROGRESS, NAVIGATING, WAITING_FOR_RESPAWN,
--                          RECOVERING, PAUSED, STOPPED
--   VERIFYING_PROGRESS  -> EXECUTING_ACTION, FINDING_TARGET, WAITING_FOR_RESPAWN, RECOVERING, PAUSED, STOPPED
--   WAITING_FOR_RESPAWN -> CHECKING_CHARACTER, RECOVERING, PAUSED, STOPPED
--   RECOVERING          -> CHECKING_CHARACTER, PAUSED, STOPPED
--   PAUSED              -> CHECKING_CHARACTER, STOPPED
--   STOPPED             -> INITIALIZING
--------------------------------------------------------------------------------

local STATES = {
	INITIALIZING = "INITIALIZING",
	CHECKING_CHARACTER = "CHECKING_CHARACTER",
	SELECTING_QUEST = "SELECTING_QUEST",
	VERIFYING_QUEST = "VERIFYING_QUEST",
	FINDING_TARGET = "FINDING_TARGET",
	NAVIGATING = "NAVIGATING",
	EXECUTING_ACTION = "EXECUTING_ACTION",
	VERIFYING_PROGRESS = "VERIFYING_PROGRESS",
	WAITING_FOR_RESPAWN = "WAITING_FOR_RESPAWN",
	RECOVERING = "RECOVERING",
	PAUSED = "PAUSED",
	STOPPED = "STOPPED",
}

local TRANSITION_LISTS = {
	INITIALIZING = { "CHECKING_CHARACTER", "RECOVERING", "PAUSED", "STOPPED" },
	CHECKING_CHARACTER = { "SELECTING_QUEST", "WAITING_FOR_RESPAWN", "RECOVERING", "PAUSED", "STOPPED" },
	SELECTING_QUEST = { "VERIFYING_QUEST", "FINDING_TARGET", "WAITING_FOR_RESPAWN", "RECOVERING", "PAUSED", "STOPPED" },
	VERIFYING_QUEST = { "FINDING_TARGET", "NAVIGATING", "EXECUTING_ACTION", "WAITING_FOR_RESPAWN", "RECOVERING", "PAUSED", "STOPPED" },
	FINDING_TARGET = { "SELECTING_QUEST", "NAVIGATING", "EXECUTING_ACTION", "WAITING_FOR_RESPAWN", "RECOVERING", "PAUSED", "STOPPED" },
	NAVIGATING = { "VERIFYING_QUEST", "FINDING_TARGET", "EXECUTING_ACTION", "CHECKING_CHARACTER", "WAITING_FOR_RESPAWN", "RECOVERING", "PAUSED", "STOPPED" },
	EXECUTING_ACTION = { "VERIFYING_QUEST", "VERIFYING_PROGRESS", "NAVIGATING", "WAITING_FOR_RESPAWN", "RECOVERING", "PAUSED", "STOPPED" },
	VERIFYING_PROGRESS = { "EXECUTING_ACTION", "FINDING_TARGET", "WAITING_FOR_RESPAWN", "RECOVERING", "PAUSED", "STOPPED" },
	WAITING_FOR_RESPAWN = { "CHECKING_CHARACTER", "RECOVERING", "PAUSED", "STOPPED" },
	RECOVERING = { "CHECKING_CHARACTER", "PAUSED", "STOPPED" },
	PAUSED = { "CHECKING_CHARACTER", "STOPPED" },
	STOPPED = { "INITIALIZING" },
}

local ALLOWED = {}

for from, targets in TRANSITION_LISTS do
	ALLOWED[from] = {}

	for _, target in targets do
		ALLOWED[from][target] = true
	end
end

-- Routine combat-loop edges are not logged, they would flood the log every second.
local QUIET_EDGES = {
	["EXECUTING_ACTION>VERIFYING_PROGRESS"] = true,
	["VERIFYING_PROGRESS>EXECUTING_ACTION"] = true,
	["FINDING_TARGET>EXECUTING_ACTION"] = true,
	["VERIFYING_PROGRESS>FINDING_TARGET"] = true,
}

local Farm = {
	state = STATES.STOPPED,
	reason = "not started",
	stateSince = os.clock(),
	running = false,
	paused = false,
	token = 0,
	context = {},
	stats = { kills = 0, startedAt = os.clock() },
	changed = Signal.new(),
}

local HANDLERS = {}

---@return table
local function newContext()
	return {
		quest = nil,
		target = nil,
		action = ACTION_ATTACK,
		navGoal = nil,
		navNext = nil,
		navLabel = nil,
		navEntrance = nil,
		entranceAttempts = 0,
		enterAttempts = 0,
		capNoted = false,
		questAttempts = 0,
		questBlockedUntil = 0,
		lastProgressAt = os.clock(),
		pilePoint = nil,
		pileCount = 0,
		ownedCount = nil,
		pinnedCount = 0,
		burst = nil,
		bringStalls = 0,
		bringBlockedUntil = 0,
		recoveries = 0,
		retreatCooldownUntil = 0,
		noTargetSince = nil,
		busySince = nil,
		equipFailures = 0,
		warnedQuestUi = false,
	}
end

---True when this run was stopped or replaced.
---@param token number
---@return boolean
function Farm.cancelled(token)
	return Farm.token ~= token or not Farm.running
end

---Sleep in small steps so cancellation is honoured. Returns false when cancelled.
---@param seconds number
---@param token number
---@return boolean
function Farm.sleep(seconds, token)
	local deadline = os.clock() + seconds

	while os.clock() < deadline do
		if Farm.cancelled(token) then
			return false
		end

		task.wait(0.1)
	end

	return not Farm.cancelled(token)
end

---Move to a new state, enforcing the documented transition table.
---@param newState string
---@param reason string?
function Farm.transition(newState, reason)
	local old = Farm.state

	if not (ALLOWED[old] and ALLOWED[old][newState]) then
		Logger.error("State", "Invalid transition %s -> %s (%s)", old, newState, tostring(reason))
		newState = ALLOWED[old] and ALLOWED[old][STATES.RECOVERING] and STATES.RECOVERING or STATES.STOPPED
		reason = "invalid transition"
	end

	Farm.state = newState
	Farm.reason = reason or ""
	Farm.stateSince = os.clock()

	if not QUIET_EDGES[old .. ">" .. newState] then
		Logger.info("State", "%s -> %s (%s)", old, newState, Farm.reason)
	end

	Farm.changed:fire(newState, Farm.reason)
end

---Start the controller.
---@return boolean
function Farm.start()
	if Farm.running then
		return false
	end

	Farm.running = true
	Farm.paused = false
	Farm.token += 1
	Farm.context = newContext()
	Farm.stats = { kills = 0, startedAt = os.clock() }

	if Config.get("bringMobs") then
		Bring.start()
	end

	Farm.transition(STATES.INITIALIZING, "start requested")
	task.spawn(Farm.run, Farm.token)
	return true
end

---Stop the controller and release everything it holds.
---@param reason string?
function Farm.stop(reason)
	if not Farm.running then
		return
	end

	Farm.running = false
	Farm.paused = false
	Farm.token += 1
	Movement.cancel()
	Bring.stop()
	Farm.transition(STATES.STOPPED, reason or "stopped by user")
end

---Stop because of an unrecoverable problem.
---@param reason string
function Farm.fail(reason)
	Notify.push("Auto Farm stopped: " .. reason, "ERROR")
	Farm.stop(reason)
end

---@return boolean
function Farm.pause()
	if not Farm.running or Farm.paused then
		return false
	end

	Farm.paused = true
	Movement.cancel("farm")
	return true
end

---@return boolean
function Farm.resume()
	if not Farm.running or not Farm.paused then
		return false
	end

	Farm.paused = false
	return true
end

---Main loop. One handler runs per iteration.
---@param token number
function Farm.run(token)
	while not Farm.cancelled(token) do
		if Farm.paused and Farm.state ~= STATES.PAUSED then
			Farm.transition(STATES.PAUSED, "pause requested")
		end

		local handler = HANDLERS[Farm.state]
		if not handler then
			Farm.fail("No handler for state " .. tostring(Farm.state))
			break
		end

		local success, nextState, reason = xpcall(handler, function(errorMessage)
			return debug.traceback(tostring(errorMessage), 2)
		end, Farm.context, token)

		if Farm.cancelled(token) then
			break
		end

		if not success then
			Logger.error("Farm", "Handler %s failed: %s", Farm.state, firstLine(nextState))
			nextState, reason = STATES.RECOVERING, "handler error"
		end

		if nextState and nextState ~= Farm.state then
			Farm.transition(nextState, reason)
		end

		task.wait()
	end
end

---Human-readable description of the current task.
---@return string
function Farm.taskText()
	local state, context = Farm.state, Farm.context

	if state == STATES.STOPPED then
		return "Idle"
	end

	if state == STATES.PAUSED then
		return "Paused"
	end

	if state == STATES.NAVIGATING then
		return "Travelling to " .. tostring(context.navLabel or "destination")
	end

	if state == STATES.EXECUTING_ACTION then
		if context.action == ACTION_ACCEPT then
			return "Accepting quest"
		end

		if context.action == ACTION_ENTER then
			return "Entering Submerged Island"
		end

		return "Attacking " .. (context.target and context.target.Name or "target")
	end

	if state == STATES.FINDING_TARGET then
		if context.noTargetSince then
			return "Waiting for mobs to spawn"
		end

		return "Looking for " .. (context.quest and context.quest.mob or "a target")
	end

	return string.lower((string.gsub(state, "_", " ")))
end

---Kills per minute for this session.
---@return number
function Farm.killsPerMinute()
	local minutes = (os.clock() - Farm.stats.startedAt) / 60
	return Farm.stats.kills / math.max(minutes, 1 / 60)
end

---Set a navigation goal and enter the NAVIGATING state.
---@param context table
---@param goal CFrame
---@param nextState string
---@param label string
---@param entrance Vector3?
---@return string, string
function Farm.navigate(context, goal, nextState, label, entrance)
	context.navGoal = goal
	context.navNext = nextState
	context.navLabel = label
	context.navEntrance = entrance
	context.entranceAttempts = 0
	return STATES.NAVIGATING, "heading to " .. label
end

---Move up and wait for health to recover. Anchoring is always restored.
---@param token number
---@return boolean
local function retreat(token)
	local _, _, root = Character.get()
	if not root then
		return false
	end

	local safeCFrame = CFrame.new(root.Position + Vector3.new(0, RETREAT_HEIGHT, 0))
	local arrived = Movement.moveTo("farm", safeCFrame, function()
		return Farm.cancelled(token) or Farm.paused
	end)

	local _, _, current = Character.get()
	if not (arrived and current) then
		return false
	end

	local wasAnchored = current.Anchored
	current.Anchored = true

	local startedAt = os.clock()
	local recovered = false

	while not Farm.cancelled(token) and not Farm.paused and os.clock() - startedAt < RETREAT_TIMEOUT do
		local percent = Character.healthPercent()
		if not percent then
			break
		end

		if percent >= RESUME_PERCENT then
			recovered = true
			break
		end

		task.wait(0.5)
	end

	current.Anchored = wasAnchored
	return recovered
end

HANDLERS[STATES.INITIALIZING] = function(_, token)
	local deadline = os.clock() + DATA_TIMEOUT

	while os.clock() < deadline do
		if Farm.cancelled(token) then
			return nil
		end

		if Progression.level() then
			return STATES.CHECKING_CHARACTER, "progression data ready"
		end

		task.wait(0.25)
	end

	return STATES.RECOVERING, "Data.Level not found"
end

HANDLERS[STATES.CHECKING_CHARACTER] = function(context)
	local _, _, root = Character.get()
	if not root then
		return STATES.WAITING_FOR_RESPAWN, "no live character"
	end

	local percent = Character.healthPercent()
	local threshold = Config.get("retreatPercent")

	if threshold > 0 and percent and percent < threshold and os.clock() >= context.retreatCooldownUntil then
		return STATES.RECOVERING, LOW_HEALTH
	end

	return STATES.SELECTING_QUEST, "character ready"
end

HANDLERS[STATES.SELECTING_QUEST] = function(context)
	local level = Progression.level()
	if not level then
		return STATES.RECOVERING, "level unreadable"
	end

	local stopLevel = Config.get("stopAtLevel")
	if stopLevel > 0 and level >= stopLevel then
		Notify.push(string.format("Reached level %d, Auto Farm stopped", math.floor(level)), "INFO")
		Farm.stop("level target reached")
		return nil
	end

	if level >= XP_CAP_LEVEL and not context.capNoted then
		context.capNoted = true
		Logger.info("Farm", "Quests stop giving XP at level %d, farming continues for drops", XP_CAP_LEVEL)
	end

	local quest, problem = Quests.select(level)
	if not quest then
		Farm.fail(problem or "no quest available")
		return nil
	end

	if not context.quest or context.quest.name ~= quest.name or context.quest.index ~= quest.index then
		Logger.info("Farm", "Selected %s #%d for %s (level %d)", quest.name, quest.index, quest.mob, level)
		context.questAttempts = 0
		context.pilePoint = nil
	end

	context.quest = quest
	context.target = nil

	if Config.get("autoQuest") and os.clock() >= context.questBlockedUntil then
		return STATES.VERIFYING_QUEST, "checking quest"
	end

	return STATES.FINDING_TARGET, "farming without quest"
end

HANDLERS[STATES.VERIFYING_QUEST] = function(context)
	local quest = context.quest
	local active, problem = Quests.isActiveFor(quest)

	if active then
		context.questAttempts = 0
		context.recoveries = 0
		return STATES.FINDING_TARGET, "quest active"
	end

	if problem then
		if not context.warnedQuestUi then
			context.warnedQuestUi = true
			Logger.warn("Quests", "%s, farming without quest for %ds", problem, QUEST_BLOCK_TIME)
		end

		context.questBlockedUntil = os.clock() + QUEST_BLOCK_TIME
		return STATES.FINDING_TARGET, "cannot verify quests"
	end

	if context.questAttempts >= QUEST_MAX_ATTEMPTS then
		context.questBlockedUntil = os.clock() + QUEST_BLOCK_TIME
		context.questAttempts = 0
		Notify.push(string.format("Quest %s was not accepted, farming without it", quest.name), "WARN")
		return STATES.FINDING_TARGET, "quest not accepted"
	end

	local _, _, root = Character.get()
	if not root then
		return STATES.WAITING_FOR_RESPAWN, "character lost"
	end

	-- Submerged Island quests need the submarine first.
	if quest.entry == "submerged" then
		if Entrances.inSubmerged() then
			context.enterAttempts = 0
		else
			if context.enterAttempts >= QUEST_MAX_ATTEMPTS then
				context.enterAttempts = 0
				return STATES.RECOVERING, "could not enter Submerged Island"
			end

			if (root.Position - SUBMARINE_PORT).Magnitude > QUEST_REACH then
				return Farm.navigate(context, CFrame.new(SUBMARINE_PORT + Vector3.new(0, 3, 0)), STATES.VERIFYING_QUEST, "the submarine port", nil)
			end

			context.action = ACTION_ENTER
			return STATES.EXECUTING_ACTION, "entering Submerged Island"
		end
	end

	if quest.npcPosition and (root.Position - quest.npcPosition).Magnitude > QUEST_REACH then
		return Farm.navigate(context, CFrame.new(quest.npcPosition + Vector3.new(0, 3, 0)), STATES.VERIFYING_QUEST, "the quest NPC", quest.entrance)
	end

	context.action = ACTION_ACCEPT
	return STATES.EXECUTING_ACTION, "accepting quest"
end

HANDLERS[STATES.FINDING_TARGET] = function(context, token)
	local quest = context.quest

	if Config.get("autoQuest") and os.clock() >= context.questBlockedUntil then
		local active = Quests.isActiveFor(quest)
		if not active then
			return STATES.SELECTING_QUEST, "quest not active"
		end
	end

	local level = Progression.level()
	local latest = level and Quests.select(level)
	if latest and (latest.name ~= quest.name or latest.index ~= quest.index) then
		return STATES.SELECTING_QUEST, "level unlocked a new quest"
	end

	local _, _, root = Character.get()
	if not root then
		return STATES.WAITING_FOR_RESPAWN, "character lost"
	end

	local target = Enemies.nearest(quest.mob, root.Position)
	if target then
		context.target = target
		context.action = ACTION_ATTACK
		context.lastProgressAt = os.clock()
		context.noTargetSince = nil
		context.equipFailures = 0
		return STATES.EXECUTING_ACTION, "target " .. target.Name
	end

	context.noTargetSince = context.noTargetSince or os.clock()
	if os.clock() - context.noTargetSince > NO_TARGET_TIMEOUT then
		context.noTargetSince = nil
		return STATES.RECOVERING, "no target found for " .. NO_TARGET_TIMEOUT .. "s"
	end

	local camp = Enemies.campPosition(quest, root.Position)
	if camp and (root.Position - camp).Magnitude > CAMP_RADIUS then
		return Farm.navigate(context, CFrame.new(camp + Vector3.new(0, 4, 0)), STATES.FINDING_TARGET, quest.mob .. " camp", quest.entrance)
	end

	Farm.sleep(0.25, token)
	return nil
end

HANDLERS[STATES.NAVIGATING] = function(context, token)
	local goal = context.navGoal
	if not goal then
		return STATES.CHECKING_CHARACTER, "no navigation goal"
	end

	-- Far islands have a portal command that beats tweening thousands of studs.
	if context.navEntrance and context.entranceAttempts < ENTRANCE_ATTEMPTS then
		local _, _, startRoot = Character.get()

		if startRoot and (startRoot.Position - goal.Position).Magnitude > ENTRANCE_DISTANCE then
			context.entranceAttempts += 1
			Logger.info("Travel", "Using requestEntrance (%d/%d)", context.entranceAttempts, ENTRANCE_ATTEMPTS)
			Remotes.invoke("requestEntrance", context.navEntrance)
			Farm.sleep(2.5, token)
			return nil
		end
	end

	local arrived, why = Movement.moveTo("farm", goal, function()
		return Farm.cancelled(token) or Farm.paused
	end)

	if Farm.cancelled(token) then
		return nil
	end

	if arrived then
		context.busySince = nil
		context.navGoal = nil
		return context.navNext or STATES.CHECKING_CHARACTER, "arrived"
	end

	if why == "busy" then
		context.busySince = context.busySince or os.clock()

		if os.clock() - context.busySince > BUSY_TIMEOUT then
			context.busySince = nil
			return STATES.RECOVERING, "movement stayed busy"
		end

		Farm.sleep(0.5, token)
		return nil
	end

	context.busySince = nil

	if why == "character lost" then
		return STATES.WAITING_FOR_RESPAWN, why
	end

	if why == "aborted" or why == "cancelled" then
		return STATES.CHECKING_CHARACTER, "navigation interrupted"
	end

	return STATES.RECOVERING, "navigation failed: " .. tostring(why)
end

---Wait for the quest UI to confirm acceptance.
---@param quest table
---@param token number
---@return boolean
local function waitForQuest(quest, token)
	local deadline = os.clock() + QUEST_VERIFY_TIMEOUT

	while os.clock() < deadline do
		if Farm.cancelled(token) then
			return false
		end

		if Quests.isActiveFor(quest) then
			return true
		end

		task.wait(0.2)
	end

	return false
end

HANDLERS[STATES.EXECUTING_ACTION] = function(context, token)
	if Movement.owner and Movement.owner ~= "farm" then
		Farm.sleep(0.25, token)
		return nil
	end

	if context.action == ACTION_ENTER then
		context.enterAttempts += 1

		local remote = Entrances.submarineRemote()
		if not remote then
			Logger.error("Quests", "RF/SubmarineWorkerSpeak not found, cannot enter Submerged Island")
			context.questBlockedUntil = os.clock() + QUEST_BLOCK_TIME
			return STATES.RECOVERING, "submarine remote missing"
		end

		local success, result = pcall(remote.InvokeServer, remote, "TravelToSubmergedIsland")
		if not success then
			Logger.error("Quests", "Submarine travel failed: %s", firstLine(result))
		end

		local deadline = os.clock() + 25

		while os.clock() < deadline and not Entrances.inSubmerged() do
			if Farm.cancelled(token) then
				return nil
			end

			task.wait(0.5)
		end

		return STATES.VERIFYING_QUEST, "checked the Submerged Island entry"
	end

	if context.action == ACTION_ACCEPT then
		context.questAttempts += 1

		-- A different active quest blocks acceptance, so drop it first.
		local activeInfo = Quests.readActive()
		if activeInfo and activeInfo.visible then
			Remotes.invoke("AbandonQuest")
		end

		local success, result = Remotes.invoke("StartQuest", context.quest.name, context.quest.index)
		if not success then
			Logger.error("Quests", "StartQuest failed: %s", tostring(result))
		end

		waitForQuest(context.quest, token)
		return STATES.VERIFYING_QUEST, "verifying acceptance"
	end

	local target = context.target
	if not Enemies.isAlive(target) then
		return STATES.VERIFYING_PROGRESS, "target gone"
	end

	local _, _, root = Character.get()
	if not root then
		return STATES.WAITING_FOR_RESPAWN, "character lost"
	end

	local mobName = context.quest.mob
	local height = Combat.effectiveHover()
	local range = Config.get("bringRange")
	local reach = Config.get("hitRange")
	local bringing = Config.get("bringMobs") and os.clock() >= context.bringBlockedUntil
	local targetRoot = target.HumanoidRootPart

	-- Where the pile forms. Without bring mobs the character follows the target instead.
	if bringing and not context.pilePoint then
		context.pilePoint = targetRoot.Position
	end

	local anchorPoint = bringing and context.pilePoint or targetRoot.Position
	local hoverPoint = anchorPoint + Vector3.new(0, height, 0)

	if (root.Position - hoverPoint).Magnitude > HOVER_LEASH then
		return Farm.navigate(context, CFrame.new(hoverPoint), STATES.EXECUTING_ACTION, target.Name, context.quest.entrance)
	end

	if not Combat.equipWeapon() then
		context.equipFailures += 1

		if context.equipFailures >= 3 then
			context.equipFailures = 0
			return STATES.RECOVERING, "no " .. Config.get("weaponType") .. " tool could be equipped"
		end

		Farm.sleep(0.5, token)
		return nil
	end

	context.equipFailures = 0

	local pinned = Pile.collect(mobName, anchorPoint, range, target)

	-- Mobs that never follow the pile mean this client does not own them, so stop pinning for a while.
	if bringing then
		local owned = Bring.ownedCount(pinned)
		context.ownedCount = owned
		context.pinnedCount = #pinned

		if owned == 0 then
			context.bringStalls += 1
		elseif owned then
			context.bringStalls = 0
		end

		if context.bringStalls >= BRING_STALL_BURSTS then
			context.bringStalls = 0
			context.bringBlockedUntil = os.clock() + BRING_BLOCK_TIME
			context.pilePoint = nil
			Logger.warn("Bring", "Mobs are not following the pile, hovering above targets for %ds", BRING_BLOCK_TIME)
			return nil
		end
	end

	-- Every mob of the species inside the hit range can be named in a hit, pinned or not.
	local reachable, distances = Pile.collect(mobName, hoverPoint, reach, target)
	local snapshot = Pile.snapshot(reachable)
	local startPrimary = target
	local primary = target
	local rate = Config.get("attackRate")
	local interval = 1 / rate
	local ticksPerFrame = math.max(1, math.floor(rate / 60))

	-- Every frame: stay above the pile and keep its members on the pile point.
	local release = Movement.hold("farm", function()
		local _, _, currentRoot = Character.get()
		if not currentRoot then
			return
		end

		local point = anchorPoint

		if not bringing then
			if not Enemies.isAlive(primary) then
				return
			end

			point = primary.HumanoidRootPart.Position
		end

		currentRoot.CFrame = CFrame.new(point + Vector3.new(0, height, 0))
		currentRoot.AssemblyLinearVelocity = Vector3.zero

		if bringing then
			Bring.refresh()
			Bring.pin(pinned, point)
		end
	end)

	if not release then
		Farm.sleep(0.25, token)
		return nil
	end

	local failure = nil
	local nextRefresh = os.clock() + PILE_REFRESH
	local endsAt = os.clock() + ACTION_BURST

	while os.clock() < endsAt do
		if Farm.cancelled(token) or Farm.paused then
			release()
			return nil
		end

		if not Character.get() then
			release()
			return STATES.WAITING_FOR_RESPAWN, "character lost"
		end

		-- Move straight on to the next mob in reach without leaving this state.
		if not Enemies.isAlive(primary) then
			primary = Pile.firstAlive(reachable)

			if not primary then
				break
			end
		end

		if os.clock() >= nextRefresh then
			nextRefresh = os.clock() + PILE_REFRESH
			pinned = Pile.collect(mobName, anchorPoint, range, primary)
			reachable, distances = Pile.collect(mobName, hoverPoint, reach, primary)
			snapshot = Pile.snapshot(reachable, snapshot)
		end

		for _ = 1, ticksPerFrame do
			local fired, problem = Combat.attack(primary, reachable)

			if not fired then
				failure = problem
				break
			end
		end

		if failure then
			break
		end

		task.wait(rate >= 60 and 0 or interval)
	end

	release()

	if failure then
		Logger.error("Combat", "Attack failed: %s", tostring(failure))
		Farm.sleep(1, token)
	end

	local kills = Pile.deaths(snapshot)
	local before = Farm.stats.kills
	Farm.stats.kills += kills

	if math.floor(Farm.stats.kills / 10) > math.floor(before / 10) then
		Logger.info("Farm", "%d kills this session", Farm.stats.kills)
	end

	-- How far a hit landed, counting only mobs this script was not pulling itself.
	local pinnedSet = {}

	for _, enemy in pinned do
		pinnedSet[enemy] = true
	end

	local ownDistances = {}

	for enemy, distance in distances do
		if not bringing or not pinnedSet[enemy] then
			ownDistances[enemy] = distance
		end
	end

	local farthest = Pile.farthestDamaged(snapshot, ownDistances)
	if farthest then
		Combat.farthestHit = math.max(Combat.farthestHit, farthest)
	end

	context.target = primary
	context.pileCount = Pile.count(snapshot)
	context.burst = {
		damaged = kills > 0 or Pile.damaged(snapshot, nil),
		othersDamaged = Pile.damaged(snapshot, startPrimary),
		pileSize = context.pileCount,
		hover = height,
	}

	return STATES.VERIFYING_PROGRESS, "burst complete"
end

HANDLERS[STATES.VERIFYING_PROGRESS] = function(context)
	local burst = context.burst
	context.burst = nil

	if not burst then
		return STATES.FINDING_TARGET, "no burst data"
	end

	local threshold = Config.get("retreatPercent")
	local percent = Character.healthPercent()
	if threshold > 0 and percent and percent < threshold and os.clock() >= context.retreatCooldownUntil then
		return STATES.RECOVERING, LOW_HEALTH
	end

	-- No damage from a high hover usually means the target is out of reach, so move closer first.
	if not burst.damaged and Combat.cutHover() then
		context.lastProgressAt = os.clock()
		return STATES.EXECUTING_ACTION, "moving closer"
	end

	if burst.damaged then
		Combat.verifiedHover = burst.hover
		Combat.growHover()
	end

	local verdict = Combat.reportBurst(burst.damaged, burst.othersDamaged, burst.pileSize)

	if burst.damaged then
		context.lastProgressAt = os.clock()
		context.recoveries = 0

		if Enemies.isAlive(context.target) then
			return STATES.EXECUTING_ACTION, "damage observed"
		end

		return STATES.FINDING_TARGET, "pile cleared"
	end

	if verdict == "advanced" then
		context.lastProgressAt = os.clock()
	elseif verdict == "exhausted" then
		Logger.error("Combat", "No hit profile registered damage. Open Logs and press Diagnose.")
		return STATES.RECOVERING, "no hit profile registered damage"
	end

	if os.clock() - context.lastProgressAt > NO_PROGRESS_TIMEOUT then
		Logger.warn("Combat", "No damage in %ds. Check the weapon type and hover height.", NO_PROGRESS_TIMEOUT)
		return STATES.RECOVERING, "no damage observed"
	end

	if not Enemies.isAlive(context.target) then
		return STATES.FINDING_TARGET, "target gone"
	end

	return STATES.EXECUTING_ACTION, "no damage yet, retrying"
end

HANDLERS[STATES.WAITING_FOR_RESPAWN] = function(context, token)
	Movement.cancel()
	context.target = nil
	context.pilePoint = nil

	local deadline = os.clock() + RESPAWN_TIMEOUT

	while os.clock() < deadline do
		if Farm.cancelled(token) then
			return nil
		end

		if Character.get() then
			return STATES.CHECKING_CHARACTER, "character ready"
		end

		task.wait(0.25)
	end

	return STATES.RECOVERING, "respawn timed out"
end

HANDLERS[STATES.RECOVERING] = function(context, token)
	Movement.cancel()
	context.target = nil
	context.pilePoint = nil

	if Farm.reason == LOW_HEALTH then
		local recovered = retreat(token)
		if Farm.cancelled(token) then
			return nil
		end

		-- Do not retreat again straight away if health never recovered.
		context.retreatCooldownUntil = os.clock() + (recovered and 10 or 120)

		return STATES.CHECKING_CHARACTER, recovered and "health restored" or "retreat ended"
	end

	context.recoveries += 1

	if context.recoveries > MAX_RECOVERIES then
		Farm.fail(string.format("%d consecutive failures (last: %s)", MAX_RECOVERIES, Farm.reason))
		return nil
	end

	local delay = math.min(2 * context.recoveries, 10)
	Logger.warn("Farm", "Recovering %d/%d: %s. Retrying in %ds", context.recoveries, MAX_RECOVERIES, Farm.reason, delay)

	if not Farm.sleep(delay, token) then
		return nil
	end

	return STATES.CHECKING_CHARACTER, "retry after recovery"
end

HANDLERS[STATES.PAUSED] = function(_, token)
	Farm.sleep(0.2, token)

	if not Farm.paused then
		return STATES.CHECKING_CHARACTER, "resumed"
	end

	return nil
end

HANDLERS[STATES.STOPPED] = function()
	return nil
end

