	---@param parent Instance
	---@param label string
	---@param key string
	---@param step number
	---@param suffix string
	local function addConfigSlider(parent, label, key, step, suffix)
		local field = SCHEMA[key]
		local row = createRow(parent, 50)

		create("TextLabel", {
			BackgroundTransparency = 1,
			Position = UDim2.fromOffset(12, 6),
			Size = UDim2.new(1, -24, 0, 16),
			Font = Enum.Font.GothamMedium,
			Text = label,
			TextColor3 = THEME.text,
			TextSize = 13,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = row,
		})

		local valueLabel = create("TextLabel", {
			BackgroundTransparency = 1,
			Position = UDim2.fromOffset(12, 6),
			Size = UDim2.new(1, -24, 0, 16),
			Font = Enum.Font.GothamBold,
			Text = "",
			TextColor3 = THEME.blue,
			TextSize = 12,
			TextXAlignment = Enum.TextXAlignment.Right,
			Parent = row,
		})

		local track = create("Frame", {
			Position = UDim2.new(0, 12, 0, 34),
			Size = UDim2.new(1, -24, 0, 6),
			BackgroundColor3 = THEME.off,
			BorderSizePixel = 0,
			Parent = row,
		})

		addCorner(track, 3)

		local fill = create("Frame", {
			Size = UDim2.fromScale(0, 1),
			BackgroundColor3 = Color3.new(1, 1, 1),
			BorderSizePixel = 0,
			Parent = track,
		})

		addCorner(fill, 3)
		addGradient(fill, 0)

		local function render()
			local value = Config.get(key)
			valueLabel.Text = string.format("%s%s", tostring(math.floor(value * 100 + 0.5) / 100), suffix)
			fill.Size = UDim2.fromScale(math.clamp((value - field.min) / (field.max - field.min), 0, 1), 1)
		end

		local sliding = false

		local function update(positionX)
			local alpha = math.clamp((positionX - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
			local raw = field.min + (field.max - field.min) * alpha
			Config.set(key, math.floor(raw / step + 0.5) * step)
			render()
		end

		local hit = create("TextButton", {
			Position = UDim2.new(0, 12, 0, 26),
			Size = UDim2.new(1, -24, 0, 22),
			BackgroundTransparency = 1,
			Text = "",
			ZIndex = 5,
			Parent = row,
		})

		maid:add(hit.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				sliding = true
				update(input.Position.X)
			end
		end))

		maid:add(userInputService.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				sliding = false
			end
		end))

		maid:add(userInputService.InputChanged:Connect(function(input)
			local isMove = input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch
			if sliding and isMove then
				update(input.Position.X)
			end
		end))

		table.insert(refreshers, render)
		render()
	end

