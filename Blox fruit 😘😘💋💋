end

---@param instance Instance
---@param goal table
---@param duration number?
local function animate(instance, goal, duration)
	tweenService:Create(instance, TweenInfo.new(duration or 0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), goal):Play()
end

