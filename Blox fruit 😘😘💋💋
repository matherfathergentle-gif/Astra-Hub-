---Format a message safely, never throwing on a bad template.
---@param template string
---@return string
local function formatMessage(template, ...)
	if select("#", ...) == 0 then
		return tostring(template)
	end

	local success, result = pcall(string.format, template, ...)
	return success and result or tostring(template)
end

---Keep only the first line of an error so logs stay readable.
---@param message any
---@return string
local function firstLine(message)
	return (string.match(tostring(message), "[^\n]+")) or "unknown error"
end

-- Tracks connections, instances, tweens, threads and callbacks for one-call cleanup.
local Maid = {}
Maid.__index = Maid

---Create a new Maid.
function Maid.new()
	return setmetatable({ tasks = {} }, Maid)
end

---Track an item for cleanup.
---@param item any
---@return any
function Maid:add(item)
	table.insert(self.tasks, item)
	return item
end

---Clean every tracked item. Errors are reported, never swallowed.
function Maid:clean()
	local tasks = self.tasks
	self.tasks = {}

	for _, item in tasks do
		local success, errorMessage = pcall(function()
			local itemType = typeof(item)

			if itemType == "RBXScriptConnection" then
				item:Disconnect()
			elseif itemType == "Instance" then
				if item:IsA("Tween") then
					item:Cancel()
				end

				item:Destroy()
			elseif itemType == "function" then
				item()
			elseif itemType == "thread" then
				task.cancel(item)
			end
		end)

		if not success then
			warn("[VANTEX] cleanup failed: " .. firstLine(errorMessage))
		end
	end
end

-- Minimal signal with isolated handlers.
local Signal = {}
Signal.__index = Signal

---Create a new Signal.
function Signal.new()
	return setmetatable({ handlers = {} }, Signal)
end

---Connect a handler.
---@param handler function
---@return table
function Signal:connect(handler)
	local handlers = self.handlers
	local connection = { handler = handler, connected = true }
	table.insert(handlers, connection)

	connection.disconnect = function()
		if not connection.connected then
			return
		end

		connection.connected = false

		local index = table.find(handlers, connection)
		if index then
			table.remove(handlers, index)
		end
	end

	return connection
end

---Fire every handler. One failing handler never blocks the others.
function Signal:fire(...)
	for _, connection in table.clone(self.handlers) do
		if connection.connected then
			local success, errorMessage = pcall(connection.handler, ...)
			if not success then
				warn("[VANTEX] signal handler failed: " .. firstLine(errorMessage))
			end
		end
	end
end

