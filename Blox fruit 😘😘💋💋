local Entrances = {}

---Whether the player is on Submerged Island or in its cavern.
---@return boolean
function Entrances.inSubmerged()
	local location = localPlayer:GetAttribute("CurrentLocation")
	return location == "Submerged Island" or location == "Sealed Cavern"
end

---The submarine worker remote used to reach Submerged Island.
---@return RemoteFunction?
function Entrances.submarineRemote()
