-- Wraps the game's CommF_ remote. Its calls are undocumented and may change.
local Remotes = { commF = nil, lastWarning = 0 }

---Find CommF_ without throwing.
---@return RemoteFunction?
function Remotes.getCommF()
	if Remotes.commF and Remotes.commF.Parent then
		return Remotes.commF
	end

	local folder = replicatedStorage:FindFirstChild("Remotes")
	local remote = folder and folder:FindFirstChild("CommF_")

	if remote and remote:IsA("RemoteFunction") then
		Remotes.commF = remote
		return remote
	end

	if os.clock() - Remotes.lastWarning > 30 then
		Remotes.lastWarning = os.clock()
		Logger.warn("Remotes", "ReplicatedStorage.Remotes.CommF_ not found")
	end

	return nil
end

---Invoke CommF_ safely.
---@return boolean, any
function Remotes.invoke(...)
	local commF = Remotes.getCommF()
	if not commF then
		return false, "CommF_ unavailable"
	end

	local success, result = pcall(commF.InvokeServer, commF, ...)
	if not success then
		return false, firstLine(result)
	end

	return true, result
end

