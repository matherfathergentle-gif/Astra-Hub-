local ServerHop = { busy = false }

---Pick a server with free slots and teleport using documented Roblox APIs.
function ServerHop.perform()
	local url = string.format("https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100", game.PlaceId)
	local response = request({ Url = url, Method = "GET" })

	if not (response and response.Success) then
		error("server list request failed")
	end

	local decoded = httpService:JSONDecode(response.Body)
	if type(decoded) ~= "table" or type(decoded.data) ~= "table" then
		error("unexpected server list format")
	end

	local best = nil

	for _, server in decoded.data do
		if type(server) == "table"
			and server.id ~= game.JobId
			and type(server.playing) == "number"
			and type(server.maxPlayers) == "number"
			and server.playing < server.maxPlayers - 1
			and (not best or server.playing < best.playing)
		then
			best = server
		end
	end

	if not best then
		error("no joinable server found")
	end

	Notify.push(string.format("Joining a server with %d players", best.playing), "INFO")
	teleportService:TeleportToPlaceInstance(game.PlaceId, best.id, localPlayer)
end

function ServerHop.run()
	if ServerHop.busy then
		return
	end

	ServerHop.busy = true
	Status.hop = "Searching for a server"

	task.spawn(function()
		local success, errorMessage = pcall(ServerHop.perform)
		ServerHop.busy = false
		Status.hop = "Idle"

		if not success then
			Notify.push("Server hop failed: " .. firstLine(errorMessage), "ERROR")
		end
	end)
end

