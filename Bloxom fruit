---Format a message safely, never throwing on a bad template.
---@param template string
---@return string
local function formatMessage(template, ...)
	if select("#", ...) == 0 then
		return tostring(template)
	end

	local success, result = pcall(string.format, template, ...)
	return success and result or tostring(template)
end

---Keep only the first line of an error so logs stay readable.
---@param message any
---@return string
local function firstLine(message)
	return (string.match(tostring(message), "[^\n]+")) or "unknown error"
end

-- Tracks connections, instances, tweens, threads and callbacks for one-call cleanup.
local Maid = {}
Maid.__index = Maid

---Create a new Maid.
function Maid.new()
	return setmetatable({ tasks = {} }, Maid)
end

---Track an item for cleanup.
---@param item any
---@return any
function Maid:add(item)
	table.insert(self.tasks, item)
	return item
end

---Clean every tracked item. Errors are reported, never swallowed.
function Maid:clean()
	local tasks = self.tasks
	self.tasks = {}

	for _, item in tasks do
		local success, errorMessage = pcall(function()
			local itemType = typeof(item)

			if itemType == "RBXScriptConnection" then
				item:Disconnect()
			elseif itemType == "Instance" then
				if item:IsA("Tween") then
					item:Cancel()
				end

				item:Destroy()
			elseif itemType == "function" then
				item()
			elseif itemType == "thread" then
				task.cancel(item)
			end
		end)

		if not success then
			warn("[VANTEX] cleanup failed: " .. firstLine(errorMessage))
		end
	end
end

-- Minimal signal with isolated handlers.
local Signal = {}
Signal.__index = Signal

---Create a new Signal.
function Signal.new()
	return setmetatable({ handlers = {} }, Signal)
end

---Connect a handler.
---@param handler function
---@return table
function Signal:connect(handler)
	local handlers = self.handlers
	local connection = { handler = handler, connected = true }
	table.insert(handlers, connection)

	connection.disconnect = function()
		if not connection.connected then
			return
		end

		connection.connected = false

		local index = table.find(handlers, connection)
		if index then
			table.remove(handlers, index)
		end
	end

	return connection
end

---Fire every handler. One failing handler never blocks the others.
function Signal:fire(...)
	for _, connection in table.clone(self.handlers) do
		if connection.connected then
			local success, errorMessage = pcall(connection.handler, ...)
			if not success then
				warn("[VANTEX] signal handler failed: " .. firstLine(errorMessage))
			end
		end
	end
end

-- Detects which executor functions are present instead of assuming them.
local Dependencies = { cache = {} }

---Check whether the environment exposes a global. Results are cached.
---@param name string
---@return boolean
function Dependencies.has(name)
	local cached = Dependencies.cache[name]
	if cached ~= nil then
		return cached
	end

	local success, value = pcall(function()
		return getgenv()[name]
	end)

	local found = success and value ~= nil

	-- Some executors only expose functions in the running script's environment.
	if not found then
		local envSuccess, envValue = pcall(function()
			return getfenv(1)[name]
		end)

		found = envSuccess and envValue ~= nil
	end

	Dependencies.cache[name] = found
	return found
end

---Return the names from a list that are missing.
---@param names table
---@return table
function Dependencies.missing(names)
	local missing = {}

	for _, name in names do
		if not Dependencies.has(name) then
			table.insert(missing, name)
		end
	end

	return missing
end

-- Ring-buffer log shared by every module.
local Logger = {
	entries = {},
	changed = Signal.new(),
	lastNotice = "No notices yet",
	version = 0,
}

---Add a log entry. Identical consecutive entries are merged.
---@param level string
---@param category string
---@param message string
function Logger.add(level, category, message)
	local previous = Logger.entries[#Logger.entries]
	Logger.version += 1

	if previous and previous.level == level and previous.category == category and previous.message == message then
		previous.count += 1
	else
		table.insert(Logger.entries, {
			time = os.date("%H:%M:%S"),
			level = level,
			category = category,
			message = message,
			count = 1,
		})

		if #Logger.entries > LOG_LIMIT then
			table.remove(Logger.entries, 1)
		end
	end

	if level ~= "INFO" or category == "Notice" then
		Logger.lastNotice = string.format("%s [%s] %s", os.date("%H:%M:%S"), level, message)
	end

	Logger.changed:fire()
end

---Log an informational entry.
function Logger.info(category, ...)
	Logger.add("INFO", category, formatMessage(...))
end

---Log a warning.
function Logger.warn(category, ...)
	Logger.add("WARN", category, formatMessage(...))
end

---Log an error.
function Logger.error(category, ...)
	Logger.add("ERROR", category, formatMessage(...))
end

---Remove every entry.
function Logger.clear()
	table.clear(Logger.entries)
	Logger.version += 1
	Logger.changed:fire()
end

-- User-visible notifications, filtered by the notification setting.
local Notify = { shown = Signal.new(), mode = "All", lastMessage = nil, lastAt = 0 }

---Push a notification and log it.
---@param message string
---@param level string?
function Notify.push(message, level)
	level = level or "INFO"
	Logger.add(level, "Notice", message)

	if Notify.mode == "Off" then
		return
	end

	if Notify.mode == "Errors" and level == "INFO" then
		return
	end

	-- Skip a toast identical to the previous one so loops cannot spam the screen.
	local now = os.clock()
	if message == Notify.lastMessage and now - Notify.lastAt < 2 then
		return
	end

	Notify.lastMessage, Notify.lastAt = message, now
	Notify.shown:fire(message, level)
end

