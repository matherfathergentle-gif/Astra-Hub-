		end

		local sinceProgress = os.clock() - Farm.context.lastProgressAt
		return string.format(
			"%d kills  -  last progress %ds ago  -  recoveries %d",
			Farm.stats.kills,
			math.floor(sinceProgress),
			Farm.context.recoveries
		)
	end, 58)

	-- Features tab.
	local featuresPage = pages.Features

	local search = create("TextBox", {
		LayoutOrder = nextOrder(featuresPage),
		Size = UDim2.new(1, 0, 0, 34),
		BackgroundColor3 = THEME.element,
		BorderSizePixel = 0,
		ClearTextOnFocus = false,
		Font = Enum.Font.Gotham,
		PlaceholderText = "Search features...",
		PlaceholderColor3 = THEME.subtext,
		Text = "",
		TextColor3 = THEME.text,
		TextSize = 13,
		Parent = featuresPage,
	})

	addCorner(search, 8)
	addStroke(search, THEME.stroke)
	create("UIPadding", { PaddingLeft = UDim.new(0, 10), Parent = search })

	local featureRows = {}
	local categoryHeaders = {}

	for _, feature in Features.list do
		if not categoryHeaders[feature.category] then
			categoryHeaders[feature.category] = addSection(featuresPage, feature.category)
		end

		local row = createRow(featuresPage, 52)
		featureRows[feature] = row

		local dot = create("Frame", {
			Position = UDim2.fromOffset(10, 10),
			Size = UDim2.fromOffset(8, 8),
			BackgroundColor3 = THEME.off,
			BorderSizePixel = 0,
			Parent = row,
		})

		addCorner(dot, 4)

		create("TextLabel", {
			BackgroundTransparency = 1,
			Position = UDim2.fromOffset(24, 4),
			Size = UDim2.new(1, -150, 0, 18),
			Font = Enum.Font.GothamBold,
			Text = feature.name,
			TextColor3 = THEME.text,
			TextSize = 13,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = row,
		})

		create("TextLabel", {
			BackgroundTransparency = 1,
			Position = UDim2.fromOffset(24, 22),
			Size = UDim2.new(1, -150, 0, 26),
			Font = Enum.Font.Gotham,
			Text = feature.description,
			TextColor3 = THEME.subtext,
			TextSize = 11,
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Top,
			Parent = row,
		})

		local badge = create("TextLabel", {
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -62, 0, 8),
			Size = UDim2.fromOffset(74, 16),
			BackgroundColor3 = THEME.panel,
			BorderSizePixel = 0,
			Font = Enum.Font.GothamBold,
			Text = "",
			TextColor3 = THEME.subtext,
			TextSize = 9,
			Parent = row,
		})

		addCorner(badge, 8)

		table.insert(refreshers, function()
			local compat = Features.effectiveCompat(feature)
			badge.Text = COMPAT_BADGES[compat]
			badge.TextColor3 = BADGE_COLORS[compat]

			local status = Features.status(feature.key)
			dot.BackgroundColor3 = status == "ON" and THEME.good or status == "PAUSED" and THEME.warn or THEME.off
		end)

		if feature.kind == "toggle" then
			addSwitch(row, function()
				return Features.status(feature.key)
			end, function()
				Features.setEnabled(feature.key, not Features.isEnabled(feature))
			end)
		elseif feature.kind == "action" then
			local run = create("TextButton", {
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, -8, 0.5, 8),
				Size = UDim2.fromOffset(50, 24),
				BackgroundColor3 = THEME.panel,
				AutoButtonColor = false,
				BorderSizePixel = 0,
				Font = Enum.Font.GothamBold,
				Text = "Run",
				TextColor3 = THEME.blue,
				TextSize = 12,
				Parent = row,
			})

			addCorner(run, 6)
			addStroke(run, THEME.stroke)

			maid:add(run.MouseButton1Click:Connect(function()
				local available, reason = Features.available(feature)
				if not available then
					Notify.push(feature.name .. " unavailable: " .. tostring(reason), "WARN")
					return
				end

				feature.run()
			end))
		else
			row.Size = UDim2.new(1, 0, 0, 84)

			local destination = create("TextButton", {
				Position = UDim2.new(0, 24, 0, 50),
				Size = UDim2.new(1, -110, 0, 26),
				BackgroundColor3 = THEME.panel,
				AutoButtonColor = false,
				BorderSizePixel = 0,
				Font = Enum.Font.GothamBold,
				Text = "",
				TextColor3 = THEME.blue,
				TextSize = 12,
				Parent = row,
			})

			addCorner(destination, 6)
			addStroke(destination, THEME.stroke)
			maid:add(destination.MouseButton1Click:Connect(Navigation.cycle))

			table.insert(refreshers, function()
				destination.Text = Navigation.selectedName()
			end)

			local go = create("TextButton", {
				AnchorPoint = Vector2.new(1, 0),
				Position = UDim2.new(1, -8, 0, 50),
				Size = UDim2.fromOffset(40, 26),
				BackgroundColor3 = THEME.blue,
				AutoButtonColor = false,
				BorderSizePixel = 0,
				Font = Enum.Font.GothamBold,
				Text = "Go",
				TextColor3 = Color3.new(1, 1, 1),
				TextSize = 12,
				Parent = row,
			})

			addCorner(go, 6)
			maid:add(go.MouseButton1Click:Connect(Navigation.go))

			local stop = create("TextButton", {
				AnchorPoint = Vector2.new(1, 0),
				Position = UDim2.new(1, -52, 0, 50),
				Size = UDim2.fromOffset(46, 26),
				BackgroundColor3 = THEME.panel,
				AutoButtonColor = false,
				BorderSizePixel = 0,
				Font = Enum.Font.GothamBold,
				Text = "Stop",
				TextColor3 = THEME.bad,
				TextSize = 12,
				Parent = row,
			})

			addCorner(stop, 6)
			addStroke(stop, THEME.stroke)
			maid:add(stop.MouseButton1Click:Connect(Navigation.cancel))
		end
	end

	maid:add(search:GetPropertyChangedSignal("Text"):Connect(function()
		local query = string.lower(search.Text)
		local visibleCategories = {}

		for feature, row in featureRows do
			local haystack = string.lower(feature.name .. " " .. feature.description .. " " .. feature.category)
			local matches = query == "" or string.find(haystack, query, 1, true) ~= nil

			row.Visible = matches

			if matches then
				visibleCategories[feature.category] = true
			end
		end

		for category, header in categoryHeaders do
			header.Visible = visibleCategories[category] == true
		end
	end))

	-- Settings tab.
	local settingsPage = pages.Settings

	addSection(settingsPage, "Interface")
	addConfigSlider(settingsPage, "Interface scale", "uiScale", 0.05, "x")
	addConfigSlider(settingsPage, "Refresh interval", "refreshInterval", 0.25, "s")
	addConfigCycle(settingsPage, "Notifications", "notifications")

	addSection(settingsPage, "Farming")
	addConfigToggle(settingsPage, "Take level quests", "autoQuest")
	addConfigCycle(settingsPage, "Weapon type", "weaponType")
	addConfigCycle(settingsPage, "Hit method", "hitMethod")
	addConfigCycle(settingsPage, "Click input", "inputMethod")
	addConfigSlider(settingsPage, "Attack distance", "attackDistance", 1, " studs")
	addConfigSlider(settingsPage, "Move speed", "moveSpeed", 10, " studs/s")
	addConfigSlider(settingsPage, "Retreat below health (0 = off)", "retreatPercent", 5, "%")
	addConfigCycle(settingsPage, "Stat target", "statTarget")

	addSection(settingsPage, "Performance")

	if Dependencies.has("setfpscap") then
		addConfigSlider(settingsPage, "FPS cap (0 = unchanged)", "fpsCap", 10, "")
	else
		addInfo(settingsPage, "FPS cap", function()
			return "Unavailable: executor has no setfpscap"
		end, 40)
	end

	addSection(settingsPage, "Configuration")

	addButton(settingsPage, "Save settings now", function()
		Notify.push(Config.save() and "Settings saved" or "Settings could not be saved", "INFO")
	end)

	addButton(settingsPage, "Reload saved settings", function()
		Config.load()

		for key, value in Config.values do
			Config.changed:fire(key, value)
		end

		Notify.push("Settings reloaded", "INFO")
	end)

	local resetButton = nil
	local resetArmedAt = 0

	resetButton = addButton(settingsPage, "Reset settings to defaults", function()
		if os.clock() - resetArmedAt > 3 then
			resetArmedAt = os.clock()
			resetButton.Text = "Tap again to confirm reset"
			return
		end

		resetArmedAt = 0
		resetButton.Text = "Reset settings to defaults"
		Config.resetToDefaults()
		Notify.push("Settings reset", "INFO")
	end, Color3.fromRGB(70, 28, 36))

	table.insert(refreshers, function()
		if resetArmedAt > 0 and os.clock() - resetArmedAt > 3 then
			resetArmedAt = 0
			resetButton.Text = "Reset settings to defaults"
		end
	end)

	-- Logs tab.
	local logsPage = pages.Logs
	local logFilter = "All"
	local logFilters = { "All", "Errors", "State" }
	local lastLogVersion = -1
	local logLabels = {}

	local logControls = create("Frame", {
		LayoutOrder = nextOrder(logsPage),
		Size = UDim2.new(1, 0, 0, 32),
		BackgroundTransparency = 1,
		Parent = logsPage,
	})

	create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		Padding = UDim.new(0, 4),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = logControls,
	})

	---@param order number
	---@param text string
	---@param callback function
	---@return TextButton
	local function logButton(order, text, callback)
		local button = create("TextButton", {
			LayoutOrder = order,
			Size = UDim2.new(1 / 4, -3, 1, 0),
			BackgroundColor3 = THEME.element,
			AutoButtonColor = false,
			BorderSizePixel = 0,
			Font = Enum.Font.GothamBold,
			Text = text,
			TextColor3 = THEME.text,
			TextSize = 12,
			Parent = logControls,
		})

		addCorner(button, 8)
		addStroke(button, THEME.stroke)
		maid:add(button.MouseButton1Click:Connect(callback))
		return button
	end

	local filterButton = nil

	filterButton = logButton(1, "Filter: All", function()
		local index = table.find(logFilters, logFilter) or 0
		logFilter = logFilters[index % #logFilters + 1]
		filterButton.Text = "Filter: " .. logFilter
		lastLogVersion = -1
	end)

	logButton(2, "Diagnose", function()
		task.spawn(function()
			local success, errorMessage = pcall(Diagnostics.run)
			if not success then
				Logger.error("Diag", "Diagnostics failed: %s", firstLine(errorMessage))
			end
		end)
	end)

	logButton(3, "Copy", function()
		if not Dependencies.has("setclipboard") then
			Notify.push("Copy needs setclipboard", "WARN")
			return
		end

		local lines = {}

		for _, entry in Logger.entries do
			table.insert(lines, string.format("%s [%s] %s: %s", entry.time, entry.level, entry.category, entry.message))
		end

		setclipboard(table.concat(lines, "\n"))
		Notify.push("Logs copied", "INFO")
	end)

	logButton(4, "Clear", function()
		Logger.clear()
	end)

	for index = 1, LOG_VIEW_LIMIT do
		logLabels[index] = create("TextLabel", {
			LayoutOrder = nextOrder(logsPage),
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundTransparency = 1,
			Font = Enum.Font.Code,
			Text = "",
			TextColor3 = THEME.subtext,
			TextSize = 11,
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			Visible = false,
			Parent = logsPage,
		})
	end

	table.insert(refreshers, function()
		if lastLogVersion == Logger.version or not pages.Logs.Visible then
			return
		end

		lastLogVersion = Logger.version

		local nearBottom = logsPage.CanvasPosition.Y + logsPage.AbsoluteWindowSize.Y >= logsPage.AbsoluteCanvasSize.Y - 40
		local visible = {}

		for index = #Logger.entries, 1, -1 do
			local entry = Logger.entries[index]
			local include = logFilter == "All"
				or (logFilter == "Errors" and entry.level ~= "INFO")
				or (logFilter == "State" and entry.category == "State")

			if include then
				table.insert(visible, 1, entry)

				if #visible >= LOG_VIEW_LIMIT then
					break
				end
			end
		end

		for index, label in logLabels do
			local entry = visible[index]

			if entry then
				local suffix = entry.count > 1 and string.format(" (x%d)", entry.count) or ""
				label.Text = string.format("%s %s %s: %s%s", entry.time, entry.level, entry.category, entry.message, suffix)
				label.TextColor3 = LEVEL_COLORS[entry.level] or THEME.subtext
				label.Visible = true
			else
				label.Visible = false
			end
		end

		if nearBottom then
			task.delay(0.05, function()
				if logsPage.Parent then
					logsPage.CanvasPosition = Vector2.new(0, 1e6)
				end
			end)
		end
	end)

	-- Refresh loop. Interval comes from settings and every refresher is isolated.
	local refreshActive = true
	maid:add(function()
		refreshActive = false
	end)

	task.spawn(function()
		while refreshActive do
			for _, refresher in refreshers do
				local success, errorMessage = pcall(refresher)
				if not success then
					Logger.error("Gui", "%s", firstLine(errorMessage))
				end
			end

			task.wait(Config.get("refreshInterval"))
		end
	end)

	selectTab("Dashboard")
end

---Destroy the interface.
function Gui.destroy()
	Gui.maid:clean()
	Gui.root = nil
end

--------------------------------------------------------------------------------
-- Application lifecycle.
--------------------------------------------------------------------------------

local Vantex = { maid = Maid.new() }

---Apply settings that touch the engine.
---@param key string
---@param value any
local function onConfigChanged(key, value)
	if key == "notifications" then
		Notify.mode = value
	elseif key == "fpsCap" and value > 0 and Dependencies.has("setfpscap") then
		setfpscap(value)
	end
end

---Stop everything and release every resource.
function Vantex.detach()
	Logger.info("Core", "Detaching")
	Features.stopAll()
	Farm.stop("detached")
	Navigation.cancel()
	Movement.cancel()
	Config.save()
	Character.destroy()
	Gui.destroy()
	Vantex.maid:clean()

	if shared.VantexHub == Vantex then
		shared.VantexHub = nil
	end
end

---Start the hub.
function Vantex.init()
	Logger.info("Core", "%s starting", HUB_NAME)

	local missing = Dependencies.missing({ "request", "writefile", "readfile", "isfile", "setclipboard", "setfpscap", "mouse1click", "gethui" })
	if #missing > 0 then
		Logger.warn("Core", "Optional executor functions missing: %s", table.concat(missing, ", "))
	end

	Config.load()
	Notify.mode = Config.get("notifications")

	local problems = Quests.validate()
	if problems > 0 then
		Logger.error("Quests", "%d invalid quest entries were found", problems)
	end

	if not QUEST_LISTS[game.PlaceId] then
		Logger.warn("Core", "This place (%d) has no quest data, Auto Farm cannot run here", game.PlaceId)
	end

	Vantex.maid:add(Config.changed:connect(onConfigChanged).disconnect)

	Vantex.maid:add(teleportService.TeleportInitFailed:Connect(function(_, result, message)
		Notify.push(string.format("Teleport failed: %s", tostring(message ~= "" and message or result)), "ERROR")
	end))

	-- Anti-AFK so the idle kick does not interrupt long sessions.
	Vantex.maid:add(localPlayer.Idled:Connect(function()
		virtualUser:CaptureController()
		virtualUser:ClickButton2(Vector2.new())
	end))

	Character.init()

	-- Movement must not outlive the character it was moving.
	Vantex.maid:add(Character.changed:connect(function(event)
		if event == "died" or event == "removed" or event == "replaced" then
			Movement.cancel()
		end
	end).disconnect)

	Vantex.maid:add(Farm.changed:connect(function()
		Features.changed:fire("AutoFarm")
	end).disconnect)

	local built, errorMessage = pcall(Gui.build)
	if not built then
		Logger.error("Gui", "Interface failed to build: %s", firstLine(errorMessage))
		warn("[VANTEX] " .. firstLine(errorMessage))
	end

	for key, value in Config.values do
		onConfigChanged(key, value)
	end

	Notify.push(HUB_NAME .. " ready. Right Ctrl hides the window.", "INFO")
end

shared.VantexHub = Vantex
Vantex.init()
