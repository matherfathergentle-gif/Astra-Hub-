			AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.new(0, 3, 0.5, 0),
			Size = UDim2.fromOffset(16, 16),
			BackgroundColor3 = Color3.new(1, 1, 1),
			BorderSizePixel = 0,
			Parent = track,
		})

		addCorner(knob, 8)

		local lastState = nil

		local function sync()
			local state = getState()
			if state == lastState then
				return
