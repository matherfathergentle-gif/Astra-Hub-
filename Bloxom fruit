			lastState = state

			local on = state == "ON" or state == "PAUSED"
			local color = state == "PAUSED" and THEME.warn or THEME.blue

			animate(track, { BackgroundColor3 = on and color or THEME.off })
			animate(knob, { Position = on and UDim2.new(0, 23, 0.5, 0) or UDim2.new(0, 3, 0.5, 0) })
		end

		table.insert(refreshers, sync)

		local hit = create("TextButton", {
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			Text = "",
			ZIndex = 5,
			Parent = row,
		})

		maid:add(hit.MouseButton1Click:Connect(function()
			onClick()
			sync()
		end))
	end

