-- Minimal maid for connection and instance cleanup.
local Maid = {}
Maid.__index = Maid

---Create a new maid.
function Maid.new()
	return setmetatable({ items = {} }, Maid)
end

---Give an item to the maid.
---@param item RBXScriptConnection|Instance|function
function Maid:give(item)
	table.insert(self.items, item)
	return item
end

---Clean up every item.
function Maid:clean()
	for _, item in ipairs(self.items) do
		local itemType = typeof(item)

		if itemType == "RBXScriptConnection" then
			item:Disconnect()
		elseif itemType == "Instance" then
			item:Destroy()
		elseif itemType == "function" then
			item()
		end
	end

	self.items = {}
end

