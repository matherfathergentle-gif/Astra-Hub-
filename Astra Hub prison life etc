-- Player ESP object.
local PlayerEsp = {}
PlayerEsp.__index = PlayerEsp

---Create a new ESP object for a player.
---@param player Player
function PlayerEsp.new(player)
	local self = setmetatable({}, PlayerEsp)
	self.player = player

	self.box = Drawing.new("Square")
	self.box.Thickness = 1
	self.box.Filled = false

	self.label = Drawing.new("Text")
	self.label.Size = 13
	self.label.Center = true
	self.label.Outline = true
	self.label.Color = Color3.fromRGB(255, 255, 255)

	self.healthBar = Drawing.new("Line")
	self.healthBar.Thickness = 2

	self.tracer = Drawing.new("Line")
	self.tracer.Thickness = 1

	return self
end

---Hide every drawing.
function PlayerEsp:hide()
	self.box.Visible = false
	self.label.Visible = false
	self.healthBar.Visible = false
	self.tracer.Visible = false
end

---Update the drawings for this frame.
function PlayerEsp:update()
	local config = State.config
	local camera = workspace.CurrentCamera
	local character = self.player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local hrp = character and character:FindFirstChild("HumanoidRootPart")

	if not (config.espEnabled and camera and humanoid and hrp and humanoid.Health > 0) then
		return self:hide()
	end

	local distance = (camera.CFrame.Position - hrp.Position).Magnitude
	if distance > config.espMaxDistance then
		return self:hide()
	end

	-- Drawing objects use viewport coordinates.
	local rootPos, onScreen = camera:WorldToViewportPoint(hrp.Position)
	if not onScreen then
		return self:hide()
	end

	local topPos = camera:WorldToViewportPoint(hrp.Position + Vector3.new(0, 3, 0))
	local bottomPos = camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3.5, 0))
	local height = math.abs(bottomPos.Y - topPos.Y)
	local width = height * 0.6
	local color = self.player.TeamColor.Color

	self.box.Visible = config.espBoxes
	self.box.Color = color
	self.box.Size = Vector2.new(width, height)
	self.box.Position = Vector2.new(rootPos.X - width / 2, topPos.Y)

	local labelText = config.espNames and self.player.Name or ""
	if config.espDistance then
		labelText = labelText .. " [" .. math.floor(distance) .. "m]"
	end

	self.label.Visible = labelText ~= ""
	self.label.Text = labelText
	self.label.Position = Vector2.new(rootPos.X, topPos.Y - 16)

	local ratio = math.clamp(humanoid.Health / humanoid.MaxHealth, 0, 1)
	local barX = rootPos.X - width / 2 - 5

	self.healthBar.Visible = config.espHealth
	self.healthBar.Color = Color3.fromRGB(255, 0, 0):Lerp(Color3.fromRGB(0, 255, 0), ratio)
	self.healthBar.From = Vector2.new(barX, topPos.Y + height)
	self.healthBar.To = Vector2.new(barX, topPos.Y + height - height * ratio)

	self.tracer.Visible = config.espTracers
	self.tracer.Color = color
	self.tracer.From = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y)
	self.tracer.To = Vector2.new(rootPos.X, topPos.Y + height)
end

---Destroy every drawing.
function PlayerEsp:destroy()
	self.box:Remove()
	self.label:Remove()
	self.healthBar:Remove()
	self.tracer:Remove()
end

---Add an ESP object for a player.
---@param player Player
local function addEsp(player)
	if player == localPlayer or State.esp[player] then
		return
	end

	State.esp[player] = PlayerEsp.new(player)
end

---Remove the ESP object of a player.
---@param player Player
local function removeEsp(player)
	local esp = State.esp[player]
	if not esp then
		return
	end

	esp:destroy()
	State.esp[player] = nil
end

---Check whether the target part is visible from the camera.
---@param character Model
---@param part BasePart
---@return boolean
local function isVisible(character, part)
	local camera = workspace.CurrentCamera
	local origin = camera.CFrame.Position
	local filter = { camera }

	if localPlayer.Character then
		table.insert(filter, localPlayer.Character)
	end

	wallParams.FilterDescendantsInstances = filter

	local result = workspace:Raycast(origin, part.Position - origin, wallParams)
	return result == nil or result.Instance:IsDescendantOf(character)
end

---Return the player whose HumanoidRootPart projects closest to the screen center within fovRadius.
---@return Player?, number?, table
local function getClosestPlayer()
	local closest, closestDist, candidates = nil, math.huge, {}
	local currentCamera = workspace.CurrentCamera
	local screenCenter = currentCamera.ViewportSize / 2
	local fovRadius = State.config.fovRadius

	for _, player in ipairs(playersService:GetPlayers()) do
		if player == localPlayer then continue end
		if State.config.teamCheck and player.Team == localPlayer.Team then continue end

		local character = player.Character
		if not character then continue end

		local hrp = character:FindFirstChild("HumanoidRootPart")
		local humanoid = character:FindFirstChild("Humanoid")
		if not (hrp and humanoid and humanoid.Health > 0) then continue end

		local screenPos, onScreen = currentCamera:WorldToViewportPoint(hrp.Position)
		if not onScreen then continue end

		if State.config.wallCheck and not isVisible(character, hrp) then continue end

		local dist = (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude
		if dist <= fovRadius then
			table.insert(candidates, { player = player, dist = dist, screenPos = screenPos })
		end
	end

	for _, info in ipairs(candidates) do
		if info.dist < closestDist then
			closest = info.player
			closestDist = info.dist
		end
	end

	return closest, closestDist, candidates
end

---Return the part to aim at for a player.
---@param player Player
---@return BasePart?
local function getAimPart(player)
	local character = player.Character
	if not character then
		return nil
	end

	return character:FindFirstChild(State.config.hitPart) or character:FindFirstChild("HumanoidRootPart")
end

---Check whether the local player is holding a tool.
---@return boolean
local function isHoldingGun()
	local character = localPlayer.Character
	return character ~= nil and character:FindFirstChildOfClass("Tool") ~= nil
end

---Check whether a value looks like the shot table a gun sends to the server.
---@param value any
---@return boolean
local function isShotTable(value)
	if typeof(value) ~= "table" then
		return false
	end

	local first = value[1]
	return typeof(first) == "table" and typeof(first.Hit) == "Instance"
end

---Rewrite the shot table sent to the server so every shot hits the target part.
---@param shots table
---@param part BasePart
---@return table
local function retargetShots(shots, part)
	local retargeted = {}
	local camera = workspace.CurrentCamera

	for index, shot in ipairs(shots) do
		if typeof(shot) ~= "table" then
			retargeted[index] = shot
			continue
		end

		local newShot = table.clone(shot)
		local origin = shot.RayObject and shot.RayObject.Origin or camera.CFrame.Position

		newShot.RayObject = Ray.new(origin, part.Position - origin)
		newShot.Distance = (part.Position - origin).Magnitude
		newShot.Cframe = part.CFrame
		newShot.Hit = part

		retargeted[index] = newShot
	end

	return retargeted
end

---Install the silent aim hooks.
local function installSilentAim()
	local mouse = localPlayer:GetMouse()

	local oldNamecall
	oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
		local method = getnamecallmethod()
		local target = State.target

		if State.detached or not target or not State.config.silentAimEnabled or checkcaller() then
			return oldNamecall(self, ...)
		end

		-- Redirect the hit data the gun sends to the server.
		if method == "FireServer" and typeof(self) == "Instance" then
			local args = table.pack(...)

			if isShotTable(args[1]) or (typeof(args[1]) == "table" and self.Name == "ShootEvent") then
				args[1] = retargetShots(args[1], target.part)
				return oldNamecall(self, table.unpack(args, 1, args.n))
			end
		end

		if not State.holdingGun then
			return oldNamecall(self, ...)
		end

		-- Redirect the ray the gun builds from the cursor.
		if method == "ScreenPointToRay" or method == "ViewportPointToRay" then
			if self == workspace.CurrentCamera then
				local ray = oldNamecall(self, ...)
				return Ray.new(ray.Origin, (target.part.Position - ray.Origin).Unit * ray.Direction.Magnitude)
			end
		end

		-- Redirect the bullet rays cast by the gun.
		if self == workspace then
			if RAY_METHODS[method] then
				local args = table.pack(...)
				local ray = args[1]

				if typeof(ray) == "Ray" and ray.Direction.Magnitude >= MIN_RAY_LENGTH then
					args[1] = Ray.new(ray.Origin, (target.part.Position - ray.Origin).Unit * ray.Direction.Magnitude)
					return oldNamecall(self, table.unpack(args, 1, args.n))
				end
			elseif method == "Raycast" then
				local args = table.pack(...)
				local origin, direction = args[1], args[2]

				if typeof(origin) == "Vector3" and typeof(direction) == "Vector3" and direction.Magnitude >= MIN_RAY_LENGTH then
					args[2] = (target.part.Position - origin).Unit * direction.Magnitude
					return oldNamecall(self, table.unpack(args, 1, args.n))
				end
			end
		end

		return oldNamecall(self, ...)
	end))

	-- Spoof the mouse for guns that aim with Mouse.Hit or Mouse.Target.
	local oldIndex
	oldIndex = hookmetamethod(game, "__index", newcclosure(function(self, key)
		if self ~= mouse then
			return oldIndex(self, key)
		end

		local target = State.target
		if State.detached or not target or not State.config.silentAimEnabled or not State.holdingGun or checkcaller() then
			return oldIndex(self, key)
		end

		if key == "Hit" then
			return CFrame.new(target.part.Position)
		elseif key == "Target" then
			return target.part
		end

		return oldIndex(self, key)
	end))
end

---Apply the gun mods to a tool.
---@param tool Tool
local function applyGunMods(tool)
	local module = tool:FindFirstChild("GunStates")
	if not module then
		return
	end

	-- Drop identity so the game module cannot see our environment.
	setthreadidentity(2)
	local success, states = pcall(require, module)
	setthreadidentity(8)

	if not success or typeof(states) ~= "table" then
		return
	end

	for key, value in pairs(GUN_MODS) do
		if states[key] ~= nil then
			states[key] = value
		end
	end

	State.moddedTools[tool] = true
end

---Apply the gun mods to every unmodded tool in a container.
---@param container Instance?
local function modContainer(container)
	if not container then
		return
	end

	for _, tool in ipairs(container:GetChildren()) do
		if tool:IsA("Tool") and not State.moddedTools[tool] then
			applyGunMods(tool)
		end
	end
end

---Request every gun from the prison giver.
local function grabGuns()
	local remote = workspace:FindFirstChild("Remote")
	local itemHandler = remote and remote:FindFirstChild("ItemHandler")
	local items = workspace:FindFirstChild("Prison_ITEMS")
	local giver = items and items:FindFirstChild("giver")

	if not (itemHandler and giver) then
		return warn("Gun givers not found.")
	end

	for _, gunName in ipairs(GUN_NAMES) do
		local gun = giver:FindFirstChild(gunName)
		local pickup = gun and gun:FindFirstChild("ITEMPICKUP")

		if pickup then
			pcall(itemHandler.InvokeServer, itemHandler, pickup)
		end
	end
end

---Return the current server ping in milliseconds.
---@return number
local function getPing()
	local success, ping = pcall(function()
		return statsService.Network.ServerStatsItem["Data Ping"]:GetValue()
	end)

	return success and math.floor(ping) or 0
end

---Update the watermark text.
---@param deltaTime number
local function updateWatermark(deltaTime)
	local watermark = State.watermark
	if not watermark then
		return
	end

	watermark.frame.Visible = State.config.watermark
	if not State.config.watermark then
		return
	end

	-- Smooth the fps so the number stays readable.
	State.fps = State.fps + (1 / math.max(deltaTime, 0.001) - State.fps) * 0.1

	if os.clock() - State.lastWatermark < 0.25 then
		return
	end

	State.lastWatermark = os.clock()

	local text = string.format("Astro Hub  |  %d fps  |  %d ms", math.floor(State.fps + 0.5), getPing())
	if State.target then
		text = text .. "  |  Target: " .. State.target.player.Name
	end

	watermark.label.Text = text
end

---Runs every frame.
---@param deltaTime number
local function onRender(deltaTime)
	if State.detached then
		return
	end

	local config = State.config
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end

	-- Pick the silent aim target for this frame.
	State.target = nil
	State.holdingGun = isHoldingGun()

	if config.silentAimEnabled then
		local closest = getClosestPlayer()
		local part = closest and getAimPart(closest)

		if part then
			State.target = { player = closest, part = part }
		end
	end

	-- The FOV circle always sits in the center of the screen.
	local fovCircle = State.fovCircle
	fovCircle.Visible = config.silentAimEnabled and config.fovVisible
	fovCircle.Radius = config.fovRadius
	fovCircle.Position = camera.ViewportSize / 2
	fovCircle.Color = State.target and Color3.fromRGB(0, 255, 100) or Color3.fromRGB(255, 255, 255)

	for _, esp in pairs(State.esp) do
		esp:update()
	end

	updateWatermark(deltaTime)
end

---Runs every physics step.
local function onStepped()
	if State.detached then
		return
	end

	local config = State.config
	local character = localPlayer.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return
	end

	if config.speedEnabled then
		humanoid.WalkSpeed = config.walkSpeed
	end

	if config.jumpEnabled then
		humanoid.UseJumpPower = true
		humanoid.JumpPower = config.jumpPower
	end

	if config.noclip then
		for _, part in ipairs(character:GetDescendants()) do
			if part:IsA("BasePart") then
				part.CanCollide = false
			end
		end
	end
end

---Runs every heartbeat.
local function onHeartbeat()
	if State.detached or not State.config.gunMods then
		return
	end

	-- Throttle the scan since new guns appear rarely.
	if os.clock() - State.lastModScan < 1 then
		return
	end

	State.lastModScan = os.clock()

	modContainer(localPlayer.Character)
	modContainer(localPlayer:FindFirstChildOfClass("Backpack"))
end

---Return the next layout order.
---@return number
local function nextOrder()
	State.layoutOrder += 1
	return State.layoutOrder
end

---Create an instance with properties.
---@param className string
---@param properties table
---@param parent Instance
---@return Instance
local function create(className, properties, parent)
	local instance = Instance.new(className)

	for property, value in pairs(properties) do
		instance[property] = value
	end

	instance.Parent = parent
	return instance
end

---Tween an instance to a goal.
---@param instance Instance
---@param goal table
---@param duration number?
local function tween(instance, goal, duration)
	local info = TweenInfo.new(duration or 0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	tweenService:Create(instance, info, goal):Play()
end

---Bind a property to the theme accent color.
---@param instance Instance
---@param property string
local function bindAccent(instance, property)
	instance[property] = THEME.accent
	table.insert(State.accentBound, { instance = instance, property = property })
end

---Build the accent gradient sequence.
---@return ColorSequence
local function accentSequence()
	return ColorSequence.new(THEME.accent, THEME.accent:Lerp(Color3.new(1, 1, 1), 0.4))
end

---Apply a theme preset to the whole interface.
---@param name string
local function applyTheme(name)
	for _, preset in ipairs(THEME_PRESETS) do
		if preset.name == name then
			THEME.accent = preset.accent
			break
		end
	end

	for _, entry in ipairs(State.accentBound) do
		tween(entry.instance, { [entry.property] = THEME.accent }, 0.25)
	end

	if State.accentGradient then
		State.accentGradient.Color = accentSequence()
	end

	for _, refresh in ipairs(State.refreshers) do
		refresh()
	end
end

---Save the config to disk.
---@return boolean
local function saveConfig()
	return (pcall(function()
		if not isfolder(CONFIG_FOLDER) then
			makefolder(CONFIG_FOLDER)
		end

		writefile(CONFIG_PATH, httpService:JSONEncode(State.config))
	end))
end

---Load the config from disk.
---@return boolean
local function loadConfig()
	local success, decoded = pcall(function()
		if not isfile(CONFIG_PATH) then
			return nil
		end

		return httpService:JSONDecode(readfile(CONFIG_PATH))
	end)

	if not success or typeof(decoded) ~= "table" then
		return false
	end

	-- Only accept keys that exist with the same type.
	for key, value in pairs(decoded) do
		if typeof(State.config[key]) == typeof(value) then
			State.config[key] = value
		end
	end

	applyTheme(State.config.theme)
	return true
end

---Check whether an input is a click or a touch.
---@param input InputObject
---@return boolean
local function isPointerInput(input)
	return input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch
end

---Make a frame draggable by its handle.
---@param handle GuiObject
---@param frame GuiObject
local function makeDraggable(handle, frame)
	local dragging, dragStart, startPosition = false, nil, nil

	State.maid:give(handle.InputBegan:Connect(function(input)
		if not isPointerInput(input) then return end

		dragging = true
		dragStart = input.Position
		startPosition = frame.Position
	end))

	State.maid:give(userInputService.InputChanged:Connect(function(input)
		if not dragging then return end
		if input.UserInputType ~= Enum.UserInputType.MouseMovement and input.UserInputType ~= Enum.UserInputType.Touch then return end

		local delta = input.Position - dragStart
		frame.Position = UDim2.new(startPosition.X.Scale, startPosition.X.Offset + delta.X, startPosition.Y.Scale, startPosition.Y.Offset + delta.Y)
	end))

	State.maid:give(userInputService.InputEnded:Connect(function(input)
		if isPointerInput(input) then
			dragging = false
		end
	end))
end

