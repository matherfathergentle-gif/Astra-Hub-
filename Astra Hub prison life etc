---Add a slider bound to a config key.
---@param card Frame
---@param label string
---@param key string
---@param minimum number
---@param maximum number
---@param step number
local function addSlider(card, label, key, minimum, maximum, step)
	local holder = create("Frame", {
		Size = UDim2.new(1, 0, 0, 40),
		BackgroundTransparency = 1,
		LayoutOrder = nextOrder(),
	}, card)

	addRowLabel(holder, label).Size = UDim2.new(1, -70, 0, 16)

	local valueLabel = create("TextLabel", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 0),
		Size = UDim2.fromOffset(60, 16),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		TextSize = 12,
		TextColor3 = THEME.subText,
		TextXAlignment = Enum.TextXAlignment.Right,
	}, holder)

	local hitbox = create("Frame", {
		Position = UDim2.fromOffset(0, 20),
		Size = UDim2.new(1, 0, 0, 18),
		BackgroundTransparency = 1,
	}, holder)

	local bar = create("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 0, 0.5, 0),
		Size = UDim2.new(1, 0, 0, 6),
		BackgroundColor3 = THEME.element,
		BorderSizePixel = 0,
	}, hitbox)

	create("UICorner", { CornerRadius = UDim.new(1, 0) }, bar)

	local fill = create("Frame", {
		Size = UDim2.fromScale(0, 1),
		BorderSizePixel = 0,
	}, bar)

	bindAccent(fill, "BackgroundColor3")
	create("UICorner", { CornerRadius = UDim.new(1, 0) }, fill)

	local knob = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0, 0.5),
		Size = UDim2.fromOffset(12, 12),
		BackgroundColor3 = THEME.text,
		BorderSizePixel = 0,
	}, bar)

	create("UICorner", { CornerRadius = UDim.new(1, 0) }, knob)

	local function refresh()
		local value = State.config[key]
		local alpha = math.clamp((value - minimum) / (maximum - minimum), 0, 1)

		valueLabel.Text = tostring(value)
		fill.Size = UDim2.fromScale(alpha, 1)
		knob.Position = UDim2.fromScale(alpha, 0.5)
	end

	local function updateFromInput(input)
		local alpha = math.clamp((input.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
		local value = minimum + (maximum - minimum) * alpha

		State.config[key] = math.clamp(math.floor(value / step + 0.5) * step, minimum, maximum)
		refresh()
	end

	local sliding = false

	State.maid:give(hitbox.InputBegan:Connect(function(input)
		if not isPointerInput(input) then return end

		sliding = true
		updateFromInput(input)
	end))

	State.maid:give(userInputService.InputChanged:Connect(function(input)
		if not sliding then return end
		if input.UserInputType ~= Enum.UserInputType.MouseMovement and input.UserInputType ~= Enum.UserInputType.Touch then return end

		updateFromInput(input)
	end))

	State.maid:give(userInputService.InputEnded:Connect(function(input)
		if isPointerInput(input) then
			sliding = false
		end
	end))

	table.insert(State.refreshers, refresh)
	refresh()
end

---Add a selector that cycles through options.
---@param card Frame
---@param label string
---@param key string
---@param options table
---@param onChange function?
local function addCycle(card, label, key, options, onChange)
	local row = create("TextButton", {
		Size = UDim2.new(1, 0, 0, 28),
		BackgroundTransparency = 1,
		AutoButtonColor = false,
		Text = "",
		LayoutOrder = nextOrder(),
	}, card)

	addRowLabel(row, label)

	local chip = create("TextLabel", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, 0, 0.5, 0),
		Size = UDim2.fromOffset(84, 22),
		BackgroundColor3 = THEME.element,
		BorderSizePixel = 0,
		Font = Enum.Font.GothamBold,
		TextSize = 12,
	}, row)

	bindAccent(chip, "TextColor3")
	create("UICorner", { CornerRadius = UDim.new(0, 6) }, chip)

	local function refresh()
		chip.Text = State.config[key]
	end

	State.maid:give(row.MouseButton1Click:Connect(function()
		local index = table.find(options, State.config[key]) or 0

		State.config[key] = options[index % #options + 1]
		refresh()

		if onChange then
			onChange(State.config[key])
		end
	end))

	table.insert(State.refreshers, refresh)
	refresh()
end

