---Initialize the script.
function AstroHub.init()
	if not game:IsLoaded() then
		game.Loaded:Wait()
	end

	State.fovCircle = Drawing.new("Circle")
	State.fovCircle.Thickness = 1.5
	State.fovCircle.NumSides = 96
	State.fovCircle.Filled = false

	for _, player in ipairs(playersService:GetPlayers()) do
		addEsp(player)
	end

	State.maid:give(playersService.PlayerAdded:Connect(addEsp))
	State.maid:give(playersService.PlayerRemoving:Connect(removeEsp))
	State.maid:give(runService.RenderStepped:Connect(onRender))
	State.maid:give(runService.Stepped:Connect(onStepped))
	State.maid:give(runService.Heartbeat:Connect(onHeartbeat))

	State.maid:give(userInputService.JumpRequest:Connect(function()
		if not State.config.infiniteJump then
			return
		end

		local character = localPlayer.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")

		if humanoid then
			humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
		end
	end))

	createMenu()
	installSilentAim()
end

---Detach the script and clean everything up.
function AstroHub.detach()
	State.detached = true
	State.target = nil
	State.maid:clean()

	for _, esp in pairs(State.esp) do
		esp:destroy()
	end

	State.esp = {}

	if State.fovCircle then
		State.fovCircle:Remove()
		State.fovCircle = nil
	end
end

---This is called when initialization errors.
---@param error string
local function onInitializeError(error)
	warn("Failed to initialize.")
	warn(error)
	warn(debug.traceback())
	AstroHub.detach()
end

