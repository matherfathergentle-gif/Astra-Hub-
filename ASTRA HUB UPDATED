local function applyResponsive()
local camera = workspace.CurrentCamera
if not camera then
return
end
local viewport = camera.ViewportSize
local scale = State.config.uiScale / 100
local width = math.clamp(viewport.X * 0.85 / scale, 320, 660)
local height = math.clamp(viewport.Y * 0.85 / scale, 260, 470)
local compact = width < 540
local sidebarWidth = compact and 92 or 132
scaler.Size = UDim2.fromOffset(width, height)
window.Size = UDim2.fromOffset(width * scale, height * scale)
sidebar.Size = UDim2.new(0, sidebarWidth, 1, -(HEADER_HEIGHT + 1))
divider.Position = UDim2.fromOffset(sidebarWidth, HEADER_HEIGHT + 1)
content.Position = UDim2.fromOffset(sidebarWidth + 1, HEADER_HEIGHT + 1)
content.Size = UDim2.new(1, -(sidebarWidth + 1), 1, -(HEADER_HEIGHT + 1))
