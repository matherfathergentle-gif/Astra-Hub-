local function runStage(name, callback)
local success, result = xpcall(callback, function(message)
return tostring(message) .. "\n" .. debug.traceback()
end)
if success then
return
end
table.insert(State.errors, name .. ": " .. tostring(result))
warn("Astra Hub stage failed: " .. name)
warn(result)
end
local function showErrors()
if #State.errors == 0 then
return
end
pcall(function()
local gui = Instance.new("ScreenGui")
gui.Name = "AstraHubErrors"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.DisplayOrder = 1000
gui.Parent = State.guiParent or getGuiParent()
local box = Instance.new("TextButton")
box.AnchorPoint = Vector2.new(0.5, 0)
box.Position = UDim2.new(0.5, 0, 0, 20)
box.Size = UDim2.new(0.92, 0, 0, 0)
box.AutomaticSize = Enum.AutomaticSize.Y
box.BackgroundColor3 = Color3.fromRGB(40, 12, 16)
box.BorderSizePixel = 0
box.Font = Enum.Font.Code
box.TextSize = 12
box.TextColor3 = Color3.fromRGB(255, 170, 170)
box.TextWrapped = true
box.TextXAlignment = Enum.TextXAlignment.Left
box.TextYAlignment = Enum.TextYAlignment.Top
box.Text = string.sub("Astra Hub had problems loading (tap to close):\n\n" .. table.concat(State.errors, "\n\n"), 1, 1200)
box.Parent = gui
box.MouseButton1Click:Connect(function()
gui:Destroy()
end)
end)
end
function AstraHub.init()
if not game:IsLoaded() then
game.Loaded:Wait()
end
State.noDrawing = not pcall(function()
Drawing.new("Line"):Remove()
end)
State.logoAsset = loadLogo()
runStage("menu", createMenu)
runStage("players", function()
for _, player in ipairs(playersService:GetPlayers()) do
addEsp(player)
end
State.maid:give(playersService.PlayerAdded:Connect(addEsp))
State.maid:give(playersService.PlayerRemoving:Connect(removePlayer))
end)
runStage("loops", function()
State.maid:give(runService.RenderStepped:Connect(onRender))
State.maid:give(runService.Stepped:Connect(onStepped))
State.maid:give(runService.Heartbeat:Connect(onHeartbeat))
State.maid:give(userInputService.JumpRequest:Connect(function()
if not State.config.infiniteJump then
return
end
local character = localPlayer.Character
local humanoid = character and character:FindFirstChildOfClass("Humanoid")
if humanoid then
humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
end
end))
end)
runStage("attacker tracking", function()
State.maid:give(localPlayer.CharacterAdded:Connect(watchCharacter))
State.maid:give(function()
if State.healthConnection then
State.healthConnection:Disconnect()
State.healthConnection = nil
end
end)
if localPlayer.Character then
task.spawn(watchCharacter, localPlayer.Character)
end
end)
runStage("silent aim", installSilentAim)
showErrors()
if State.noDrawing then
notify("Compatibility", "No Drawing library. ESP uses chams and name tags.", "info")
end
end
function AstraHub.detach()
State.detached = true
State.target = nil
State.config.fullbright = false
updateFullbright()
local camera = workspace.CurrentCamera
if camera and State.baseFov then
camera.FieldOfView = State.baseFov
State.baseFov = nil
end
State.maid:clean()
for _, esp in pairs(State.esp) do
esp:destroy()
end
State.esp = {}
State.fovRing = nil
State.targetLine = nil
State.targetDot = nil
end
local function onInitializeError(error)
table.insert(State.errors, "init: " .. tostring(error))
warn("Failed to initialize.")
warn(error)
warn(debug.traceback())
showErrors()
AstraHub.detach()
end
for _, name in ipairs({ "PrisonLife", "AstroHub", "AstraHub" }) do
if shared[name] then
shared[name].detach()
end
end
shared.AstraHub = AstraHub
xpcall(AstraHub.init, onInitializeError)
