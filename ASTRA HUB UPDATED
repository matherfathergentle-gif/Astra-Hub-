local function installScrollFallback(pageArea, pages)
local guiInset = guiService:GetGuiInset()
local function isInside(position)
local corner, size = pageArea.AbsolutePosition, pageArea.AbsoluteSize
return position.X >= corner.X and position.X <= corner.X + size.X and position.Y >= corner.Y and position.Y <= corner.Y + size.Y
end
local function getMaxScroll(page)
return math.max(0, page.AbsoluteCanvasSize.Y - page.AbsoluteWindowSize.Y)
end
State.maid:give(userInputService.InputChanged:Connect(function(input)
if input.UserInputType ~= Enum.UserInputType.MouseWheel or not State.menuVisible then
return
end
local page = pages[State.currentTab]
if not page or not isInside(userInputService:GetMouseLocation()) then
return
end
local before = page.CanvasPosition.Y
local direction = input.Position.Z
task.spawn(function()
runService.RenderStepped:Wait()
if State.detached or page.CanvasPosition.Y ~= before then
return
end
page.CanvasPosition = Vector2.new(0, math.clamp(before - direction * WHEEL_STEP, 0, getMaxScroll(page)))
State.lastScrollTime = os.clock()
end)
end))
local tracking = nil
State.maid:give(userInputService.InputBegan:Connect(function(input)
if not State.menuVisible or not isPointerInput(input) then
return
end
local inside
if input.UserInputType == Enum.UserInputType.Touch then
local raw = Vector2.new(input.Position.X, input.Position.Y)
inside = isInside(raw) or isInside(raw + Vector2.new(0, guiInset.Y))
else
inside = isInside(userInputService:GetMouseLocation())
end
local page = pages[State.currentTab]
if not inside or not page then
return
end
tracking = {
input = input,
page = page,
startY = input.Position.Y,
canvas = page.CanvasPosition.Y,
checkAt = nil,
taken = false,
}
end))
State.maid:give(userInputService.InputChanged:Connect(function(input)
local track = tracking
if not track or State.sliderActive then
return
end
local sameTouch = input == track.input
local mouseMove = track.input.UserInputType == Enum.UserInputType.MouseButton1 and input.UserInputType == Enum.UserInputType.MouseMovement
if not (sameTouch or mouseMove) then
return
end
local delta = input.Position.Y - track.startY
if math.abs(delta) < SCROLL_THRESHOLD then
return
end
if not track.checkAt then
track.checkAt = os.clock() + 0.08
return
end
if not track.taken then
if os.clock() < track.checkAt then
return
end
if track.page.CanvasPosition.Y ~= track.canvas then
tracking = nil
return
end
track.taken = true
State.scrollTaken = true
track.page.ScrollingEnabled = false
end
State.lastScrollTime = os.clock()
track.page.CanvasPosition = Vector2.new(0, math.clamp(track.canvas - delta, 0, getMaxScroll(track.page)))
end))
State.maid:give(userInputService.InputEnded:Connect(function(input)
local track = tracking
if not track then
return
end
if input ~= track.input and not isPointerInput(input) then
return
end
if track.taken then
State.scrollTaken = false
track.page.ScrollingEnabled = true
end
tracking = nil
end))
end
