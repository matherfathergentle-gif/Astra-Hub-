---@param wrapper Frame
local function dismissToast(wrapper)
	if State.detached then
		return
	end

	local index = table.find(State.toasts, wrapper)

	if not index then
		return
	end

	table.remove(State.toasts, index)

	local toast = wrapper:FindFirstChild("Toast")

	if toast then
		tween(toast, { Position = UDim2.fromOffset(TOAST_WIDTH + 40, 0) }, 0.22, Enum.EasingStyle.Back)
	end

	task.delay(0.25, function()
		if not State.detached then
			wrapper:Destroy()
		end
	end)
end

---@param title string
---@param message string
---@param kind string?
local function showToast(title, message, kind)
	if State.detached or not State.notifyHolder then
		return
	end

	local color = THEME.accent
	local iconText = "i"

	if kind == "success" then
		color = THEME.success
		iconText = "OK"
	elseif kind == "error" then
		color = THEME.danger
		iconText = "!"
	end

	if #State.toasts >= TOAST_MAX then
		dismissToast(State.toasts[1])
	end

	local wrapper = create("Frame", {
		Size = UDim2.fromOffset(TOAST_WIDTH, 58),
		BackgroundTransparency = 1,
		LayoutOrder = nextOrder(),
