---@return number
local function getPing()
	return math.floor(Ping.rttSeconds * 1000 + 0.5)
end

---@param deltaTime number
local function updateHud(deltaTime)
	State.fps = State.fps + (1 / math.max(deltaTime, 0.001) - State.fps) * 0.1

	if os.clock() - State.lastHud < 0.25 then
		return
	end

	State.lastHud = os.clock()

	local role = State.myRole

	if State.roleChip then
		State.roleChip.Text = role
		State.roleChip.TextColor3 = ROLE_COLORS[role] or ROLE_COLORS.Innocent
	end

	if State.profileRole then
		State.profileRole.Text = role
		State.profileRole.TextColor3 = ROLE_COLORS[role] or ROLE_COLORS.Innocent
	end

	if State.menuVisible then
		for _, row in State.liveRows do
			local success, text = pcall(row.getter)
			row.label.Text = success and tostring(text) or "-"
		end
	end

	local watermark = State.watermark

	if not watermark then
		return
	end

	watermark.frame.Visible = State.config.watermark

	if not State.config.watermark then
		return
	end

	local headline = role

	if State.target then
		headline = "Aiming " .. State.target.player.Name
	elseif State.config.silentAim and State.holdingGun then
		headline = "Silent Aim Ready"
	elseif State.holdingGun then
		headline = "Gun Ready"
	end

	watermark.label.Text = headline
	watermark.label.TextColor3 = State.target and ROLE_COLORS.Murderer or Color3.new(1, 1, 1)
	watermark.subLabel.Text = string.format("%d fps  |  %d ms  |  lead %d ms", math.floor(State.fps + 0.5), getPing(), math.floor(Predictor.lastLead * 1000 + 0.5))
end

---@param deltaTime number
local function onRender(deltaTime)
	if State.detached then
		return
	end

	local config = State.config
	local camera = workspace.CurrentCamera

	if not camera then
		return
	end

	local now = os.clock()

	Roles.refresh()
	State.myRole = (Roles.of(localPlayer))
	State.holdingGun = isHoldingGun()
	State.hasGun = State.holdingGun or hasGunAnywhere()

	if now - State.lastPing > 0.2 then
		State.lastPing = now
		Ping.update()
	end

	if now >= State.nextRoll then
		State.nextRoll = now + 0.35
		State.hitRoll = math.random(1, 100) <= config.hitChance
		State.headRoll = math.random() < 0.6
	end

	for _, player in playersService:GetPlayers() do
		if player ~= localPlayer then
			local character = player.Character
			local hrp = character and character:FindFirstChild("HumanoidRootPart")

			if hrp then
				Tracker.record(player, hrp)
			else
				Tracker.histories[player] = nil
			end
		end
	end

	local wantTarget = State.hasGun and (config.silentAim or config.showShootButton or config.predictionMarker)

	if now - State.lastScan >= SCAN_INTERVAL then
		State.lastScan = now

		if wantTarget then
			local picked = pickTarget(camera)
			State.targetPlayer = picked
			State.targetPart = picked and getAimPart(picked) or nil
		else
			State.targetPlayer, State.targetPart = nil, nil
		end
	end

	local target = nil
	local part = State.targetPart

	if State.targetPlayer and part and part.Parent then
		local position, lead, model = Predictor.predict(State.targetPlayer, part)
		target = { player = State.targetPlayer, part = part, aimPosition = position, lead = lead }
		Predictor.queue(State.targetPlayer, model, lead)
	end

	State.target = target
	Predictor.resolve()

	local screenCenter = camera.ViewportSize / 2
	local fovRing = State.fovRing

	if fovRing then
		fovRing.Visible = config.silentAim and config.silentUseFov and config.fovVisible and State.holdingGun
		fovRing.Size = UDim2.fromOffset(config.silentFov * 2, config.silentFov * 2)
		fovRing.Position = UDim2.fromOffset(screenCenter.X, screenCenter.Y)
		State.fovStroke.Color = target and Color3.fromRGB(0, 255, 100) or Color3.fromRGB(255, 255, 255)
	end

	-- ScreenGui is created with IgnoreGuiInset, so viewport coordinates line up with it.
	local targetScreen = target and camera:WorldToViewportPoint(target.part.Position)
	local predictionScreen = target and camera:WorldToViewportPoint(target.aimPosition)

	if State.targetLine and State.targetDot then
		local showLine = config.targetLine and targetScreen ~= nil
		State.targetLine.Visible = showLine
		State.targetDot.Visible = showLine

		if showLine then
			local delta = Vector2.new(targetScreen.X, targetScreen.Y) - screenCenter
			local midpoint = screenCenter + delta / 2
			State.targetLine.Size = UDim2.fromOffset(delta.Magnitude, 2)
			State.targetLine.Position = UDim2.fromOffset(midpoint.X, midpoint.Y)
			State.targetLine.Rotation = math.deg(math.atan2(delta.Y, delta.X))
			State.targetDot.Position = UDim2.fromOffset(targetScreen.X, targetScreen.Y)
		end
	end

	if State.predictionDot then
		local showMarker = config.predictionMarker and predictionScreen ~= nil and predictionScreen.Z > 0
		State.predictionDot.Visible = showMarker

		if showMarker then
			State.predictionDot.Position = UDim2.fromOffset(predictionScreen.X, predictionScreen.Y)
		end
	end

	for _, esp in State.esp do
		esp:update()
	end

	for _, gradient in State.spinners do
		gradient.Rotation = (gradient.Rotation + deltaTime * 60) % 360
	end

	for _, pulse in State.pulses do
		pulse.scale.Scale = 1 + math.sin(now * pulse.speed) * pulse.amount
	end

	local scrollingEnabled = not (State.sliderActive or State.scrollTaken)

	for _, page in State.pageFrames do
		if page.ScrollingEnabled ~= scrollingEnabled then
			page.ScrollingEnabled = scrollingEnabled
		end
	end

	updateHud(deltaTime)
end

