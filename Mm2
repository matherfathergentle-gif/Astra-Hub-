---@param className string
---@return table
local function newDrawing(className)
	if not State.noDrawing then
		local success, drawing = pcall(function()
			return Drawing.new(className)
		end)

		if success and drawing then
			return drawing
		end

		State.noDrawing = true
	end

	return setmetatable({}, {
		__index = function(_, key)
			if key == "Remove" or key == "Destroy" then
				return function() end
			end
		end,
		__newindex = function() end,
	})
end

local PlayerEsp = {}
PlayerEsp.__index = PlayerEsp

