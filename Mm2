---@param spin boolean?
---@return UIGradient
local function registerGradient(gradient, spin)
	gradient.Color = accentSequence()
	table.insert(State.gradients, gradient)

	if spin then
		table.insert(State.spinners, gradient)
	end

	return gradient
end

---@param name string
local function applyTheme(name)
	for _, preset in THEME_PRESETS do
		if preset.name == name then
			THEME.accent = preset.accent
			THEME.accent2 = preset.accent2
			break
		end
	end

	for _, entry in State.accentBound do
		tween(entry.instance, { [entry.property] = THEME.accent }, 0.25)
	end

	for _, gradient in State.gradients do
		gradient.Color = accentSequence()
	end

	refreshAll()
end

local function syncConfig()
	applyTheme(State.config.theme)

	if State.syncInterface then
		State.syncInterface()
	end
end

---@return boolean
local function saveConfig()
	return (pcall(function()
		if not isfolder(CONFIG_FOLDER) then
			makefolder(CONFIG_FOLDER)
		end

		writefile(CONFIG_PATH, httpService:JSONEncode(State.config))
	end))
end

---@param onlyIfAuto boolean?
---@return boolean
local function loadConfig(onlyIfAuto)
	local success, decoded = pcall(function()
		if not isfile(CONFIG_PATH) then
			return nil
		end

		return httpService:JSONDecode(readfile(CONFIG_PATH))
	end)

	if not success or typeof(decoded) ~= "table" then
		return false
	end

	if onlyIfAuto and decoded.autoLoad ~= true then
		return false
	end

	for key, value in decoded do
		if typeof(State.config[key]) == typeof(value) then
			State.config[key] = value
		end
	end

	syncConfig()
	return true
end

local function resetConfig()
	for key, value in DEFAULT_CONFIG do
		State.config[key] = value
	end

	Predictor.reset()
	syncConfig()
end

---@param input InputObject
---@return boolean
local function isPointerInput(input)
	return input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch
end

---@param input InputObject
---@param bind string
---@return boolean
local function matchesBind(input, bind)
	if bind == "None" then
		return false
	end

	if bind == "Mouse2" then
		return input.UserInputType == Enum.UserInputType.MouseButton2
	end

	local keyCode = Enum.KeyCode[bind]
	return keyCode ~= nil and input.KeyCode == keyCode
end

local function installKeybinds()
	State.maid:give(userInputService.InputBegan:Connect(function(input, gameProcessed)
		if gameProcessed then
			return
		end

		local config = State.config

		if matchesBind(input, config.silentKeybind) then
			config.silentAim = not config.silentAim
			refreshAll()
			notify("Silent Aim", config.silentAim and "Enabled" or "Disabled", config.silentAim and "success" or "info")
		elseif matchesBind(input, config.shootKeybind) then
			local ok, reason = Silent.shoot()

			if not ok and reason ~= "Too fast" then
				notify("Shoot", tostring(reason), "error")
			end
		end
	end))
end

local function installBombTapListener()
	State.maid:give(userInputService.InputBegan:Connect(function(input, gameProcessed)
		if gameProcessed or not isPointerInput(input) then
			return
		end

		if State.bombController then
			autoThrowIfHolding(State.bombController, "bombJumpEnabled")
		end

		if State.goldBombController then
			autoThrowIfHolding(State.goldBombController, "goldBombJumpEnabled")
		end
	end))
