	local DOCK_ICON_SIZE = IS_TOUCH and 48 or 40
	local DOCK_GAP = 8
	local DOCK_PADDING = 8

	local dock = create("Frame", {
		Position = UDim2.new(0, 14, 0.4, launcherSize + 14),
		Size = UDim2.fromOffset(DOCK_ICON_SIZE + DOCK_PADDING * 2, DOCK_ICON_SIZE + DOCK_PADDING * 2),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundColor3 = THEME.card,
		BackgroundTransparency = 0.05,
		BorderSizePixel = 0,
		Active = true,
	}, screenGui)

	create("UICorner", { CornerRadius = UDim.new(1, 0) }, dock)
	create("UIStroke", { Color = THEME.stroke, Thickness = 1 }, dock)

	create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		Padding = UDim.new(0, DOCK_GAP),
		SortOrder = Enum.SortOrder.LayoutOrder,
	}, dock)

	create("UIPadding", {
		PaddingLeft = UDim.new(0, DOCK_PADDING),
		PaddingRight = UDim.new(0, DOCK_PADDING),
		PaddingTop = UDim.new(0, DOCK_PADDING),
		PaddingBottom = UDim.new(0, DOCK_PADDING),
	}, dock)

	-- Dragging grabs the dock itself; each icon below still gets its own click since Roblox routes
	-- input to the topmost object under the pointer, and the icons sit on top of this frame.
	makeDraggable(dock, dock, nil)

	---@param text string
	---@param order number
	---@param visible boolean
	---@param onTap function
	---@return TextButton
	local function addDockIcon(text, order, visible, onTap)
		local button = create("TextButton", {
			Size = UDim2.fromOffset(DOCK_ICON_SIZE, DOCK_ICON_SIZE),
			BackgroundColor3 = THEME.element,
			BorderSizePixel = 0,
			AutoButtonColor = false,
			Font = Enum.Font.GothamBlack,
			TextSize = 10,
			TextColor3 = THEME.text,
			Text = text,
			TextWrapped = true,
			Visible = visible,
			LayoutOrder = order,
		}, dock)

		create("UICorner", { CornerRadius = UDim.new(1, 0) }, button)

		local stroke = create("UIStroke", { Color = Color3.new(1, 1, 1), Thickness = 2 }, button)
		registerGradient(create("UIGradient", {}, stroke), true)

		State.maid:give(button.MouseButton1Click:Connect(function()
			if isScrolling() then
				return
			end

			onTap()
		end))

		return button
	end

	---@param button TextButton
	---@param ok boolean
	local function flashQuickButton(button, ok)
		tween(button, { BackgroundColor3 = ok and THEME.success or THEME.danger }, 0.12)

		task.delay(0.35, function()
			if not State.detached then
				tween(button, { BackgroundColor3 = THEME.element }, 0.25)
			end
		end)
	end

	State.silentButton = addDockIcon("SILENT", 1, State.config.showSilentButton, function()
		State.config.silentAim = not State.config.silentAim
		refreshAll()
		notify("Silent Aim", State.config.silentAim and "Enabled" or "Disabled", State.config.silentAim and "success" or "info")
	end)

	State.shootButton = addDockIcon("SHOOT", 2, State.config.showShootButton, function()
		task.spawn(function()
			local ok, reason = Silent.shoot()
			flashQuickButton(State.shootButton, ok)

			if not ok and reason ~= "Too fast" then
				notify("Shoot", tostring(reason), "error")
			end
		end)
	end)

	State.bombQuickButton = addDockIcon("BOMB", 3, State.config.showBombButton, function()
		task.spawn(function()
			local ok = State.bombController and State.bombController.throw()
			flashQuickButton(State.bombQuickButton, ok)

			if not ok then
				notify("Bomb Jump", "No FakeBomb found and could not fetch one.", "error")
			end
		end)
	end)

	State.goldQuickButton = addDockIcon("GOLD", 4, State.config.showGoldButton, function()
		task.spawn(function()
			local ok = State.goldBombController and State.goldBombController.throw()
			flashQuickButton(State.goldQuickButton, ok)

			if not ok then
				notify("Gold Bomb Jump", "No GoldBomb found and could not fetch one.", "error")
			end
		end)
	end)

	if State.bombController then
		State.bombController.button = State.bombQuickButton
	end

	if State.goldBombController then
		State.goldBombController.button = State.goldQuickButton
	end

	-- Assigns the real body now that the dock and icons exist; the toggles above already hold
	-- this as an upvalue and only call it later, once the user actually taps one of them.
	updateDockVisible = function()
		dock.Visible = State.config.showSilentButton
			or State.config.showShootButton
			or State.config.showBombButton
			or State.config.showGoldButton

		task.defer(function()
			if not State.detached then
				keepOnScreen(dock)
			end
		end)
	end

	updateDockVisible()

	task.defer(function()
		if not State.detached then
			keepOnScreen(launcher)
		end
	end)

	local function refreshSilentButton()
		local enabled = State.config.silentAim
		tween(State.silentButton, { BackgroundColor3 = enabled and THEME.success or THEME.element }, 0.2)
		State.silentButton.Text = enabled and "ON" or "SILENT"
	end

	table.insert(State.refreshers, refreshSilentButton)
	refreshSilentButton()

	local function applyResponsive()
		local camera = workspace.CurrentCamera

		if not camera then
			return
		end

		local viewport = camera.ViewportSize
		local scale = State.config.uiScale / 100
		local width = math.clamp(viewport.X * 0.85 / scale, 320, 620)
		local height = math.clamp(viewport.Y * 0.85 / scale, 260, 440)
		local compact = width < 520
		local sidebarWidth = compact and 92 or 132

		scaler.Size = UDim2.fromOffset(width, height)
		window.Size = UDim2.fromOffset(width * scale, height * scale)
		sidebar.Size = UDim2.new(0, sidebarWidth, 1, -(HEADER_HEIGHT + 1))
		divider.Position = UDim2.fromOffset(sidebarWidth, HEADER_HEIGHT + 1)
		content.Position = UDim2.fromOffset(sidebarWidth + 1, HEADER_HEIGHT + 1)
		content.Size = UDim2.new(1, -(sidebarWidth + 1), 1, -(HEADER_HEIGHT + 1))
		subtitleChip.Visible = not compact
		State.roleChip.Visible = not compact
		profileTexts.Visible = not compact
		keepOnScreen(dock)
	end

	State.syncInterface = function()
		windowScale.Scale = State.config.uiScale / 100
		launcher.Visible = State.config.launcher
		applyResponsive()
	end

	local camera = workspace.CurrentCamera

	if camera then
		State.maid:give(camera:GetPropertyChangedSignal("ViewportSize"):Connect(applyResponsive))
	end

	State.maid:give(closeButton.MouseButton1Click:Connect(function()
		setMenuVisible(false)
		notify("Menu hidden", IS_TOUCH and "Tap the logo button to reopen." or "Press RightShift or Insert to reopen.", "info")
	end))

	State.maid:give(userInputService.InputBegan:Connect(function(input, gameProcessed)
		if gameProcessed or not MENU_TOGGLE_KEYS[input.KeyCode] then
			return
		end

		setMenuVisible(not State.menuVisible)
	end))

	applyResponsive()

	local autoLoaded = loadConfig(true)

	local function openMenu()
		setMenuVisible(true)
		notify("Astra Hub", "Loaded successfully.", "success")

		if autoLoaded then
			notify("Config", "Auto-loaded your saved config.", "info")
		end
	end

	local introStarted = State.config.intro and pcall(playIntro, screenGui, openMenu)

	if not introStarted then
		if State.introOverlay then
			State.introOverlay:Destroy()
			State.introOverlay = nil
		end

		openMenu()
	end
end

