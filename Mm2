---@param remote RemoteFunction
---@param timeoutSeconds number
local function invokeServerWithTimeout(remote, timeoutSeconds, ...)
	local args = table.pack(...)
	local finished = false
	local bindable = Instance.new("BindableEvent")

	task.spawn(function()
		pcall(function()
			remote:InvokeServer(table.unpack(args, 1, args.n))
		end)

		if not finished then
			finished = true
			bindable:Fire()
		end
	end)

	task.delay(timeoutSeconds, function()
		if not finished then
			finished = true
			bindable:Fire()
		end
	end)

	bindable.Event:Wait()
	bindable:Destroy()
end

---@return RemoteFunction?
local function findReplicateToyRemote()
	local remotes = replicatedStorage:FindFirstChild("Remotes")
	local extras = remotes and remotes:FindFirstChild("Extras")
	return extras and extras:FindFirstChild("ReplicateToy")
end

---@param toyName string
---@param cooldownKey string
---@return table
local function createBombController(toyName, cooldownKey)
	local controller = {
		toyName = toyName,
		onCooldown = false,
		debounce = false,
		justRespawned = true,
		button = nil,
		defaultLabel = toyName == GOLD_BOMB_NAME and "GOLD" or "BOMB",
	}

	local function resetCooldown()
		controller.onCooldown = false

		if controller.button then
			controller.button.Text = controller.defaultLabel
		end
	end

	local function startCooldown()
		controller.onCooldown = true
		controller.debounce = false

		local duration = math.floor(State.config[cooldownKey])

		task.spawn(function()
			for seconds = duration, 1, -1 do
				if State.detached or not controller.onCooldown then
					return
				end

				if controller.button then
					controller.button.Text = tostring(seconds)
				end

				task.wait(1)
			end

			if not State.detached and controller.onCooldown then
				resetCooldown()
			end
		end)
	end

	function controller.isHolding()
		local character = localPlayer.Character
		return character ~= nil and character:FindFirstChild(toyName) ~= nil
	end

	local function getToy()
		local character = localPlayer.Character

		if not character then
			return nil
		end

		local tool = character:FindFirstChild(toyName)

		if tool then
			return tool
		end

		local backpack = localPlayer:FindFirstChildOfClass("Backpack")

		if backpack then
			tool = backpack:FindFirstChild(toyName)

			if tool then
				tool.Parent = character
				return tool
			end
		end

		local replicateToy = findReplicateToyRemote()

		if not replicateToy then
			return nil
		end

		invokeServerWithTimeout(replicateToy, 3, toyName)

		for _ = 1, BOMB_FETCH_ATTEMPTS do
			tool = character:FindFirstChild(toyName)

			if tool then
				return tool
			end

			if backpack then
				tool = backpack:FindFirstChild(toyName)

				if tool then
					tool.Parent = character
					return tool
				end
			end

			task.wait(0.05)
		end

		return nil
	end

	local function unequip()
		task.delay(BOMB_UNEQUIP_DELAY, function()
			if State.detached then
				return
			end

			local character = localPlayer.Character
			local tool = character and character:FindFirstChild(toyName)

			if tool then
				tool.Parent = localPlayer:FindFirstChildOfClass("Backpack") or character
			end
		end)
	end

	function controller.throw()
		if State.detached or controller.onCooldown or controller.debounce or controller.justRespawned then
			return false
		end

		controller.debounce = true

		task.delay(BOMB_DEBOUNCE, function()
			controller.debounce = false
		end)

		local tool = getToy()

		if not tool then
			return false
		end

		local character = localPlayer.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		local hrp = character and character:FindFirstChild("HumanoidRootPart")
		local camera = workspace.CurrentCamera

		if not (humanoid and hrp and camera) then
			return false
		end

		local position = hrp.Position + camera.CFrame.LookVector * BOMB_THROW_DISTANCE
		local remote = tool:FindFirstChild("Remote")

		if remote then
			pcall(function()
				remote:FireServer(CFrame.new(position), 50)
			end)
		end

		pcall(function()
			humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
		end)

		unequip()
		task.delay(0.1, startCooldown)
		return true
	end

	State.maid:give(localPlayer.CharacterAdded:Connect(function()
		resetCooldown()
		controller.justRespawned = true

		task.delay(1, function()
			if not State.detached then
				controller.justRespawned = false
			end
		end)
	end))

	return controller
end

---@param controller table
---@param enabledKey string
