---@param gui GuiObject
---@param input InputObject
local function playRipple(gui, input)
	if State.detached then
		return
	end

	local scale = State.config.uiScale / 100
	local size = gui.AbsoluteSize / scale
	local x = math.clamp((input.Position.X - gui.AbsolutePosition.X) / scale, 0, size.X)
	local diameter = math.max(size.X, size.Y) * 1.6

	local ripple = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0, x, 0.5, 0),
		Size = UDim2.fromOffset(0, 0),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 0.82,
		BorderSizePixel = 0,
		ZIndex = 5,
	}, gui)

	create("UICorner", { CornerRadius = UDim.new(1, 0) }, ripple)
	tween(ripple, { Size = UDim2.fromOffset(diameter, diameter), BackgroundTransparency = 1 }, 0.5)

	task.delay(0.55, function()
		ripple:Destroy()
	end)
end

