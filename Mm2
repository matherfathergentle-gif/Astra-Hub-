-- Tracks connections, instances and callbacks for one-call cleanup.
local Maid = {}
Maid.__index = Maid

---Create a new Maid.
function Maid.new()
	return setmetatable({ items = {} }, Maid)
end

---Track an item for cleanup.
---@param item any
---@return any
function Maid:give(item)
	table.insert(self.items, item)
	return item
end

---Clean every tracked item. A failing item never blocks the others.
function Maid:clean()
	local items = self.items
	self.items = {}

	for _, item in items do
		pcall(function()
			local itemType = typeof(item)

			if itemType == "RBXScriptConnection" then
				item:Disconnect()
			elseif itemType == "Instance" then
				item:Destroy()
			elseif itemType == "function" then
				item()
			end
		end)
	end
end

