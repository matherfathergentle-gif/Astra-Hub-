---@param character Model
---@param color Color3
function PlayerEsp:updateChams(character, color)
	if not ((State.config.espChams or State.noDrawing) and State.guiParent) then
		if self.highlight then
			self.highlight.Enabled = false
		end

		return
	end

	local highlight = self.highlight

	if not highlight then
		highlight = Instance.new("Highlight")
		highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		highlight.FillTransparency = 0.65
		highlight.OutlineTransparency = 0
		highlight.OutlineColor = Color3.new(1, 1, 1)
		highlight.Parent = State.guiParent
		self.highlight = highlight
	end

	highlight.Adornee = character
	highlight.FillColor = color
	highlight.Enabled = true
end

---@param character Model
---@param text string
function PlayerEsp:updateTag(character, text)
	local head = character:FindFirstChild("Head")

	if not (head and State.guiParent and text ~= "") then
		if self.tag then
			self.tag.Enabled = false
		end

		return
	end

	local tag = self.tag

	if not tag then
		tag = Instance.new("BillboardGui")
		tag.AlwaysOnTop = true
		tag.Size = UDim2.fromOffset(240, 22)
		tag.StudsOffset = Vector3.new(0, 2.6, 0)
		tag.Parent = State.guiParent

		local label = Instance.new("TextLabel")
		label.Name = "Label"
		label.Size = UDim2.fromScale(1, 1)
		label.BackgroundTransparency = 1
		label.Font = Enum.Font.GothamBold
		label.TextSize = 13
		label.TextColor3 = Color3.new(1, 1, 1)
		label.TextStrokeTransparency = 0
		label.Parent = tag
		self.tag = tag
	end

	tag.Adornee = head
	tag.Enabled = true
	tag.Label.Text = text
end

function PlayerEsp:update()
	local config = State.config
	local camera = workspace.CurrentCamera
	local character = self.player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local hrp = character and character:FindFirstChild("HumanoidRootPart")

	if not (config.espEnabled and camera and humanoid and hrp and humanoid.Health > 0) then
		return self:hide()
	end

	local distance = (camera.CFrame.Position - hrp.Position).Magnitude

	if distance > config.espMaxDistance then
		return self:hide()
	end

	local role = Roles.of(self.player)
	local color = ROLE_COLORS[role] or Color3.fromRGB(220, 220, 220)
	self:updateChams(character, color)

	local parts = {}

	if config.espNames then
		table.insert(parts, self.player.Name)
	end

	if config.espRoles then
		table.insert(parts, "[" .. role .. "]")
	end

	if config.espWeapon then
		if hasPlayerWeapon(self.player, "Knife") then
			table.insert(parts, "(Knife)")
		elseif hasPlayerWeapon(self.player, "Gun") then
			table.insert(parts, "(Gun)")
		end
	end

	if config.espDistance then
		table.insert(parts, "[" .. math.floor(distance) .. "m]")
	end

	local labelText = table.concat(parts, " ")

	if State.noDrawing then
		return self:updateTag(character, labelText)
	end

	-- Drawing objects use viewport coordinates.
	local rootPosition, onScreen = camera:WorldToViewportPoint(hrp.Position)

	if not onScreen then
		return self:hideDrawings()
	end

	local topPosition = camera:WorldToViewportPoint(hrp.Position + Vector3.new(0, 3, 0))
	local bottomPosition = camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3.5, 0))
	local height = math.abs(bottomPosition.Y - topPosition.Y)
	local width = height * 0.6

	self.box.Visible = config.espBoxes
	self.box.Color = color
	self.box.Size = Vector2.new(width, height)
	self.box.Position = Vector2.new(rootPosition.X - width / 2, topPosition.Y)

	self.label.Visible = labelText ~= ""
	self.label.Text = labelText
	self.label.Position = Vector2.new(rootPosition.X, topPosition.Y - 16)

	local ratio = math.clamp(humanoid.Health / humanoid.MaxHealth, 0, 1)
	local barX = rootPosition.X - width / 2 - 5

	self.healthBar.Visible = config.espHealth
	self.healthBar.Color = Color3.fromRGB(255, 0, 0):Lerp(Color3.fromRGB(0, 255, 0), ratio)
	self.healthBar.From = Vector2.new(barX, topPosition.Y + height)
	self.healthBar.To = Vector2.new(barX, topPosition.Y + height - height * ratio)

	self.tracer.Visible = config.espTracers
	self.tracer.Color = color
	self.tracer.From = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y)
	self.tracer.To = Vector2.new(rootPosition.X, topPosition.Y + height)
end

function PlayerEsp:destroy()
	self.box:Remove()
	self.label:Remove()
	self.healthBar:Remove()
	self.tracer:Remove()

	if self.highlight then
		self.highlight:Destroy()
		self.highlight = nil
	end

	if self.tag then
		self.tag:Destroy()
		self.tag = nil
	end
end

