	local function selectTab(name)
		State.currentTab = name

		for tabName, page in pages do
			local active = tabName == name

			if active and not page.Visible then
				page.Visible = true
				page.Position = UDim2.fromOffset(18, 0)
				tween(page, { Position = UDim2.fromOffset(0, 0) }, 0.28, Enum.EasingStyle.Quint)
			elseif not active then
				page.Visible = false
			end

			tween(tabButtons[tabName], { TextColor3 = active and THEME.text or THEME.subText })
		end

		local index = table.find(tabOrder, name) or 1
		tween(pill, { Position = UDim2.fromOffset(8, TAB_PAD + (index - 1) * (TAB_HEIGHT + TAB_GAP)) }, 0.28, Enum.EasingStyle.Quint)
	end

