--========================== SMALL HELPERS ===============================
local function notify(player, text, kind)
	if player and player.Parent then
		R.Notify:FireClient(player, text, kind or "info")
	end
end

local function announce(title, sub)
	R.Announce:FireAllClients(title, sub or "")
end

local function boostActive(player, attr)
	local t = player:GetAttribute(attr)
	return t ~= nil and t > Workspace:GetServerTimeNow()
end

local function getHumanoid(player)
	local c = player.Character
	return c and c:FindFirstChildOfClass("Humanoid")
end

local function isAlive(player)
	local h = getHumanoid(player)
	return h ~= nil and h.Health > 0
end

local function playingCount()
	local n = 0
	for _, p in ipairs(Players:GetPlayers()) do
		if p:GetAttribute("Playing") then n = n + 1 end
	end
	return n
end

local function alivePlayers()
	local n = 0
	for _, p in ipairs(Players:GetPlayers()) do
		if p:GetAttribute("Playing") and isAlive(p) then n = n + 1 end
	end
	return n
end

local function clampLevel(v)
	return math.clamp(math.floor(tonumber(v) or 0), 0, MAX_LEVEL)
end

--========================== PLAYER DATA =================================
local function newData()
	return {
		Coins = CFG.START_COINS, Owned = { Pistol = true }, Upgrades = {},
		Best = 0, Medkits = 0, Kills = 0, Loaded = false, Dirty = false,
	}
end

local function syncStats(player)
	local d = Data[player]
	if not d then return end
	local ls = player:FindFirstChild("leaderstats")
	if ls then
		ls.Coins.Value = d.Coins
		ls.Kills.Value = d.Kills
		ls.BestWave.Value = d.Best
	end
	player:SetAttribute("Medkits", d.Medkits)
end

local function addCoins(player, n)
	local d = Data[player]
	if not d then return end
	d.Coins = d.Coins + n
	d.Dirty = true
	syncStats(player)
end

local store = nil
if CFG.SAVE_DATA then
	local ok = pcall(function() store = DataStoreService:GetDataStore("ZombieAssault_v1") end)
	if not ok then store = nil end
end

local function loadData(player)
	local d = Data[player]
	if not d or not store then return end
	local ok, saved = false, nil
	for _ = 1, 3 do
		ok, saved = pcall(function() return store:GetAsync("P_" .. player.UserId) end)
		if ok then break end
		task.wait(1)
	end
	if not ok then
		warn("[ZombieServer] Could not load save data (is 'Enable Studio Access to API Services' on?). Using fresh data.")
		return
	end
	if type(saved) ~= "table" then return end
	if type(saved.Coins) == "number" then d.Coins = math.max(0, math.floor(saved.Coins)) end
	if type(saved.Best) == "number" then d.Best = math.max(0, math.floor(saved.Best)) end
	if type(saved.Medkits) == "number" then d.Medkits = math.clamp(math.floor(saved.Medkits), 0, CFG.MEDKIT_MAX) end
	if type(saved.Owned) == "table" then
		for name, v in pairs(saved.Owned) do
			if WEAPONS[name] and v == true then d.Owned[name] = true end
		end
	end
	if type(saved.Upgrades) == "table" then
		for wname, ups in pairs(saved.Upgrades) do
			if WEAPONS[wname] and type(ups) == "table" then
				d.Upgrades[wname] = { Damage = clampLevel(ups.Damage), Mag = clampLevel(ups.Mag), Reload = clampLevel(ups.Reload) }
			end
		end
	end
end

local function saveData(player)
	local d = Data[player]
	if not store or not d or not d.Loaded or not d.Dirty then return end
	d.Dirty = false
	local payload = { Coins = d.Coins, Best = d.Best, Medkits = d.Medkits, Owned = d.Owned, Upgrades = d.Upgrades }
	local ok, err = pcall(function() store:SetAsync("P_" .. player.UserId, payload) end)
	if not ok then
		d.Dirty = true
		if not d.saveWarned then
			d.saveWarned = true
			warn("[ZombieServer] Save failed (progress still works this session): " .. tostring(err))
		end
	end
end

--========================== MAP =========================================
local function mk(parent, name, size, cf, color, material)
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.CFrame = cf
	p.Anchored = true
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.CastShadow = false
	p.Parent = parent
	return p
end

local beaconLights = {}

local function buildMap()
	local rng = Random.new(1337)
	local H = CFG.ARENA / 2 -- 150
	local M = MapFolder
	local blocked = {} -- circles where random props may NOT be placed

	local function block(x, z, r)
		table.insert(blocked, { x = x, z = z, r = r })
	end

	-- ground -------------------------------------------------------------
	mk(M, "OuterVoid", Vector3.new(1600, 2, 1600), CFrame.new(0, -2.5, 0), Color3.fromRGB(12, 12, 14))
	mk(M, "Ground", Vector3.new(H * 2 + 16, 2, H * 2 + 16), CFrame.new(0, -1, 0), Color3.fromRGB(46, 44, 38), Enum.Material.Ground)

	-- perimeter wall (tall, so nobody walks or falls out)
	local wallColor = Color3.fromRGB(38, 38, 42)
	mk(M, "WallN", Vector3.new(H * 2 + 12, 28, 4), CFrame.new(0, 14, -(H + 2)), wallColor, Enum.Material.Concrete)
	mk(M, "WallS", Vector3.new(H * 2 + 12, 28, 4), CFrame.new(0, 14, (H + 2)), wallColor, Enum.Material.Concrete)
	mk(M, "WallW", Vector3.new(4, 28, H * 2 + 12), CFrame.new(-(H + 2), 14, 0), wallColor, Enum.Material.Concrete)
	mk(M, "WallE", Vector3.new(4, 28, H * 2 + 12), CFrame.new((H + 2), 14, 0), wallColor, Enum.Material.Concrete)

	-- roads ----------------------------------------------------------------
	local asphalt = Color3.fromRGB(30, 30, 34)
	mk(M, "RoadNS", Vector3.new(26, 0.2, H * 2), CFrame.new(0, 0.1, 0), asphalt, Enum.Material.Asphalt)
	mk(M, "RoadEW", Vector3.new(H * 2, 0.22, 26), CFrame.new(0, 0.11, 0), asphalt, Enum.Material.Asphalt)
	local yellow = Color3.fromRGB(200, 170, 50)
	for z = -H + 12, H - 12, 14 do
		if math.abs(z) > 32 then
			mk(M, "Dash", Vector3.new(0.6, 0.05, 6), CFrame.new(0, 0.26, z), yellow)
		end
	end
	for x = -H + 12, H - 12, 14 do
		if math.abs(x) > 32 then
			mk(M, "Dash", Vector3.new(6, 0.05, 0.6), CFrame.new(x, 0.26, 0), yellow)
		end
	end

	-- SAFE PLAZA + PLAYER SPAWNS (wide open, nothing to get stuck on) ------
	local plaza = mk(M, "Plaza", Vector3.new(0.5, 52, 52), CFrame.new(0, 0.25, 0) * CFrame.Angles(0, 0, math.rad(90)), Color3.fromRGB(85, 85, 90), Enum.Material.Concrete)
	plaza.Shape = Enum.PartType.Cylinder
	block(0, 0, 34)

	local spawnOffsets = { Vector3.new(11, 0, 11), Vector3.new(-11, 0, 11), Vector3.new(11, 0, -11), Vector3.new(-11, 0, -11) }
	for i, off in ipairs(spawnOffsets) do
		local sp = Instance.new("SpawnLocation")
		sp.Name = "PlayerSpawn" .. i
		sp.Size = Vector3.new(6, 0.4, 6)
		sp.Position = Vector3.new(off.X, 0.7, off.Z)
		sp.Anchored = true
		sp.Neutral = true
		sp.Duration = 0
		sp.AllowTeamChangeOnTouch = false
		sp.Color = Color3.fromRGB(40, 120, 60)
		sp.Material = Enum.Material.Neon
		sp.Transparency = 0.5
		sp.TopSurface = Enum.SurfaceType.Smooth
		sp.Parent = M
		for _, c in ipairs(sp:GetChildren()) do
			if c:IsA("Decal") then c:Destroy() end
		end
		table.insert(SpawnPads, sp)
	end

	-- sandbag walls on the diagonals (cardinal directions stay open)
	for _, deg in ipairs({ 45, 135, 225, 315 }) do
		local a = math.rad(deg)
		mk(M, "Sandbags", Vector3.new(12, 2.5, 2.5),
			CFrame.new(math.cos(a) * 21, 1.75, math.sin(a) * 21) * CFrame.Angles(0, -(a + math.pi / 2), 0),
			Color3.fromRGB(120, 105, 75), Enum.Material.Fabric)
	end

	-- lamps ------------------------------------------------------------------
	local function lamp(x, z)
		mk(M, "LampPole", Vector3.new(0.8, 16, 0.8), CFrame.new(x, 8, z), Color3.fromRGB(30, 30, 34), Enum.Material.Metal)
		local bulb = mk(M, "LampBulb", Vector3.new(2, 0.6, 2), CFrame.new(x, 16.2, z), Color3.fromRGB(255, 225, 170), Enum.Material.Neon)
		if CFG.LIGHTS then
			local l = Instance.new("PointLight")
			l.Range = 30
			l.Brightness = 1.2
			l.Color = Color3.fromRGB(255, 215, 150)
			l.Parent = bulb
		end
		block(x, z, 4)
	end
	lamp(19, 19); lamp(-19, 19); lamp(19, -19); lamp(-19, -19)
	lamp(16, -70); lamp(-16, 70); lamp(70, 16); lamp(-70, -16)

	-- ZOMBIE SPAWN ZONES (5, spread around the arena edge) -------------------
	for k = 0, 4 do
		local ang = math.rad(-90 + 72 * k)
		local x, z = math.cos(ang) * 125, math.sin(ang) * 125
		table.insert(ZombieSpawns, Vector3.new(x, 0, z))
		local pad = mk(M, "ZombiePad" .. (k + 1), Vector3.new(0.3, 24, 24), CFrame.new(x, 0.3, z) * CFrame.Angles(0, 0, math.rad(90)), Color3.fromRGB(85, 14, 14), Enum.Material.Slate)
		pad.Shape = Enum.PartType.Cylinder
		mk(M, "BeaconPole", Vector3.new(1, 16, 1), CFrame.new(x, 8, z), Color3.fromRGB(25, 25, 28), Enum.Material.Metal)
		local top = mk(M, "BeaconLight", Vector3.new(2.4, 2.4, 2.4), CFrame.new(x, 17, z), Color3.fromRGB(255, 30, 30), Enum.Material.Neon)
		if CFG.LIGHTS then
			local l = Instance.new("PointLight")
			l.Range = 34
			l.Brightness = 2
			l.Color = Color3.fromRGB(255, 40, 40)
			l.Parent = top
			table.insert(beaconLights, l)
		end
		block(x, z, 26)
	end

	-- RUINED BUILDINGS (always have doors / broken gaps - never a trap) -----
	local function building(cx, cz, w, d, h)
		mk(M, "Floor", Vector3.new(w, 0.6, d), CFrame.new(cx, 0.3, cz), Color3.fromRGB(55, 55, 58), Enum.Material.Concrete)
		local sides = {
			{ axis = "x", fixed = cz - d / 2, from = cx - w / 2, to = cx + w / 2 },
			{ axis = "x", fixed = cz + d / 2, from = cx - w / 2, to = cx + w / 2 },
			{ axis = "z", fixed = cx - w / 2, from = cz - d / 2, to = cz + d / 2 },
			{ axis = "z", fixed = cx + w / 2, from = cz - d / 2, to = cz + d / 2 },
		}
		local tones = { Color3.fromRGB(92, 82, 74), Color3.fromRGB(78, 74, 72), Color3.fromRGB(100, 88, 78) }
		for _, s in ipairs(sides) do
			local len = s.to - s.from
			local gapC = s.from + len * (0.3 + rng:NextNumber() * 0.4)
			local gapW = 11
			local pos = s.from
			while pos < s.to - 0.5 do
				local chunk = math.min(rng:NextNumber(4, 8), s.to - pos)
				local mid = pos + chunk / 2
				local touchesGap = (pos < gapC + gapW / 2) and (pos + chunk > gapC - gapW / 2)
				if (not touchesGap) and rng:NextNumber() > 0.12 then
					local ch = rng:NextNumber(5, h)
					local tone = tones[rng:NextInteger(1, #tones)]
					if s.axis == "x" then
						mk(M, "Wall", Vector3.new(chunk, ch, 1.5), CFrame.new(mid, ch / 2, s.fixed), tone, Enum.Material.Brick)
					else
						mk(M, "Wall", Vector3.new(1.5, ch, chunk), CFrame.new(s.fixed, ch / 2, mid), tone, Enum.Material.Brick)
					end
				end
				pos = pos + chunk
			end
		end
		-- a couple of crates inside for cover
		mk(M, "Crate", Vector3.new(3.5, 3.5, 3.5), CFrame.new(cx + w / 4, 1.75, cz - d / 5) * CFrame.Angles(0, rng:NextNumber(0, 3), 0), Color3.fromRGB(120, 85, 50), Enum.Material.WoodPlanks)
		block(cx, cz, math.sqrt(w * w + d * d) / 2 + 4)
	end
	building(-55, -70, 30, 26, 14)
	building(55, -70, 28, 28, 12)
	building(-50, 52, 32, 30, 15)
	building(50, 50, 36, 26, 13)
	building(-102, 40, 26, 34, 12)
	building(100, 32, 26, 30, 14)

	-- RANDOM PROPS (cover) ---------------------------------------------------
	local function freeSpot(minR)
		for _ = 1, 40 do
			local x = rng:NextNumber(-H + 14, H - 14)
			local z = rng:NextNumber(-H + 14, H - 14)
			local ok = true
			for _, b in ipairs(blocked) do
				local dx, dz = x - b.x, z - b.z
				local lim = b.r + minR
				if dx * dx + dz * dz < lim * lim then ok = false break end
			end
			if ok then
				block(x, z, minR)
				return x, z
			end
		end
		return nil, nil
	end

	for _ = 1, 14 do -- concrete barriers
		local x, z = freeSpot(6)
		if x then
			mk(M, "Barrier", Vector3.new(8, 3, 2.2), CFrame.new(x, 1.5, z) * CFrame.Angles(0, rng:NextNumber(0, math.pi), 0), Color3.fromRGB(105, 105, 108), Enum.Material.Concrete)
		end
	end

	local carColors = { Color3.fromRGB(110, 40, 35), Color3.fromRGB(45, 60, 90), Color3.fromRGB(80, 80, 82), Color3.fromRGB(95, 85, 40) }
	for _ = 1, 8 do -- wrecked cars
		local x, z = freeSpot(10)
		if x then
			local base = CFrame.new(x, 0, z) * CFrame.Angles(0, rng:NextNumber(0, math.pi), 0)
			local col = carColors[rng:NextInteger(1, #carColors)]
			mk(M, "CarBody", Vector3.new(6.5, 2.2, 13), base * CFrame.new(0, 2.2, 0), col, Enum.Material.Metal)
			mk(M, "CarCabin", Vector3.new(5.6, 1.8, 6), base * CFrame.new(0, 4.2, 0.5), Color3.fromRGB(28, 32, 38), Enum.Material.Glass)
			for _, wx in ipairs({ -3.3, 3.3 }) do
				for _, wz in ipairs({ -4, 4 }) do
					local wheel = mk(M, "Wheel", Vector3.new(1.2, 2.4, 2.4), base * CFrame.new(wx, 1.2, wz), Color3.fromRGB(15, 15, 15), Enum.Material.SmoothPlastic)
					wheel.Shape = Enum.PartType.Cylinder
				end
			end
		end
	end

	for _ = 1, 8 do -- crate piles
		local x, z = freeSpot(7)
		if x then
			local yaw = rng:NextNumber(0, math.pi)
			local base = CFrame.new(x, 0, z) * CFrame.Angles(0, yaw, 0)
			mk(M, "Crate", Vector3.new(4, 4, 4), base * CFrame.new(0, 2, 0), Color3.fromRGB(120, 85, 50), Enum.Material.WoodPlanks)
			mk(M, "Crate", Vector3.new(4, 4, 4), base * CFrame.new(4.2, 2, 0.4), Color3.fromRGB(105, 75, 45), Enum.Material.WoodPlanks)
			if rng:NextNumber() > 0.5 then
				mk(M, "Crate", Vector3.new(4, 4, 4), base * CFrame.new(2, 6, 0.2), Color3.fromRGB(130, 92, 55), Enum.Material.WoodPlanks)
			end
		end
	end

	for _ = 1, 4 do -- dumpsters
		local x, z = freeSpot(6)
		if x then
			mk(M, "Dumpster", Vector3.new(6, 4, 3.5), CFrame.new(x, 2, z) * CFrame.Angles(0, rng:NextNumber(0, math.pi), 0), Color3.fromRGB(30, 70, 45), Enum.Material.Metal)
		end
	end

	for _ = 1, 10 do -- dead trees
		local x, z = freeSpot(5)
		if x then
			mk(M, "TreeTrunk", Vector3.new(1.4, 12, 1.4), CFrame.new(x, 6, z), Color3.fromRGB(45, 32, 24), Enum.Material.Wood)
			for _ = 1, 2 do
				mk(M, "TreeBranch", Vector3.new(0.6, 0.6, 5),
					CFrame.new(x, 9 + rng:NextNumber(-1, 1.5), z) * CFrame.Angles(rng:NextNumber(-0.6, 0.6), rng:NextNumber(0, 6.28), 0) * CFrame.new(0, 0, -2),
					Color3.fromRGB(45, 32, 24), Enum.Material.Wood)
			end
		end
	end

	-- warning-light flicker (cheap: 5 lights, updated a few times per second)
	if #beaconLights > 0 then
		task.spawn(function()
			while true do
				local t = os.clock()
				for i, l in ipairs(beaconLights) do
					if l.Parent then
						l.Brightness = 0.8 + math.abs(math.sin(t * 2.2 + i)) * 2.2
					end
				end
				task.wait(0.15)
			end
		end)
	end
end

