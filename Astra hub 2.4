---@param input InputObject
---@return boolean
local function isPointerInput(input)
	return input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch
end

---@param input InputObject
---@param bind string
---@return boolean
local function matchesBind(input, bind)
	if bind == "None" then
		return false
	end

	if bind == "Mouse2" then
		return input.UserInputType == Enum.UserInputType.MouseButton2
	end

	local keyCode = Enum.KeyCode[bind]
	return keyCode ~= nil and input.KeyCode == keyCode
end

local function installKeybinds()
	State.maid:give(userInputService.InputBegan:Connect(function(input, gameProcessed)
		if gameProcessed then
			return
		end

		local config = State.config

		if matchesBind(input, config.silentKeybind) then
			config.silentAim = not config.silentAim
			refreshAll()
			notify("Silent Aim", config.silentAim and "Enabled" or "Disabled", config.silentAim and "success" or "info")
		elseif matchesBind(input, config.shootKeybind) then
			local ok, reason = Silent.shoot()

			if not ok and reason ~= "Too fast" then
				notify("Shoot", tostring(reason), "error")
			end
		elseif matchesBind(input, config.gunKeybind) then
			task.spawn(function()
				local ok, reason = GunGrab.run()
				notify("Get Gun", ok and "Picked up the gun" or tostring(reason), ok and "success" or "error")
			end)
		end
	end))
end

local function installBombTapListener()
	State.maid:give(userInputService.InputBegan:Connect(function(input, gameProcessed)
		if gameProcessed or not isPointerInput(input) then
			return
		end

		if State.bombController then
			autoThrowIfHolding(State.bombController, "bombJumpEnabled")
		end

		if State.goldBombController then
			autoThrowIfHolding(State.goldBombController, "goldBombJumpEnabled")
		end
	end))
end

---@return boolean
local function isScrolling()
	return os.clock() - State.lastScrollTime < 0.2
end

---@param frame GuiObject
local function keepOnScreen(frame)
	local camera = workspace.CurrentCamera

	if not camera then
		return
	end

	local viewport = camera.ViewportSize
	local position, size = frame.AbsolutePosition, frame.AbsoluteSize
	local margin = 44
	local shiftX, shiftY = 0, 0

	if position.X + size.X < margin then
		shiftX = margin - (position.X + size.X)
	elseif position.X > viewport.X - margin then
		shiftX = (viewport.X - margin) - position.X
	end

	if position.Y < 0 then
		shiftY = -position.Y
	elseif position.Y > viewport.Y - margin then
		shiftY = (viewport.Y - margin) - position.Y
	end

	if shiftX ~= 0 or shiftY ~= 0 then
		frame.Position = frame.Position + UDim2.fromOffset(shiftX, shiftY)
	end
end

---@param handle GuiObject
---@param frame GuiObject
---@param onClick function?
local function makeDraggable(handle, frame, onClick)
	local dragging, dragInput, dragStart, startPosition, moved = false, nil, nil, nil, false

	State.maid:give(handle.InputBegan:Connect(function(input)
		if not isPointerInput(input) then
			return
		end

		dragging = true
		moved = false
		dragInput = input
		dragStart = input.Position
		startPosition = frame.Position
	end))

	State.maid:give(userInputService.InputChanged:Connect(function(input)
		if not dragging then
			return
		end

		if input ~= dragInput and input.UserInputType ~= Enum.UserInputType.MouseMovement then
			return
		end

		local delta = input.Position - dragStart

		if not moved and delta.Magnitude < DRAG_THRESHOLD then
			return
		end

		moved = true
		frame.Position = UDim2.new(startPosition.X.Scale, startPosition.X.Offset + delta.X, startPosition.Y.Scale, startPosition.Y.Offset + delta.Y)
	end))

	State.maid:give(userInputService.InputEnded:Connect(function(input)
		if not dragging then
			return
		end

		if input ~= dragInput and not isPointerInput(input) then
			return
		end

		dragging = false

		if moved then
			keepOnScreen(frame)
		elseif onClick then
			onClick()
		end
	end))
end

