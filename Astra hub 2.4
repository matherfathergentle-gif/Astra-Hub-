		TextSize = 12,
		TextColor3 = THEME.subText,
		TextXAlignment = Enum.TextXAlignment.Right,
	}, holder)

	local hitbox = create("Frame", {
		Position = UDim2.fromOffset(6, 22),
		Size = UDim2.new(1, -12, 0, IS_TOUCH and 30 or 22),
		BackgroundTransparency = 1,
	}, holder)

	local bar = create("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 0, 0.5, 0),
		Size = UDim2.new(1, 0, 0, 8),
		BackgroundColor3 = THEME.element,
		BorderSizePixel = 0,
	}, hitbox)

	create("UICorner", { CornerRadius = UDim.new(1, 0) }, bar)

	local fill = create("Frame", {
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
	}, bar)

	create("UICorner", { CornerRadius = UDim.new(1, 0) }, fill)
	registerGradient(create("UIGradient", {}, fill))

	local knobSize = IS_TOUCH and 24 or 18

	local knob = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0, 0.5),
		Size = UDim2.fromOffset(knobSize, knobSize),
		BackgroundColor3 = THEME.text,
		BorderSizePixel = 0,
	}, bar)

	create("UICorner", { CornerRadius = UDim.new(1, 0) }, knob)

	local knobStroke = create("UIStroke", { Thickness = 2 }, knob)
	bindAccent(knobStroke, "Color")

	local function refresh()
		local value = State.config[key]
		local alpha = math.clamp((value - minimum) / (maximum - minimum), 0, 1)
		valueLabel.Text = tostring(math.floor(value * 100 + 0.5) / 100) .. (options.suffix or "")
		fill.Size = UDim2.fromScale(alpha, 1)
		knob.Position = UDim2.fromScale(alpha, 0.5)
	end

	local function updateFromInput(input)
		local alpha = math.clamp((input.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
		local value = minimum + (maximum - minimum) * alpha
		State.config[key] = math.floor(math.clamp(math.floor(value / step + 0.5) * step, minimum, maximum) * 100 + 0.5) / 100
		refresh()

		if options.onChange then
			options.onChange(State.config[key])
		end
	end

	local sliding, slideInput = false, nil

	State.maid:give(hitbox.InputBegan:Connect(function(input)
		if not isPointerInput(input) then
			return
		end

		sliding = true
		slideInput = input
		State.sliderActive = true
		setScrollingEnabled(false)
		tween(knob, { Size = UDim2.fromOffset(knobSize + 6, knobSize + 6) }, 0.12, Enum.EasingStyle.Back)
		tween(knobStroke, { Thickness = 4 }, 0.12)
		updateFromInput(input)
	end))

	State.maid:give(userInputService.InputChanged:Connect(function(input)
		if not sliding then
			return
		end

		if input ~= slideInput and input.UserInputType ~= Enum.UserInputType.MouseMovement then
			return
		end

		updateFromInput(input)
	end))

	State.maid:give(userInputService.InputEnded:Connect(function(input)
		if not sliding then
			return
		end

		if input ~= slideInput and not isPointerInput(input) then
			return
		end

		sliding = false
		State.sliderActive = false
		setScrollingEnabled(true)
		tween(knob, { Size = UDim2.fromOffset(knobSize, knobSize) }, 0.15)
		tween(knobStroke, { Thickness = 2 }, 0.15)
	end))

	table.insert(State.refreshers, refresh)
	registerEntry(body, holder, label)
	refresh()
end

---@param body Frame
---@param label string
---@param key string
---@param choices table
---@param onChange function?
local function addCycle(body, label, key, choices, onChange)
	local row = create("TextButton", {
		Size = UDim2.new(1, 0, 0, ROW_HEIGHT),
		BackgroundColor3 = THEME.element,
		BackgroundTransparency = 1,
		AutoButtonColor = false,
		Text = "",
		LayoutOrder = nextOrder(),
	}, body)

	create("UICorner", { CornerRadius = UDim.new(0, 10) }, row)
	addRowLabel(row, label)
	addHover(row)
	addRipple(row)

	local chipSize = UDim2.fromOffset(96, ROW_HEIGHT - 8)

	local chip = create("TextLabel", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -6, 0.5, 0),
		Size = chipSize,
		BackgroundColor3 = THEME.element,
		BorderSizePixel = 0,
		Font = Enum.Font.GothamBold,
		TextSize = 12,
	}, row)

	bindAccent(chip, "TextColor3")
	create("UICorner", { CornerRadius = UDim.new(0, 8) }, chip)

	local function refresh()
		chip.Text = State.config[key]
	end

	State.maid:give(row.MouseButton1Click:Connect(function()
		if isScrolling() then
			return
		end

		local index = table.find(choices, State.config[key]) or 0
		State.config[key] = choices[index % #choices + 1]
		refresh()
		chip.Size = UDim2.fromOffset(108, ROW_HEIGHT - 8)
		tween(chip, { Size = chipSize }, 0.25, Enum.EasingStyle.Back)

		if onChange then
			onChange(State.config[key])
		end
	end))

	table.insert(State.refreshers, refresh)
	registerEntry(body, row, label)
	refresh()
end

---@param body Frame
---@param text string
---@param callback function
---@param hoverColor Color3?
local function addButton(body, text, callback, hoverColor)
	local button = create("TextButton", {
		Size = UDim2.new(1, 0, 0, ROW_HEIGHT),
		BackgroundColor3 = THEME.element,
		BorderSizePixel = 0,
		AutoButtonColor = false,
		Font = Enum.Font.GothamMedium,
		TextSize = TEXT_SIZE,
		TextColor3 = THEME.text,
		Text = text,
		LayoutOrder = nextOrder(),
	}, body)

	create("UICorner", { CornerRadius = UDim.new(0, 10) }, button)
	addRipple(button)

	local function highlight(active)
		tween(button, { BackgroundColor3 = active and (hoverColor or THEME.accent) or THEME.element }, 0.15)
	end

	State.maid:give(button.MouseEnter:Connect(function()
		if not IS_TOUCH then
			highlight(true)
		end
	end))

	State.maid:give(button.MouseLeave:Connect(function()
		highlight(false)
	end))

	State.maid:give(button.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch then
			highlight(true)
		end
	end))

	State.maid:give(button.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch then
			highlight(false)
		end
	end))

	State.maid:give(button.MouseButton1Click:Connect(function()
		if isScrolling() then
			return
		end

		callback()
	end))

	registerEntry(body, button, text)
end

