--------------------------------------------------------------------------------
-- Roles. GetPlayerData reports every role, so roles are known before a weapon is drawn.
--------------------------------------------------------------------------------

local Roles = {
	entries = {},
	murderer = nil,
	remote = nil,
	lastRequest = 0,
	lastApplied = 0,
	fetching = false,
}

---Fold the server's role table into a cache.
---@param result table
function Roles.apply(result)
	local entries, murderer, sheriff = {}, nil, nil

	for name, info in result do
		if typeof(name) == "string" and typeof(info) == "table" then
			local role = typeof(info.Role) == "string" and info.Role or "Innocent"

			if role == "Hero" then
				role = "Sheriff"
			end

			entries[name] = { role = role, alive = not (info.Killed or info.Dead) }

			if role == "Murderer" then
				murderer = name
			elseif role == "Sheriff" and not sheriff then
				sheriff = name
			end
		end
	end

	-- Announce the round once, when a new murderer shows up in the data.
	if murderer and murderer ~= Roles.announced and State.config.roleAlert then
		local text = "Murderer: " .. murderer

		if murderer == localPlayer.Name then
			text = "You are the murderer."
		elseif sheriff then
			text = text .. "  |  Sheriff: " .. sheriff
		end

		notify("New Round", text, "info")
	end

	Roles.announced = murderer
	Roles.entries = entries
	Roles.murderer = murderer
	Roles.lastApplied = os.clock()
end

---Find the GetPlayerData remote function.
---@return RemoteFunction?
function Roles.findRemote()
	if Roles.remote and Roles.remote.Parent then
		return Roles.remote
	end

	local found = replicatedStorage:FindFirstChild("GetPlayerData", true)
	Roles.remote = found and found:IsA("RemoteFunction") and found or nil
	return Roles.remote
end

---Ask the server for roles. Rate limited, never blocks the caller, and times out.
function Roles.refresh()
	if Roles.fetching or os.clock() - Roles.lastRequest < ROLE_REFRESH then
		return
	end

	local remote = Roles.findRemote()
	if not remote then
		return
	end

	Roles.fetching = true
	Roles.lastRequest = os.clock()

	task.spawn(function()
		local finished, result = false, nil

		task.spawn(function()
			local success, value = pcall(remote.InvokeServer, remote)

			if success then
				result = value
			end

			finished = true
		end)

		local deadline = os.clock() + ROLE_TIMEOUT

		while not finished and os.clock() < deadline do
			task.wait(0.05)
		end

		Roles.fetching = false

		if finished and typeof(result) == "table" then
			Roles.apply(result)
		end
	end)
end

---Find a weapon in either the equipped Character or unequipped Backpack.
---@param player Player
---@param weaponName string
---@return boolean
local function hasPlayerWeapon(player, weaponName)
	local character = player.Character
	local backpack = player:FindFirstChildOfClass("Backpack")

	return (character ~= nil and character:FindFirstChild(weaponName) ~= nil)
		or (backpack ~= nil and backpack:FindFirstChild(weaponName) ~= nil)
end

---Infer role from the player's inventory, including unequipped tools.
---@param player Player
---@return string?
local function toolRole(player)
	if hasPlayerWeapon(player, "Knife") then
		return "Murderer"
	end

	if hasPlayerWeapon(player, "Gun") then
		return "Sheriff"
	end

	return nil
end

---Role and alive flag of a player.
---@param player Player
---@return string, boolean
function Roles.of(player)
	-- Inventory evidence takes priority so unequipped Knife/Gun tools are detected.
	local inventoryRole = toolRole(player)

	if inventoryRole then
		local entry = Roles.entries[player.Name]
		return inventoryRole, not (entry and entry.alive == false)
	end

	local entry = Roles.entries[player.Name]

	if entry and os.clock() - Roles.lastApplied < ROLE_FRESH then
		return entry.role, entry.alive
	end

	return "Innocent", true
end

---The current murderer, or nil.
---@return Player?
function Roles.murdererPlayer()
	if Roles.murderer and os.clock() - Roles.lastApplied < ROLE_FRESH then
		return playersService:FindFirstChild(Roles.murderer)
	end

	for _, player in playersService:GetPlayers() do
		if player ~= localPlayer and toolRole(player) == "Murderer" then
			return player
		end
	end

	return nil
end

