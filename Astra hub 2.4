---@param row GuiObject
local function addHover(row)
	State.maid:give(row.MouseEnter:Connect(function()
		if not IS_TOUCH then
			tween(row, { BackgroundTransparency = 0.7 })
		end
	end))

	State.maid:give(row.MouseLeave:Connect(function()
		tween(row, { BackgroundTransparency = 1 })
	end))

	State.maid:give(row.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch then
			tween(row, { BackgroundTransparency = 0.7 }, 0.08)
		end
	end))

	State.maid:give(row.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch then
			tween(row, { BackgroundTransparency = 1 }, 0.25)
		end
