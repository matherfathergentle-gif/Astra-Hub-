-- Ping and motion tracking.
--------------------------------------------------------------------------------

local Ping = { rttSeconds = 0.08 }

---Sample the round-trip time and smooth it.
function Ping.update()
	local success, milliseconds = pcall(function()
		return statsService.Network.ServerStatsItem["Data Ping"]:GetValue()
	end)

	local seconds = success and typeof(milliseconds) == "number" and milliseconds / 1000 or 0

	if seconds <= 0 then
		local ok, oneWay = pcall(function()
			return localPlayer:GetNetworkPing()
		end)

		seconds = ok and typeof(oneWay) == "number" and oneWay * 2 or 0
	end

	if seconds > 0 then
		Ping.rttSeconds += (seconds - Ping.rttSeconds) * PING_SMOOTHING
	end
end

local Tracker = { histories = {} }

---Record where a player is right now.
---@param player Player
---@param hrp BasePart
function Tracker.record(player, hrp)
	local history = Tracker.histories[player]

	if not history then
		history = {}
		Tracker.histories[player] = history
	end

	local now = os.clock()
	table.insert(history, { t = now, p = hrp.Position })

	while history[1] and (#history > MAX_SAMPLES or now - history[1].t > SAMPLE_WINDOW) do
		table.remove(history, 1)
	end
end

---Interpolated position at a past time.
---@param history table
---@param time number
---@return Vector3
function Tracker.positionAt(history, time)
	local count = #history

	if time <= history[1].t then
		return history[1].p
	end

	if time >= history[count].t then
		return history[count].p
	end

	for index = count - 1, 1, -1 do
		local before = history[index]

		if before.t <= time then
			local after = history[index + 1]
			local span = after.t - before.t

			if span <= 0 then
				return before.p
			end

			return before.p:Lerp(after.p, (time - before.t) / span)
		end
	end

	return history[1].p
end

---Velocity over a span, fitted through every sample with newer samples weighing more. Two end
---points are noisy at low frame rates, a weighted fit is not.
---@param history table
---@param from number
---@param to number
---@return Vector3?, number?
local function fitVelocity(history, from, to)
	local samples, count = {}, 0

	for index = #history, 1, -1 do
		local sample = history[index]

		if sample.t < from then
			break
		end

		if sample.t <= to then
			count += 1
			samples[count] = sample
		end
	end

	if count < 3 then
		return nil, nil
	end

	local tau = math.max((to - from) / 2, 0.02)
	local weightSum, timeSum, positionSum = 0, 0, Vector3.zero

	for _, sample in samples do
		local weight = math.exp(-(to - sample.t) / tau)
		weightSum += weight
		timeSum += weight * sample.t
		positionSum += weight * sample.p
	end

	local meanTime = timeSum / weightSum
	local meanPosition = positionSum / weightSum
	local variance, covariance = 0, Vector3.zero

	for _, sample in samples do
		local weight = math.exp(-(to - sample.t) / tau)
		local dt = sample.t - meanTime
		variance += weight * dt * dt
		covariance += weight * dt * (sample.p - meanPosition)
	end

	if variance < 1e-6 then
		return nil, nil
	end

	return covariance / variance, meanTime
end

---Velocity, acceleration, whether the player just reversed, and how steady the heading is (0 to 1).
---@param player Player
---@param window number
---@return Vector3, Vector3, boolean, number
function Tracker.motion(player, window)
	local history = Tracker.histories[player]

	if not history or #history < 4 then
		return Vector3.zero, Vector3.zero, false, 1
	end

	local now = history[#history].t

	if now - history[1].t < window * 0.6 then
		return Vector3.zero, Vector3.zero, false, 1
	end

	local recent, recentTime = fitVelocity(history, now - window, now)

	if not recent then
		return Vector3.zero, Vector3.zero, false, 1
	end

	local older, olderTime = fitVelocity(history, now - window * 2, now - window)

	if not older or recentTime - olderTime < 0.02 then
		return recent, Vector3.zero, false, 1
	end

	local acceleration = (recent - older) / (recentTime - olderTime)
	local reversing = recent.Magnitude > 2 and older.Magnitude > 2 and recent:Dot(older) < 0
	local stability = 1

	if recent.Magnitude > 1 and older.Magnitude > 1 then
		stability = math.clamp(0.5 + 0.5 * recent.Unit:Dot(older.Unit), 0, 1)
	end

	return recent, acceleration, reversing, stability
end

---Average position over the most recent window, or nil without enough samples.
---@param player Player
---@param window number
---@return Vector3?
function Tracker.meanPosition(player, window)
	local history = Tracker.histories[player]

	if not history or #history < 3 then
		return nil
	end

	local cutoff = history[#history].t - window
	local sum, count = Vector3.zero, 0

	for index = #history, 1, -1 do
		local sample = history[index]

		if sample.t < cutoff then
			break
		end

		sum += sample.p
		count += 1
	end

	if count < 3 then
		return nil
	end

	return sum / count
end

---Whether the target's height is changing like a jump. Read from the height trail itself, because
---the humanoid's floor state is not something other players' characters are guaranteed to report.
---@param player Player
---@return boolean
function Tracker.isJumping(player)
	local history = Tracker.histories[player]

	if not history or #history < 4 then
		return false
	end

	local now = history[#history].t
	local low, high = math.huge, -math.huge

	for index = #history, 1, -1 do
		local sample = history[index]

		if now - sample.t > 0.35 then
			break
		end

		low = math.min(low, sample.p.Y)
		high = math.max(high, sample.p.Y)
	end

	return high - low > 0.6
end

---Fit the target's current jump as a ballistic arc and predict its height `lead` seconds ahead.
---Gravity is known, so only the take-off height and speed are fitted, which is far steadier than
---extrapolating a noisy vertical velocity. A spam jumper (`rebound`) is assumed to take off again
---the moment it lands, so the prediction can continue into the next arc.
---@param player Player
---@param lead number
---@param rebound boolean
---@param takeoffSpeed number?
---@return table?
function Tracker.arc(player, lead, rebound, takeoffSpeed)
	local history = Tracker.histories[player]

	if not history or #history < 6 then
		return nil
	end

	local gravity = workspace.Gravity
	local count = #history
	local now = history[count].t
	local floorY = math.huge

	for _, sample in history do
		floorY = math.min(floorY, sample.p.Y)
	end

	-- The current arc begins at the latest low point near the floor, where the last jump started.
	local startIndex = 1

	for index = count - 2, 2, -1 do
		local y = history[index].p.Y

		if y <= history[index - 1].p.Y and y <= history[index + 1].p.Y and y <= floorY + 0.9 then
			startIndex = index
			break
		end
	end

	-- Too few samples since take-off to fit anything yet.
	if count - startIndex < 2 then
		return nil
	end

	local startTime = history[startIndex].t
	local rows = {}
	local weightSum, tauSum, adjustedSum = 0, 0, 0

	for index = startIndex, count do
		local sample = history[index]
		local tau = sample.t - startTime
		local weight = math.exp(-(now - sample.t) / 0.15)
		local adjusted = sample.p.Y + 0.5 * gravity * tau * tau

		table.insert(rows, { tau = tau, y = sample.p.Y, adjusted = adjusted, weight = weight })
		weightSum += weight
		tauSum += weight * tau
		adjustedSum += weight * adjusted
	end

	local tauMean, adjustedMean = tauSum / weightSum, adjustedSum / weightSum
	local variance, covariance = 0, 0

	for _, row in rows do
		local delta = row.tau - tauMean
		variance += row.weight * delta * delta
		covariance += row.weight * delta * (row.adjusted - adjustedMean)
	end

	if variance < 1e-6 then
		return nil
	end

	-- With gravity removed the height is a straight line: start height plus take-off speed times time.
	local speed = covariance / variance
	local start = adjustedMean - speed * tauMean
	local errorSum = 0

	for _, row in rows do
		local model = start + speed * row.tau - 0.5 * gravity * row.tau * row.tau
		errorSum += row.weight * (row.y - model) ^ 2
	end

	local fitError = math.sqrt(errorSum / weightSum)
	local fromFloor = math.abs(start - floorY) < 0.8
	local impact = (now + lead) - startTime
	local landing = (speed + math.sqrt(speed * speed + 2 * gravity * math.max(start - floorY, 0))) / gravity
	local predicted

	if impact <= landing then
		predicted = start + speed * impact - 0.5 * gravity * impact * impact
	elseif rebound then
		-- Landed before the shot arrives and jumps again: continue along the next arc.
		local launch = (fromFloor and speed > 20 and speed < 80) and speed or (takeoffSpeed or 50)
		local period = 2 * launch / gravity
		local into = (impact - landing) % period
		predicted = floorY + launch * into - 0.5 * gravity * into * into
	else
		predicted = floorY
	end

	return {
		y = math.clamp(predicted, floorY - 0.5, floorY + 14),
		error = fitError,
		speed = speed,
		fromFloor = fromFloor,
	}
end

--------------------------------------------------------------------------------
-- Target profiles. Mini avatars, spam jumpers and campers each break the plain "lead by
-- velocity" model in a different way, so they are detected per target. Every threshold below
-- comes from the live config, nothing is hardcoded.
--------------------------------------------------------------------------------

local Profiles = { cache = {} }

---@param player Player
---@return table
local function profileEntry(player)
	local entry = Profiles.cache[player]

	if not entry then
		entry = {
			height = 5.4,
			heightAt = -math.huge,
			jumps = {},
			vyTrail = {},
			lastTakeoff = -math.huge,
			jumpSpeed = nil,
			stillSince = nil,
			mini = false,
			spam = false,
			camper = false,
		}

		Profiles.cache[player] = entry
	end

	return entry
end

---Record per-frame evidence for a player: take-offs and how long they have stood still.
---@param player Player
---@param humanoid Humanoid?
---@param now number
function Profiles.observe(player, humanoid, now)
	local entry = profileEntry(player)
	local history = Tracker.histories[player]

	-- A take-off is a sudden upward burst right after a calm or falling moment. It is read from the
	-- height trail, so it works even when the humanoid's floor state is not reported.
	if history and #history >= 2 then
		local last, previous = history[#history], history[#history - 1]
		local dt = last.t - previous.t

		if dt > 0.001 then
			local vy = (last.p.Y - previous.p.Y) / dt
			local calm = math.huge

			for _, earlier in entry.vyTrail do
				calm = math.min(calm, earlier)
			end

			if vy > 28 and calm < 14 and now - entry.lastTakeoff > 0.25 then
				entry.lastTakeoff = now
				table.insert(entry.jumps, now)
			end

			table.insert(entry.vyTrail, vy)

			if #entry.vyTrail > 4 then
				table.remove(entry.vyTrail, 1)
			end
		end
	end

	while entry.jumps[1] and now - entry.jumps[1] > 2 do
		table.remove(entry.jumps, 1)
	end

	local velocity = Tracker.motion(player, 0.18)
	local speed = Vector3.new(velocity.X, 0, velocity.Z).Magnitude
	local walkSpeed = humanoid and humanoid.WalkSpeed or 16
	local stillSpeed = math.max(walkSpeed * State.config.stillThreshold / 100, 0.5)

	if speed <= stillSpeed and not Tracker.isJumping(player) then
		entry.stillSince = entry.stillSince or now
	else
		entry.stillSince = nil
	end
end

---Profile flags of a player. Height is re-measured once a second.
---@param player Player
---@param character Model?
---@return table
function Profiles.get(player, character)
	local config = State.config
	local now = os.clock()
	local entry = profileEntry(player)

	if character and now - entry.heightAt > 1 then
		entry.heightAt = now

		local success, _, size = pcall(function()
			return character:GetBoundingBox()
		end)

		if success and typeof(size) == "Vector3" and size.Y > 0.5 then
			entry.height = math.clamp(size.Y, 1, 14)
		end
	end

	local recentJumps = 0

	for _, takeoff in entry.jumps do
		if now - takeoff <= 1.6 then
			recentJumps += 1
		end
	end

	entry.mini = entry.height < config.miniHeight
	entry.spam = recentJumps >= config.spamJumpCount
	entry.camper = entry.stillSince ~= nil and now - entry.stillSince >= config.camperTime / 1000
	return entry
end

--------------------------------------------------------------------------------
-- Prediction. The position you see lags the server by your round trip and the target's own
-- latency, and the shot lands one way later, so the lead is built from the round trip.
--------------------------------------------------------------------------------

local Predictor = { tune = 1, pending = {}, lastQueue = 0, lastLead = 0, lastSpeed = 0, lastArcError = nil }

---Seconds to lead the target by.
---@return number
function Predictor.leadTime()
	local config = State.config
	return math.clamp(Ping.rttSeconds, 0, 0.6) * (config.leadPing / 100) + config.leadExtra / 1000
end

---Predict where a player will be when the shot lands. Every threshold is a config value.
---@param player Player
---@param part BasePart
---@return Vector3, number, Vector3
function Predictor.predict(player, part)
	local config = State.config
	local actual = part.Position

	if not config.predictionEnabled then
		return actual, 0, Vector3.zero
	end

	local lead = Predictor.leadTime()
	Predictor.lastLead = lead

	if lead <= 0 then
		return actual, 0, Vector3.zero
	end

	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local hrp = character and character:FindFirstChild("HumanoidRootPart")
	local profile = config.profilesEnabled and hrp and Profiles.get(player, character) or nil
	local velocity, acceleration, _, stability = Tracker.motion(player, config.predictionWindow / 1000)
	local horizontal = Vector3.new(velocity.X, 0, velocity.Z)
	local speed = horizontal.Magnitude
	Predictor.lastSpeed = speed

	-- A huge speed is a teleport or a fling, leading it would aim at nothing.
	local walkSpeed = humanoid and humanoid.WalkSpeed or 16

	if speed > math.max(walkSpeed * 3, 60) then
		return actual, lead, Vector3.zero
	end

	local camping = profile ~= nil and profile.camper

	-- A camper is not moving, so average out the network jitter instead of chasing it.
	if camping then
		local mean = Tracker.meanPosition(player, 0.3)

		if mean then
			actual = mean + (part.Position - hrp.Position)
		end
	end

	local model = Vector3.zero
	local stillSpeed = math.max(walkSpeed * config.stillThreshold / 100, 0.5)

	if not camping and speed > stillSpeed then
		model = horizontal * lead

		if config.predictionMode == "Smart" then
			local flat = Vector3.new(acceleration.X, 0, acceleration.Z)
			local accelerationTerm = flat * (0.5 * lead * lead) * (config.accelWeight / 100)
			local limit = model.Magnitude * 0.5

			if accelerationTerm.Magnitude > limit and limit > 0 then
				accelerationTerm = accelerationTerm.Unit * limit
			end

			model += accelerationTerm

			-- Erratic or reversing movement makes a straight line unreliable, so lead less of it.
			model *= 1 - (1 - stability) * config.reverseDamp / 100

			-- Slowing down must never turn into aiming behind the target.
			if model:Dot(horizontal) < 0 then
				model = Vector3.zero
			end
		end
	end

	local displacement = model * Predictor.tune

	if displacement.Magnitude > config.leadMax then
		displacement = displacement.Unit * config.leadMax
	end

	-- Stop the lead at the first wall, aiming into geometry is a guaranteed miss.
	if config.leadWallClamp and displacement.Magnitude > 0.5 then
		local ignore = { character }

		if localPlayer.Character then
			table.insert(ignore, localPlayer.Character)
		end

		if workspace.CurrentCamera then
			table.insert(ignore, workspace.CurrentCamera)
		end

		leadParams.FilterDescendantsInstances = ignore
		local result = workspace:Raycast(actual, displacement, leadParams)

		if result then
			local allowed = math.max((result.Position - actual).Magnitude - 0.6, 0)
			displacement = displacement.Unit * allowed
		end
	end

	-- Small avatars jump lower, so the vertical cap shrinks with their height.
	local heightScale = profile and math.clamp(profile.height / 5.4, 0.4, 1.3) or 1
	local verticalCap = config.verticalCap * heightScale
	local vertical = 0
	local base = actual + displacement

	if config.airPrediction and hrp and Tracker.isJumping(player) then
		local spamming = profile ~= nil and profile.spam
		local arc = config.spamJumpMode == "Arc" and Tracker.arc(player, lead, spamming, profile and profile.jumpSpeed) or nil

		if arc and arc.error <= config.arcTolerance then
			-- Jumps are ballistic, so the height at impact comes from the fitted arc, and the next
			-- one for a spam jumper, not from a noisy vertical velocity.
			vertical = math.clamp(arc.y - hrp.Position.Y, -verticalCap, verticalCap)
			Predictor.lastArcError = arc.error

			-- Remember how hard this player jumps so the next arc can be predicted before it starts.
			if profile and arc.fromFloor and arc.speed > 20 and arc.speed < 80 then
				profile.jumpSpeed = arc.speed
			end
		else
			-- No clean arc (stairs, a ramp, a take-off that only just began): lead the height in a
			-- straight line, and for a spam jumper aim at the middle of the arc as before.
			vertical = math.clamp(velocity.Y * lead, -verticalCap, verticalCap)

			if spamming then
				local mean = Tracker.meanPosition(player, 0.45)

				if mean then
					base = Vector3.new(base.X, mean.Y + (actual.Y - hrp.Position.Y), base.Z)
				end

				vertical *= config.spamJumpDamp / 100
			end
		end
	end

	return base + Vector3.new(0, vertical, 0), lead, model
end

---Remember a prediction so it can be compared with where the target really went.
---@param player Player
---@param model Vector3
---@param lead number
function Predictor.queue(player, model, lead)
	if not State.config.autoTune or model.Magnitude < 3 or lead <= 0 then
		return
	end

	local now = os.clock()

	if now - Predictor.lastQueue < 0.3 or #Predictor.pending >= 6 then
		return
	end

	local character = player.Character
	local hrp = character and character:FindFirstChild("HumanoidRootPart")

	if not hrp then
		return
	end

	Predictor.lastQueue = now
	table.insert(Predictor.pending, { hrp = hrp, base = hrp.Position, model = model, due = now + lead })
end

---Compare finished predictions with reality and nudge the lead gain towards what was observed.
function Predictor.resolve()
	if #Predictor.pending == 0 then
		return
	end

	local now = os.clock()

	for index = #Predictor.pending, 1, -1 do
		local entry = Predictor.pending[index]

		if now >= entry.due then
			table.remove(Predictor.pending, index)

			if entry.hrp.Parent then
				local actual = entry.hrp.Position - entry.base
				local length = entry.model.Magnitude

				if length > 0.001 then
					local ideal = math.clamp(actual:Dot(entry.model.Unit) / length, TUNE_MIN, TUNE_MAX)
					Predictor.tune = math.clamp(Predictor.tune + (ideal - Predictor.tune) * 0.12, TUNE_MIN, TUNE_MAX)
				end
			end
		end
	end
end

---Forget everything learned so far.
function Predictor.reset()
	Predictor.tune = 1
	table.clear(Predictor.pending)
end

--------------------------------------------------------------------------------
-- Target selection.
--------------------------------------------------------------------------------

---@param character Model
---@param part BasePart
---@return boolean
local function isVisible(character, part)
	local camera = workspace.CurrentCamera
	local origin = camera.CFrame.Position
	local filter = { camera }

	if localPlayer.Character then
		table.insert(filter, localPlayer.Character)
	end

	wallParams.FilterDescendantsInstances = filter
	local result = workspace:Raycast(origin, part.Position - origin, wallParams)
	return result == nil or result.Instance:IsDescendantOf(character)
end

---@param humanoid Humanoid
---@param screenDistance number
---@param worldDistance number
---@return number
local function scoreOf(humanoid, screenDistance, worldDistance)
	local priority = State.config.priority

	if priority == "Distance" then
		return worldDistance
	end

	if priority == "Health" then
		return humanoid.Health
	end

	return screenDistance
end

---Choose the player to aim at.
---@param camera Camera
---@return Player?
local function pickTarget(camera)
	local config = State.config
	local center = camera.ViewportSize / 2
	local cameraPosition = camera.CFrame.Position
	local candidates = {}

	for _, player in playersService:GetPlayers() do
		if player == localPlayer then
			continue
		end

		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		local hrp = character and character:FindFirstChild("HumanoidRootPart")

		if not (humanoid and hrp and humanoid.Health > 0) then
			continue
		end

		local role, alive = Roles.of(player)

		if not alive or (config.silentMurdererOnly and role ~= "Murderer") then
			continue
		end

		local worldDistance = (hrp.Position - cameraPosition).Magnitude

		if worldDistance > config.silentMaxDistance then
			continue
		end

		local screenPosition, onScreen = camera:WorldToViewportPoint(hrp.Position)
		local screenDistance = (Vector2.new(screenPosition.X, screenPosition.Y) - center).Magnitude

		if config.silentUseFov and (not onScreen or screenDistance > config.silentFov) then
			continue
		end

		if config.wallCheck and not isVisible(character, hrp) then
			continue
		end

		table.insert(candidates, { player = player, score = scoreOf(humanoid, screenDistance, worldDistance) })
	end

	local best, bestScore = nil, math.huge

	for _, info in candidates do
		if info.score < bestScore then
			best, bestScore = info.player, info.score
		end
	end

	local previous = State.targetPlayer

	if config.stickyTarget and previous and best ~= previous then
		for _, info in candidates do
			if info.player == previous and bestScore >= info.score * STICKY_MARGIN then
				best = previous
				break
			end
		end
	end

	return best
end

---The body part to aim at for the chosen hit mode.
---@param player Player
---@return BasePart?
local function chooseAimPart(player)
	local character = player.Character

	if not character then
		return nil
	end

	local mode = State.config.hitPart
	local head = character:FindFirstChild("Head")
	local torso = character:FindFirstChild("Torso") or character:FindFirstChild("UpperTorso") or character:FindFirstChild("HumanoidRootPart")

	-- Mini avatars and spam jumpers make the head a poor target, so the automatic modes fall back
	-- to the big stable torso hitbox for them. An explicit Head or Torso choice is always obeyed.
	local profile = State.config.profilesEnabled and Profiles.get(player, character) or nil
	local hardHead = profile ~= nil and (profile.mini or profile.spam)

	if mode == "Torso" then
		return torso
	end

	if mode == "Random" then
		if hardHead then
			return torso
		end

		return (State.headRoll and head) or torso
	end

	if mode == "Auto" then
		if hardHead then
			return torso
		end

		-- One hit kills, so the big torso is the safer target. The head is only worth taking when
		-- the lead is small enough that the smaller hitbox will still be hit.
		local velocity = Tracker.motion(player, State.config.predictionWindow / 1000)
		local expectedLead = Vector3.new(velocity.X, 0, velocity.Z).Magnitude * Predictor.leadTime()

		if head and expectedLead <= State.config.headMaxLead and isVisible(character, head) then
			return head
		end

		return torso
	end

	return head or torso
end

---Prefer the chosen part, but when a wall hides it and another part of the same body is in view,
---aim at the visible one so a peeking target can still be hit.
---@param player Player
---@return BasePart?
local function getAimPart(player)
	local chosen = chooseAimPart(player)
	local character = player.Character

	if not (chosen and character and State.config.partFallback) or isVisible(character, chosen) then
		return chosen
	end

	for _, name in AIM_FALLBACK_ORDER do
		local candidate = character:FindFirstChild(name)

		if candidate and candidate ~= chosen and candidate:IsA("BasePart") and isVisible(character, candidate) then
			return candidate
		end
	end

	return chosen
end

---@return boolean
local function isHoldingGun()
	local character = localPlayer.Character
	return character ~= nil and character:FindFirstChild("Gun") ~= nil
end

---@return boolean
local function hasGunAnywhere()
	if isHoldingGun() then
		return true
	end

	local backpack = localPlayer:FindFirstChildOfClass("Backpack")
	return backpack ~= nil and backpack:FindFirstChild("Gun") ~= nil
end

--------------------------------------------------------------------------------
-- Silent aim. The gun fires Shoot:FireServer(originCFrame, targetCFrame), so the second CFrame is
-- replaced with the predicted position. The hook is installed once per session and re-pointed on
-- every execution, so running the script again never stacks hooks.
--------------------------------------------------------------------------------

local Silent = { shootRemote = nil, lastSearch = 0, pending = {}, hits = 0, total = 0, stats = {} }

---Find the Shoot RemoteEvent.
---@return RemoteEvent?
function Silent.findRemote()
	if Silent.shootRemote and Silent.shootRemote.Parent then
		return Silent.shootRemote
	end

	if os.clock() - Silent.lastSearch < 2 then
		return nil
	end

	Silent.lastSearch = os.clock()

	local function search(root)
		if not root then
			return nil
		end

		for _, descendant in root:GetDescendants() do
			if descendant.Name == "Shoot" and descendant:IsA("RemoteEvent") then
				return descendant
			end
		end

		return nil
	end

	local character = localPlayer.Character
	local backpack = localPlayer:FindFirstChildOfClass("Backpack")
	local gun = (character and character:FindFirstChild("Gun")) or (backpack and backpack:FindFirstChild("Gun"))

	Silent.shootRemote = search(replicatedStorage) or search(gun)

	if not Silent.shootRemote and getnilinstances then
		local success, instances = pcall(getnilinstances)

		if success and typeof(instances) == "table" then
			for _, instance in instances do
				if instance.Name == "Shoot" and instance:IsA("RemoteEvent") then
					Silent.shootRemote = instance
					break
				end
			end
		end
	end

	return Silent.shootRemote
end

---Remember a shot so it can be scored once the target is dead or the shot has clearly missed. The
---kind of target is stored too, so accuracy can be compared between normal, spam jump, camper and
---mini targets.
---@param player Player
function Silent.logShot(player)
	local profile = Profiles.cache[player]
	local tag = "Normal"

	if profile then
		tag = (profile.spam and "Spam") or (profile.camper and "Camper") or (profile.mini and "Mini") or "Normal"
	end

	table.insert(Silent.pending, { player = player, time = os.clock(), tag = tag })

	if #Silent.pending > 20 then
		table.remove(Silent.pending, 1)
	end
end

---@param tag string
---@param hit boolean
local function scoreShot(tag, hit)
	local entry = Silent.stats[tag]

	if not entry then
		entry = { hits = 0, total = 0 }
		Silent.stats[tag] = entry
	end

	entry.total += 1
	Silent.total += 1

	if hit then
		entry.hits += 1
		Silent.hits += 1
	end
end

---Score finished shots: a dead target within a second of the shot counts as a hit.
function Silent.resolveShots()
	if #Silent.pending == 0 then
		return
	end

	local now = os.clock()

	for index = #Silent.pending, 1, -1 do
		local shot = Silent.pending[index]
		local character = shot.player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")

		if not humanoid or humanoid.Health <= 0 then
			scoreShot(shot.tag, true)
			table.remove(Silent.pending, index)
		elseif now - shot.time > 1.2 then
			scoreShot(shot.tag, false)
			table.remove(Silent.pending, index)
		end
	end
end

---Redirect a shot's target CFrame. Returns the new arguments, or nil to leave the shot alone.
---Uses property reads only, a method call here would change the namecall method.
---@param remote Instance
---@return table?
function Silent.redirect(remote, ...)
	local config = State.config

	if not (config.silentAim and State.holdingGun and State.hitRoll) then
		return nil
	end

	if remote.ClassName ~= "RemoteEvent" or not string.find(string.lower(remote.Name), "shoot", 1, true) then
		return nil
	end

	local args = table.pack(...)

	if typeof(args[1]) ~= "CFrame" or typeof(args[2]) ~= "CFrame" then
		return nil
	end

	local target = State.target

	if not target then
		return nil
	end

	-- Recompute at the moment of firing so the lead uses the newest motion data.
	local success, position = pcall(Predictor.predict, target.player, target.part)

	if not success or typeof(position) ~= "Vector3" then
		position = target.aimPosition
	end

	args[2] = CFrame.new(position)
	State.shotsRedirected += 1
	Silent.logShot(target.player)
	return args
end

---Legacy redirect of ray based aiming, only used when the toggle is on.
---@param self Instance
---@param method string
---@return table?
function Silent.redirectRay(self, method, ...)
	local target = State.target

	if not (State.config.legacyRedirect and target and State.holdingGun and State.hitRoll) then
		return nil
	end

	local aimPosition = target.aimPosition

	if self ~= workspace then
		return nil
	end

	local args = table.pack(...)

	if RAY_METHODS[method] then
		local ray = args[1]

		if typeof(ray) == "Ray" and ray.Direction.Magnitude >= MIN_RAY_LENGTH then
			local offset = aimPosition - ray.Origin
			args[1] = Ray.new(ray.Origin, offset.Unit * ray.Direction.Magnitude)
			return args
		end
	elseif method == "Raycast" then
		local origin, direction = args[1], args[2]

		if typeof(origin) == "Vector3" and typeof(direction) == "Vector3" and direction.Magnitude >= MIN_RAY_LENGTH then
			args[2] = (aimPosition - origin).Unit * direction.Magnitude
			return args
		end
	end

	return nil
end

---@param original function
---@param self any
local function namecallHandler(original, self, ...)
	local method = getnamecallmethod()
	local config = State.config

	-- Nearly every call in the game passes through here, so anything this script does not care
	-- about is handed straight back before any other work is done.
	if State.detached or not (config.silentAim or config.legacyRedirect) then
		return original(self, ...)
	end

	if method ~= "FireServer" and not config.legacyRedirect then
		return original(self, ...)
	end

	if checkcaller() then
		return original(self, ...)
	end

	if typeof(self) == "Instance" then
		local arguments = nil

		-- Camera rays are redirected after the fact, because the answer is the ray itself.
		if State.config.legacyRedirect and (method == "ScreenPointToRay" or method == "ViewportPointToRay") then
			local target = State.target

			if target and State.holdingGun and State.hitRoll and self == workspace.CurrentCamera then
				if setnamecallmethod then
					setnamecallmethod(method)
				end

				local ray = original(self, ...)

				if typeof(ray) == "Ray" then
					local offset = target.aimPosition - ray.Origin

					if offset.Magnitude > 0.001 then
						return Ray.new(ray.Origin, offset.Unit * ray.Direction.Magnitude)
					end
				end

				return ray
			end
		end

		if method == "FireServer" then
			arguments = Silent.redirect(self, ...)
		elseif State.config.legacyRedirect then
			arguments = Silent.redirectRay(self, method, ...)
		end

		if arguments then
			if setnamecallmethod then
				setnamecallmethod(method)
			end

			return original(self, table.unpack(arguments, 1, arguments.n))
		end
	end

	return original(self, ...)
end

---@param original function
---@param self any
---@param key any
local function indexHandler(original, self, key)
	local target = State.target

	if State.detached or not State.config.legacyRedirect or not target or not State.holdingGun or checkcaller() then
		return original(self, key)
	end

	local mouse = State.mouse

	if self ~= mouse then
		return original(self, key)
	end

	if key == "Hit" then
		return CFrame.new(target.aimPosition)
	elseif key == "Target" then
		return target.part
	end

	return original(self, key)
end

---The __index hook sees every property read in the game, so it is only installed once the legacy
---redirect is actually switched on.
function Silent.ensureIndexHook()
	local registry = shared.AstraHubMM2Hooks

	if not (registry and hookmetamethod) then
		return
	end

	if not registry.indexHooked then
		registry.indexHooked = true

		local originalIndex
		originalIndex = hookmetamethod(game, "__index", wrapClosure(function(self, key)
			local handler = registry.index

			if handler then
				return handler(originalIndex, self, key)
			end

			return originalIndex(self, key)
		end))
	end

	State.mouse = State.mouse or localPlayer:GetMouse()
	registry.index = indexHandler
end

---Install the namecall hook once and point it at this instance.
---@return boolean
function Silent.install()
	if not (hookmetamethod and getnamecallmethod and checkcaller) then
		return false
	end

	local registry = shared.AstraHubMM2Hooks

	if not registry then
		registry = { namecall = nil, index = nil, indexHooked = false }
		shared.AstraHubMM2Hooks = registry

		local originalNamecall
		originalNamecall = hookmetamethod(game, "__namecall", wrapClosure(function(self, ...)
			local handler = registry.namecall

			if handler then
				return handler(originalNamecall, self, ...)
			end

			return originalNamecall(self, ...)
		end))
	end

	State.mouse = localPlayer:GetMouse()
	registry.namecall = namecallHandler

	if State.config.legacyRedirect then
		Silent.ensureIndexHook()
	end

	State.hookInstalled = true
	return true
end

---Remove this instance from the hooks.
function Silent.uninstall()
	local registry = shared.AstraHubMM2Hooks

	if registry then
		registry.namecall = nil
		registry.index = nil
	end

	State.hookInstalled = false
end

---Equip the gun and fire one predicted shot at whoever the current settings choose.
---@return boolean, string?
function Silent.fire(forced)
	if State.detached then
		return false, "Hub is unloaded"
	end

	if os.clock() - State.lastShot < SHOOT_DEBOUNCE then
		return false, "Too fast"
	end

	local character = localPlayer.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")

	if not (character and humanoid and humanoid.Health > 0) then
		return false, "You are not alive"
	end

	local backpack = localPlayer:FindFirstChildOfClass("Backpack")
	local gun = character:FindFirstChild("Gun") or (backpack and backpack:FindFirstChild("Gun"))

	if not gun then
		return false, "You do not have the gun"
	end

	local camera = workspace.CurrentCamera

	if not camera then
		return false, "No camera"
	end

	-- Same targeting rules as the live silent aim (murderer only, distance, FOV, wall check,
	-- priority), so this button obeys every targeting setting instead of keeping its own.
	local target = forced or pickTarget(camera)

	if not target then
		return false, State.config.silentMurdererOnly and "No murderer in range" or "No target in range"
	end

	local part = getAimPart(target)

	if not part then
		return false, "No part to aim at"
	end

	local remote = Silent.findRemote()

	if not remote then
		return false, "Shoot remote not found"
	end

	if gun.Parent ~= character then
		humanoid:EquipTool(gun)
		task.wait(0.12)
	end

	local position = Predictor.predict(target, part)
	local origin = camera.CFrame

	State.lastShot = os.clock()
	remote:FireServer(origin, CFrame.new(position))
	Silent.logShot(target)
	return true, nil
end

---Entry point for buttons and keys: an error becomes a message instead of a stack trace.
---@return boolean, string?
function Silent.shoot(forced)
	local success, ok, reason = pcall(Silent.fire, forced)

	if not success then
		return false, tostring(ok)
	end

	return ok, reason
end

