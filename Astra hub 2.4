---@param body Frame
---@param label string
---@param key string
---@param onChange function?
local function addToggle(body, label, key, onChange)
	local row = create("TextButton", {
		Size = UDim2.new(1, 0, 0, ROW_HEIGHT),
		BackgroundColor3 = THEME.element,
		BackgroundTransparency = 1,
		AutoButtonColor = false,
		Text = "",
		LayoutOrder = nextOrder(),
	}, body)

	create("UICorner", { CornerRadius = UDim.new(0, 10) }, row)
	addRowLabel(row, label)
	addHover(row)
	addRipple(row)

	local track = create("Frame", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -6, 0.5, 0),
		Size = UDim2.fromOffset(44, 24),
		BackgroundColor3 = THEME.element,
		BorderSizePixel = 0,
	}, row)

	create("UICorner", { CornerRadius = UDim.new(1, 0) }, track)

	local trackStroke = create("UIStroke", { Thickness = 2, Transparency = 1 }, track)
	bindAccent(trackStroke, "Color")

	local knob = create("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 3, 0.5, 0),
		Size = UDim2.fromOffset(18, 18),
		BackgroundColor3 = THEME.text,
		BorderSizePixel = 0,
	}, track)

	create("UICorner", { CornerRadius = UDim.new(1, 0) }, knob)

	local function refresh()
		local enabled = State.config[key]
		tween(track, { BackgroundColor3 = enabled and THEME.accent or THEME.element }, 0.2)
		tween(trackStroke, { Transparency = enabled and 0.55 or 1 }, 0.25)
		tween(knob, { Position = enabled and UDim2.new(1, -21, 0.5, 0) or UDim2.new(0, 3, 0.5, 0) }, 0.3, Enum.EasingStyle.Back)
	end

	State.maid:give(row.MouseButton1Down:Connect(function()
		tween(knob, { Size = UDim2.fromOffset(22, 18) }, 0.1)
	end))

	State.maid:give(row.MouseButton1Up:Connect(function()
		tween(knob, { Size = UDim2.fromOffset(18, 18) }, 0.1)
	end))

	State.maid:give(row.MouseButton1Click:Connect(function()
		if isScrolling() then
			return
		end

		State.config[key] = not State.config[key]
		refresh()

		if onChange then
			onChange(State.config[key])
		end
	end))

	table.insert(State.refreshers, refresh)
	registerEntry(body, row, label)
	refresh()
end

