local function sanitizeConfig()
	for key, limits in CONFIG_LIMITS do
		local value = State.config[key]

		-- A NaN is the only number that is not equal to itself.
		if typeof(value) ~= "number" or value ~= value then
			State.config[key] = DEFAULT_CONFIG[key]
		else
			State.config[key] = math.clamp(value, limits[1], limits[2])
		end
	end

	for key, choices in CONFIG_CHOICES do
		if not table.find(choices, State.config[key]) then
			State.config[key] = DEFAULT_CONFIG[key]
		end
	end
end

