---@param wrapper Frame
local function dismissToast(wrapper)
	if State.detached then
		return
	end

	local index = table.find(State.toasts, wrapper)

	if not index then
		return
	end

	table.remove(State.toasts, index)

	local toast = wrapper:FindFirstChild("Toast")

	if toast then
		tween(toast, { Position = UDim2.fromOffset(TOAST_WIDTH + 40, 0) }, 0.22, Enum.EasingStyle.Back)
	end

	task.delay(0.25, function()
		if not State.detached then
			wrapper:Destroy()
		end
	end)
end

---@param title string
---@param message string
---@param kind string?
local function showToast(title, message, kind)
	if State.detached or not State.notifyHolder then
		return
	end

	local color = THEME.accent
	local iconText = "i"

	if kind == "success" then
		color = THEME.success
		iconText = "OK"
	elseif kind == "error" then
		color = THEME.danger
		iconText = "!"
	end

	if #State.toasts >= TOAST_MAX then
		dismissToast(State.toasts[1])
	end

	local wrapper = create("Frame", {
		Size = UDim2.fromOffset(TOAST_WIDTH, 58),
		BackgroundTransparency = 1,
		LayoutOrder = -nextOrder(),
	}, State.notifyHolder)

	local toast = create("TextButton", {
		Name = "Toast",
		Position = UDim2.fromOffset(TOAST_WIDTH + 40, 0),
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = THEME.card,
		BorderSizePixel = 0,
		AutoButtonColor = false,
		ClipsDescendants = true,
		Text = "",
	}, wrapper)

	create("UICorner", { CornerRadius = UDim.new(0, 10) }, toast)
	create("UIStroke", { Color = THEME.stroke, Thickness = 1 }, toast)

	local icon = create("TextLabel", {
		Position = UDim2.fromOffset(10, 16),
		Size = UDim2.fromOffset(26, 26),
		BackgroundColor3 = color,
		BorderSizePixel = 0,
		Font = Enum.Font.GothamBlack,
		TextSize = 11,
		TextColor3 = Color3.fromRGB(10, 12, 20),
		Text = iconText,
	}, toast)

	create("UICorner", { CornerRadius = UDim.new(1, 0) }, icon)

	create("TextLabel", {
		Position = UDim2.fromOffset(46, 9),
		Size = UDim2.new(1, -54, 0, 18),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		TextSize = 13,
		TextColor3 = THEME.text,
		TextXAlignment = Enum.TextXAlignment.Left,
		Text = title,
	}, toast)

	create("TextLabel", {
		Position = UDim2.fromOffset(46, 28),
		Size = UDim2.new(1, -54, 0, 18),
		BackgroundTransparency = 1,
		Font = Enum.Font.Gotham,
		TextSize = 12,
		TextColor3 = THEME.subText,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Text = message,
	}, toast)

	local progress = create("Frame", {
		Position = UDim2.new(0, 0, 1, -3),
		Size = UDim2.new(1, 0, 0, 3),
		BackgroundColor3 = color,
		BorderSizePixel = 0,
	}, toast)

	table.insert(State.toasts, wrapper)
	tween(toast, { Position = UDim2.fromOffset(0, 0) }, 0.4, Enum.EasingStyle.Back)
	tween(icon, { Rotation = 360 }, 0.5, Enum.EasingStyle.Quint)
	tweenService:Create(progress, TweenInfo.new(3.5, Enum.EasingStyle.Linear), { Size = UDim2.new(0, 0, 0, 3) }):Play()

	toast.MouseButton1Click:Connect(function()
		dismissToast(wrapper)
	end)

	task.delay(3.5, function()
		dismissToast(wrapper)
	end)
end

