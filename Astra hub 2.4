local function refreshAll()
	for _, refresh in State.refreshers do
		refresh()
	end
end

---@return number
local function nextOrder()
	State.layoutOrder += 1
	return State.layoutOrder
end

---@param className string
---@param properties table
---@param parent Instance?
---@return Instance
local function create(className, properties, parent)
	local instance = Instance.new(className)

	for property, value in properties do
		instance[property] = value
	end

	instance.Parent = parent
	return instance
end

---@param instance Instance
---@param goal table
---@param duration number?
---@param style Enum.EasingStyle?
---@return Tween
local function tween(instance, goal, duration, style)
	local info = TweenInfo.new(duration or 0.15, style or Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	local playing = tweenService:Create(instance, info, goal)
	playing:Play()
	return playing
end

---@param instance Instance
---@param property string
local function bindAccent(instance, property)
	instance[property] = THEME.accent
	table.insert(State.accentBound, { instance = instance, property = property })
end

---@return ColorSequence
local function accentSequence()
	return ColorSequence.new(THEME.accent, THEME.accent2)
end

---@param gradient UIGradient
---@param spin boolean?
---@return UIGradient
local function registerGradient(gradient, spin)
	gradient.Color = accentSequence()
	table.insert(State.gradients, gradient)

	if spin then
		table.insert(State.spinners, gradient)
	end

	return gradient
end

---@param name string
local function applyTheme(name)
	for _, preset in THEME_PRESETS do
		if preset.name == name then
			THEME.accent = preset.accent
			THEME.accent2 = preset.accent2
			break
		end
	end

	for _, entry in State.accentBound do
		tween(entry.instance, { [entry.property] = THEME.accent }, 0.25)
	end

	for _, gradient in State.gradients do
		gradient.Color = accentSequence()
	end

	refreshAll()
end

local function syncConfig()
	applyTheme(State.config.theme)

	if State.syncInterface then
		State.syncInterface()
	end
end

---@return boolean
local function saveConfig()
	return (pcall(function()
		if not isfolder(CONFIG_FOLDER) then
			makefolder(CONFIG_FOLDER)
		end

		State.config.learnedGain = Predictor.tune

		writefile(CONFIG_PATH, httpService:JSONEncode(State.config))
	end))
end

---@param onlyIfAuto boolean?
---@return boolean
local function loadConfig(onlyIfAuto)
	local success, decoded = pcall(function()
		if not isfile(CONFIG_PATH) then
			return nil
		end

		return httpService:JSONDecode(readfile(CONFIG_PATH))
	end)

	if not success or typeof(decoded) ~= "table" then
		return false
	end

	-- A saved config is used unless it was saved with Auto Load switched off.
	if onlyIfAuto and decoded.autoLoad == false then
		return false
	end

	for key, value in decoded do
		if typeof(State.config[key]) == typeof(value) then
			State.config[key] = value
		end
	end

	sanitizeConfig()
	Predictor.tune = State.config.learnedGain
	syncConfig()
	return true
end

local function resetConfig()
	for key, value in DEFAULT_CONFIG do
		State.config[key] = value
	end

	Predictor.reset()
	syncConfig()
end

