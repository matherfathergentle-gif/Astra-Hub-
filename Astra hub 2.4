-- Startup and shutdown.
--------------------------------------------------------------------------------

---@param name string
---@param callback function
local function runStage(name, callback)
	local success, result = xpcall(callback, function(message)
		return tostring(message) .. "\n" .. debug.traceback()
	end)

	if success then
		return
	end

	table.insert(State.errors, name .. ": " .. tostring(result))
	warn("Astra Hub stage failed: " .. name)
	warn(result)
end

local function showErrors()
	if #State.errors == 0 then
		return
	end

	pcall(function()
		local gui = Instance.new("ScreenGui")
		gui.Name = "AstraHubMM2Errors"
		gui.ResetOnSpawn = false
		gui.IgnoreGuiInset = true
		gui.DisplayOrder = 1000
		gui.Parent = State.guiParent or getGuiParent()

		local box = Instance.new("TextButton")
		box.AnchorPoint = Vector2.new(0.5, 0)
		box.Position = UDim2.new(0.5, 0, 0, 20)
		box.Size = UDim2.new(0.92, 0, 0, 0)
		box.AutomaticSize = Enum.AutomaticSize.Y
		box.BackgroundColor3 = Color3.fromRGB(40, 12, 16)
		box.BorderSizePixel = 0
		box.Font = Enum.Font.Code
		box.TextSize = 12
		box.TextColor3 = Color3.fromRGB(255, 170, 170)
		box.TextWrapped = true
		box.TextXAlignment = Enum.TextXAlignment.Left
		box.TextYAlignment = Enum.TextYAlignment.Top
		box.Text = string.sub("Astra Hub had problems loading (tap to close):\n\n" .. table.concat(State.errors, "\n\n"), 1, 1200)
		box.Parent = gui

		box.MouseButton1Click:Connect(function()
			gui:Destroy()
		end)
	end)
end

---Load a logo from the workspace folder when one is there. No logo falls back to a drawn letter.
---@return string?
local function loadLogo()
	local success, asset = pcall(function()
		if isfile(LOGO_PATH) then
			return getcustomasset(LOGO_PATH)
		end

		return nil
	end)

	return success and asset or nil
end

function AstraHub.init()
	task.wait()

	if not game:IsLoaded() then
		game.Loaded:Wait()
	end

	State.noDrawing = not pcall(function()
		Drawing.new("Line"):Remove()
	end)

	State.logoAsset = loadLogo()
	task.wait()

	runStage("bomb controllers", function()
		State.bombController = createBombController(NORMAL_BOMB_NAME, "bombCooldown")
		State.goldBombController = createBombController(GOLD_BOMB_NAME, "goldBombCooldown")
	end)

	-- Load the saved config first, so the hooks, targeting and menu all start from it.
	runStage("config", function()
		State.configLoaded = loadConfig(true)
	end)

	runStage("menu", createMenu)
	task.wait()

	runStage("players", function()
		for _, player in playersService:GetPlayers() do
			addEsp(player)
		end

		State.maid:give(playersService.PlayerAdded:Connect(addEsp))
		State.maid:give(playersService.PlayerRemoving:Connect(removePlayer))
	end)

	runStage("gun esp", GunEsp.start)

	runStage("loops", function()
		State.maid:give(runService.RenderStepped:Connect(onRender))
	end)

	task.wait()
	runStage("silent aim hook", Silent.install)
	runStage("keybinds", installKeybinds)
	runStage("bomb taps", installBombTapListener)
	showErrors()

	if not State.hookInstalled then
		notify("Silent Aim", "This executor has no hookmetamethod, only the SHOOT button works.", "error")
	end

	if State.noDrawing then
		notify("Compatibility", "No Drawing library. ESP uses chams and name tags.", "info")
	end
end

function AstraHub.detach()
	State.detached = true
	State.target = nil
	Silent.uninstall()
	State.maid:clean()

	for _, esp in State.esp do
		esp:destroy()
	end

	State.esp = {}
	GunEsp.clear()
	State.fovRing = nil
	State.targetLine = nil
	State.targetDot = nil
	State.predictionDot = nil
	State.notifyImpl = nil
end

---@param error any
local function onInitializeError(error)
	table.insert(State.errors, "init: " .. tostring(error))
	warn("Failed to initialize.")
	warn(error)
	warn(debug.traceback())
	showErrors()
	AstraHub.detach()
end

if shared.AstraHubMM2 then
	pcall(shared.AstraHubMM2.detach)
end

shared.AstraHubMM2 = AstraHub
xpcall(AstraHub.init, onInitializeError)
