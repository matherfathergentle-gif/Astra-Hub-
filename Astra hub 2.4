---@param page ScrollingFrame
---@param title string
---@param startCollapsed boolean?
---@return Frame
local function addSection(page, title, startCollapsed)
	local card = create("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = THEME.card,
		BorderSizePixel = 0,
		LayoutOrder = nextOrder(),
	}, page)

	create("UICorner", { CornerRadius = UDim.new(0, 9) }, card)
	create("UIStroke", { Color = THEME.stroke, Thickness = 1 }, card)
	create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder }, card)

	local header = create("TextButton", {
		Size = UDim2.new(1, 0, 0, ROW_HEIGHT + 2),
		BackgroundTransparency = 1,
		AutoButtonColor = false,
		Text = "",
		LayoutOrder = 1,
	}, card)

	addRipple(header)

	local dot = create("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 12, 0.5, 0),
		Size = UDim2.fromOffset(6, 6),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
	}, header)

	create("UICorner", { CornerRadius = UDim.new(1, 0) }, dot)
	registerGradient(create("UIGradient", { Rotation = 45 }, dot))

	create("TextLabel", {
		Position = UDim2.fromOffset(26, 0),
		Size = UDim2.new(1, -56, 1, 0),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		TextSize = 12,
		TextColor3 = THEME.text,
		TextXAlignment = Enum.TextXAlignment.Left,
		Text = string.upper(title),
	}, header)

	local arrow = create("TextLabel", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -14, 0.5, 0),
		Size = UDim2.fromOffset(16, 16),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		TextSize = 14,
		TextColor3 = THEME.subText,
		Text = ">",
		Rotation = 90,
	}, header)

	local body = create("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		BackgroundTransparency = 1,
		ClipsDescendants = true,
		LayoutOrder = 2,
	}, card)

	local layout = create("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }, body)
	create("UIPadding", { PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10), PaddingTop = UDim.new(0, 2), PaddingBottom = UDim.new(0, 4) }, body)

	local section = {
		card = card,
		title = string.lower(title),
		pageName = State.pageNames[page],
		entries = {},
		collapsed = false,
	}

	local function expandedHeight()
		return layout.AbsoluteContentSize.Y + 10
	end

	function section.setCollapsed(collapsed)
		section.collapsed = collapsed
		tween(arrow, { Rotation = collapsed and 0 or 90 }, 0.25, Enum.EasingStyle.Back)
		tween(body, { Size = UDim2.new(1, 0, 0, collapsed and 0 or expandedHeight()) }, 0.28, Enum.EasingStyle.Quint)
	end

	State.maid:give(layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
		if not section.collapsed then
			body.Size = UDim2.new(1, 0, 0, expandedHeight())
		end
	end))

	State.maid:give(header.MouseButton1Click:Connect(function()
		if isScrolling() then
			return
		end

		section.setCollapsed(not section.collapsed)
	end))

	State.sections[body] = section

	if startCollapsed then
		section.collapsed = true
		arrow.Rotation = 0
		body.Size = UDim2.new(1, 0, 0, 0)
	end

	return body
end

