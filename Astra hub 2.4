---@param className string
---@return table
local function newDrawing(className)
	if not State.noDrawing then
		local success, drawing = pcall(function()
			return Drawing.new(className)
		end)

		if success and drawing then
			return drawing
		end

		State.noDrawing = true
	end

	return setmetatable({}, {
		__index = function(_, key)
			if key == "Remove" or key == "Destroy" then
				return function() end
			end
		end,
		__newindex = function() end,
	})
end

local PlayerEsp = {}
PlayerEsp.__index = PlayerEsp

---@param player Player
function PlayerEsp.new(player)
	local self = setmetatable({}, PlayerEsp)
	self.player = player
	self.highlight = nil
	self.tag = nil
	self.box = newDrawing("Square")
	self.box.Thickness = 1
	self.box.Filled = false
	self.label = newDrawing("Text")
	self.label.Size = 13
	self.label.Center = true
	self.label.Outline = true
	self.label.Color = Color3.fromRGB(255, 255, 255)
	self.healthBar = newDrawing("Line")
	self.healthBar.Thickness = 2
	self.tracer = newDrawing("Line")
	self.tracer.Thickness = 1
	return self
end

function PlayerEsp:hideDrawings()
	self.box.Visible = false
	self.label.Visible = false
	self.healthBar.Visible = false
	self.tracer.Visible = false
end

function PlayerEsp:hide()
	self:hideDrawings()

	if self.highlight then
		self.highlight.Enabled = false
	end

	if self.tag then
		self.tag.Enabled = false
	end
end

---@param character Model
---@param color Color3
function PlayerEsp:updateChams(character, color)
	if not ((State.config.espChams or State.noDrawing) and State.guiParent) then
		if self.highlight then
			self.highlight.Enabled = false
		end

		return
	end

	local highlight = self.highlight

	if not highlight then
		highlight = Instance.new("Highlight")
		highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		highlight.FillTransparency = 0.65
		highlight.OutlineTransparency = 0
		highlight.OutlineColor = Color3.new(1, 1, 1)
		highlight.Parent = State.guiParent
		self.highlight = highlight
	end

	highlight.Adornee = character
	highlight.FillColor = color
	highlight.Enabled = true
end

---@param character Model
---@param text string
function PlayerEsp:updateTag(character, text)
	local head = character:FindFirstChild("Head")

	if not (head and State.guiParent and text ~= "") then
		if self.tag then
			self.tag.Enabled = false
		end

		return
	end

	local tag = self.tag

	if not tag then
		tag = Instance.new("BillboardGui")
		tag.AlwaysOnTop = true
		tag.Size = UDim2.fromOffset(240, 22)
		tag.StudsOffset = Vector3.new(0, 2.6, 0)
		tag.Parent = State.guiParent

		local label = Instance.new("TextLabel")
		label.Name = "Label"
		label.Size = UDim2.fromScale(1, 1)
		label.BackgroundTransparency = 1
		label.Font = Enum.Font.GothamBold
		label.TextSize = 13
		label.TextColor3 = Color3.new(1, 1, 1)
		label.TextStrokeTransparency = 0
		label.Parent = tag
		self.tag = tag
	end

	tag.Adornee = head
	tag.Enabled = true
	tag.Label.Text = text
end

function PlayerEsp:update()
	local config = State.config
	local camera = workspace.CurrentCamera
	local character = self.player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local hrp = character and character:FindFirstChild("HumanoidRootPart")

	if not (config.espEnabled and camera and humanoid and hrp and humanoid.Health > 0) then
		return self:hide()
	end

	local distance = (camera.CFrame.Position - hrp.Position).Magnitude

	if distance > config.espMaxDistance then
		return self:hide()
	end

	local role = Roles.of(self.player)

	if config.espHideInnocents and role == "Innocent" then
		return self:hide()
	end

	local color = ROLE_COLORS[role] or Color3.fromRGB(220, 220, 220)
	self:updateChams(character, color)

	local parts = {}

	if config.espNames then
		table.insert(parts, self.player.Name)
	end

	if config.espRoles then
		table.insert(parts, "[" .. role .. "]")
	end

	if config.espWeapon then
		if hasPlayerWeapon(self.player, "Knife") then
			table.insert(parts, "(Knife)")
		elseif hasPlayerWeapon(self.player, "Gun") then
			table.insert(parts, "(Gun)")
		end
	end

	if config.espDistance then
		table.insert(parts, "[" .. math.floor(distance) .. "m]")
	end

	local labelText = table.concat(parts, " ")

	if State.noDrawing then
		return self:updateTag(character, labelText)
	end

	-- Drawing objects use viewport coordinates.
	local rootPosition, onScreen = camera:WorldToViewportPoint(hrp.Position)

	if not onScreen then
		return self:hideDrawings()
	end

	-- Box height follows the real avatar size, so mini avatars no longer get a full size box.
	local avatarHeight = Profiles.get(self.player, character).height
	local topPosition = camera:WorldToViewportPoint(hrp.Position + Vector3.new(0, avatarHeight * 0.55, 0))
	local bottomPosition = camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, avatarHeight * 0.6, 0))
	local height = math.abs(bottomPosition.Y - topPosition.Y)
	local width = height * 0.6

	self.box.Visible = config.espBoxes
	self.box.Color = color
	self.box.Size = Vector2.new(width, height)
	self.box.Position = Vector2.new(rootPosition.X - width / 2, topPosition.Y)

	self.label.Visible = labelText ~= ""
	self.label.Text = labelText
	self.label.Position = Vector2.new(rootPosition.X, topPosition.Y - 16)

	local ratio = math.clamp(humanoid.Health / humanoid.MaxHealth, 0, 1)
	local barX = rootPosition.X - width / 2 - 5

	self.healthBar.Visible = config.espHealth
	self.healthBar.Color = Color3.fromRGB(255, 0, 0):Lerp(Color3.fromRGB(0, 255, 0), ratio)
	self.healthBar.From = Vector2.new(barX, topPosition.Y + height)
	self.healthBar.To = Vector2.new(barX, topPosition.Y + height - height * ratio)

	self.tracer.Visible = config.espTracers
	self.tracer.Color = color
	self.tracer.From = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y)
	self.tracer.To = Vector2.new(rootPosition.X, topPosition.Y + height)
end

function PlayerEsp:destroy()
	self.box:Remove()
	self.label:Remove()
	self.healthBar:Remove()
	self.tracer:Remove()

	if self.highlight then
		self.highlight:Destroy()
		self.highlight = nil
	end

	if self.tag then
		self.tag:Destroy()
		self.tag = nil
	end
end

---@param player Player
local function addEsp(player)
	if player == localPlayer or State.esp[player] then
		return
	end

	State.esp[player] = PlayerEsp.new(player)
end

---@param player Player
local function removePlayer(player)
	Tracker.histories[player] = nil
	Profiles.cache[player] = nil

	local esp = State.esp[player]

	if not esp then
		return
	end

	esp:destroy()
	State.esp[player] = nil
end

--------------------------------------------------------------------------------
-- Gun ESP. The sheriff's gun drops on the map as "GunDrop" when they die.
--------------------------------------------------------------------------------

local GUN_COLOR = Color3.fromRGB(255, 205, 60)

local GunMarker = {}
GunMarker.__index = GunMarker

---@param instance Instance
---@return table
function GunMarker.new(instance)
	local self = setmetatable({}, GunMarker)
	self.instance = instance
	self.highlight = nil
	self.tag = nil
	self.label = newDrawing("Text")
	self.label.Size = 15
	self.label.Center = true
	self.label.Outline = true
	self.label.Color = GUN_COLOR
	self.box = newDrawing("Square")
	self.box.Thickness = 2
	self.box.Filled = false
	self.box.Color = GUN_COLOR
	self.tracer = newDrawing("Line")
	self.tracer.Thickness = 1.5
	self.tracer.Color = GUN_COLOR
	return self
end

---The part the marker is anchored to.
---@return BasePart?
function GunMarker:anchor()
	local instance = self.instance

	if not instance.Parent then
		return nil
	end

	if instance:IsA("BasePart") then
		return instance
	end

	local handle = instance:FindFirstChild("Handle")

	if handle and handle:IsA("BasePart") then
		return handle
	end

	return instance:FindFirstChildWhichIsA("BasePart", true)
end

function GunMarker:hide()
	self.label.Visible = false
	self.box.Visible = false
	self.tracer.Visible = false

	if self.highlight then
		self.highlight.Enabled = false
	end

	if self.tag then
		self.tag.Enabled = false
	end
end

---@param camera Camera
function GunMarker:update(camera)
	local config = State.config
	local part = self:anchor()

	if not (config.gunEsp and part) then
		return self:hide()
	end

	local position = part.Position
	local distance = (camera.CFrame.Position - position).Magnitude
	local text = string.format("GUN [%dm]", math.floor(distance))

	if (config.gunEspChams or State.noDrawing) and State.guiParent then
		local highlight = self.highlight

		if not highlight then
			highlight = Instance.new("Highlight")
			highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
			highlight.FillTransparency = 0.45
			highlight.OutlineTransparency = 0
			highlight.FillColor = GUN_COLOR
			highlight.OutlineColor = Color3.new(1, 1, 1)
			highlight.Parent = State.guiParent
			self.highlight = highlight
		end

		local instance = self.instance
		highlight.Adornee = (instance:IsA("BasePart") or instance:IsA("Model")) and instance or part
		highlight.Enabled = true
	elseif self.highlight then
		self.highlight.Enabled = false
	end

	-- Without a Drawing library a name tag on the gun stands in for the on-screen marker.
	if State.noDrawing then
		if not State.guiParent then
			return
		end

		local tag = self.tag

		if not tag then
			tag = Instance.new("BillboardGui")
			tag.AlwaysOnTop = true
			tag.Size = UDim2.fromOffset(160, 22)
			tag.StudsOffset = Vector3.new(0, 2, 0)
			tag.Parent = State.guiParent

			local label = Instance.new("TextLabel")
			label.Name = "Label"
			label.Size = UDim2.fromScale(1, 1)
			label.BackgroundTransparency = 1
			label.Font = Enum.Font.GothamBold
			label.TextSize = 14
			label.TextColor3 = GUN_COLOR
			label.TextStrokeTransparency = 0
			label.Parent = tag
			self.tag = tag
		end

		tag.Adornee = part
		tag.Enabled = true
		tag.Label.Text = text
		return
	end

	-- Drawing objects use viewport coordinates.
	local screen, onScreen = camera:WorldToViewportPoint(position)
	local viewport = camera.ViewportSize
	local center = viewport / 2
	local point = Vector2.new(screen.X, screen.Y)

	-- A gun that is off screen sticks to the edge of the screen, pointing the way to it.
	if not onScreen then
		local direction = point - center

		if screen.Z < 0 then
			direction = -direction
		end

		if direction.Magnitude < 1 then
			direction = Vector2.new(0, -1)
		end

		local scaleX = math.abs(direction.X) > 0.001 and (center.X - 40) / math.abs(direction.X) or math.huge
		local scaleY = math.abs(direction.Y) > 0.001 and (center.Y - 40) / math.abs(direction.Y) or math.huge
		point = center + direction * math.min(scaleX, scaleY)
	end

	self.label.Visible = true
	self.label.Text = text
	self.label.Position = point - Vector2.new(0, 24)
	self.box.Visible = onScreen
	self.box.Size = Vector2.new(18, 18)
	self.box.Position = point - Vector2.new(9, 9)
	self.tracer.Visible = config.gunEspTracer
	self.tracer.From = Vector2.new(viewport.X / 2, viewport.Y)
	self.tracer.To = point
end

function GunMarker:destroy()
	self.label:Remove()
	self.box:Remove()
	self.tracer:Remove()

	if self.highlight then
		self.highlight:Destroy()
		self.highlight = nil
	end

	if self.tag then
		self.tag:Destroy()
		self.tag = nil
	end
end

local GunEsp = { markers = {}, ready = false }

---@param instance Instance
---@return boolean
function GunEsp.isGunDrop(instance)
	if string.lower(instance.Name) ~= "gundrop" then
		return false
	end

	return instance:IsA("BasePart") or instance:IsA("Model") or instance:IsA("Tool")
end

---@param instance Instance
function GunEsp.consider(instance)
	if GunEsp.markers[instance] or not GunEsp.isGunDrop(instance) then
		return
	end

	-- A part inside an already tracked drop is the same gun.
	if instance.Parent and GunEsp.markers[instance.Parent] then
		return
	end

	GunEsp.markers[instance] = GunMarker.new(instance)

	if GunEsp.ready and State.config.gunAlert then
		notify("Gun Dropped", "The sheriff's gun is on the ground.", "info")
	end
end

---@param instance Instance
function GunEsp.forget(instance)
	local marker = GunEsp.markers[instance]

	if marker then
		marker:destroy()
		GunEsp.markers[instance] = nil
	end
end

---Track drops that appear later, and find one that is already on the map.
function GunEsp.start()
	State.maid:give(workspace.DescendantAdded:Connect(GunEsp.consider))
	State.maid:give(workspace.DescendantRemoving:Connect(GunEsp.forget))

	task.spawn(function()
		local processed = 0

		for _, descendant in workspace:GetDescendants() do
			if State.detached then
				return
			end

			GunEsp.consider(descendant)
			processed += 1

			-- Maps are large, so the first pass yields now and then instead of stalling a frame.
			if processed % 2000 == 0 then
				task.wait()
			end
		end

		GunEsp.ready = true
	end)
end

---@param camera Camera
function GunEsp.update(camera)
	for _, marker in GunEsp.markers do
		marker:update(camera)
	end
end

---The closest dropped gun, as a part you can touch.
---@return BasePart?
function GunEsp.nearestPart()
	local camera = workspace.CurrentCamera
	local origin = camera and camera.CFrame.Position
	local bestPart, bestDistance = nil, math.huge

	for _, marker in GunEsp.markers do
		local part = marker:anchor()

		if part then
			local distance = origin and (origin - part.Position).Magnitude or 0

			if distance < bestDistance then
				bestPart, bestDistance = part, distance
			end
		end
	end

	return bestPart
end

---@return number?
function GunEsp.nearestDistance()
	local camera = workspace.CurrentCamera

	if not camera then
		return nil
	end

	local best = nil

	for _, marker in GunEsp.markers do
		local part = marker:anchor()

		if part then
			local distance = (camera.CFrame.Position - part.Position).Magnitude

			if not best or distance < best then
				best = distance
			end
		end
	end

	return best
end

function GunEsp.clear()
	for instance, marker in GunEsp.markers do
		marker:destroy()
		GunEsp.markers[instance] = nil
	end
end

--------------------------------------------------------------------------------
-- Get Gun. Picks up the dropped gun by touching it from where you stand, or by standing on it
-- for a moment and then going straight back.
--------------------------------------------------------------------------------

local GunGrab = { busy = false }

---Wait until the gun shows up in the character or backpack.
---@param seconds number
---@return boolean
local function waitForGun(seconds)
	local deadline = os.clock() + seconds

	while os.clock() < deadline do
		if State.detached then
			return false
		end

		if hasGunAnywhere() then
			return true
		end

		task.wait(0.05)
	end

	return hasGunAnywhere()
end

---@return boolean, string?
function GunGrab.attempt()
	if State.detached then
		return false, "Hub is unloaded"
	end

	if GunGrab.busy then
		return false, "Already grabbing the gun"
	end

	if hasGunAnywhere() then
		return false, "You already have the gun"
	end

	local character = localPlayer.Character
	local hrp = character and character:FindFirstChild("HumanoidRootPart")
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")

	if not (hrp and humanoid and humanoid.Health > 0) then
		return false, "You are not alive"
	end

	if State.myRole == "Murderer" then
		return false, "The murderer cannot pick up the gun"
	end

	local drop = GunEsp.nearestPart()

	if not drop then
		return false, "No gun on the map"
	end

	GunGrab.busy = true

	local method = State.config.gunGrabMethod
	local got = false

	-- Touching it from where you stand does not move you at all.
	if (method == "Auto" or method == "Touch") and firetouchinterest then
		pcall(firetouchinterest, hrp, drop, 0)
		pcall(firetouchinterest, hrp, drop, 1)
		got = waitForGun(1)
	end

	-- Otherwise stand on it, then go straight back to where you were.
	if not got and (method == "Auto" or method == "Teleport") then
		local origin = hrp.CFrame

		pcall(function()
			hrp.CFrame = CFrame.new(drop.Position + Vector3.new(0, 3, 0))
			hrp.AssemblyLinearVelocity = Vector3.zero
		end)

		got = waitForGun(1.5)

		pcall(function()
			hrp.CFrame = origin
			hrp.AssemblyLinearVelocity = Vector3.zero
		end)
	end

	GunGrab.busy = false

	if got then
		return true, nil
	end

	return false, "The gun could not be picked up"
end

---Entry point for buttons and keys. The busy flag is always released, even if something errors
---halfway through, so one bad grab can never block every later one.
---@return boolean, string?
function GunGrab.run()
	if GunGrab.busy then
		return false, "Already grabbing the gun"
	end

	local success, ok, reason = pcall(GunGrab.attempt)
	GunGrab.busy = false

	if not success then
		return false, tostring(ok)
	end

	return ok, reason
end

--------------------------------------------------------------------------------
-- Automation. Both features only ever act when their own switch is on.
--------------------------------------------------------------------------------

local Automation = { lastShoot = 0, lastGrab = 0 }

---Fire at the murderer on its own, but only when the shot is clear, in range and the delay passed.
---@param target table
---@param now number
function Automation.autoShoot(target, now)
	local config = State.config

	if now - Automation.lastShoot < config.autoShootDelay / 1000 then
		return
	end

	-- Whatever the targeting settings allow, this never fires at anyone but the murderer.
	if (Roles.of(target.player)) ~= "Murderer" then
		return
	end

	local camera = workspace.CurrentCamera
	local character = target.player.Character

	if not (camera and character) then
		return
	end

	if (camera.CFrame.Position - target.part.Position).Magnitude > config.autoShootRange then
		return
	end

	if not isVisible(character, target.part) then
		return
	end

	Automation.lastShoot = now

	task.spawn(function()
		Silent.shoot(target.player)
	end)
end

---Pick up a dropped gun as soon as there is one and you are allowed to hold it.
---@param now number
function Automation.autoGetGun(now)
	if not State.config.autoGetGun or now - Automation.lastGrab < 2 or GunGrab.busy then
		return
	end

	if State.hasGun or State.myRole == "Murderer" or next(GunEsp.markers) == nil then
		return
	end

	Automation.lastGrab = now

	task.spawn(function()
		local ok = GunGrab.run()

		if ok then
			notify("Auto Get Gun", "Picked up the gun.", "success")
		end
	end)
end

--------------------------------------------------------------------------------
-- Bomb jump.
--------------------------------------------------------------------------------

---@param remote RemoteFunction
---@param timeoutSeconds number
local function invokeServerWithTimeout(remote, timeoutSeconds, ...)
	local args = table.pack(...)
	local finished = false
	local bindable = Instance.new("BindableEvent")

	task.spawn(function()
		pcall(function()
			remote:InvokeServer(table.unpack(args, 1, args.n))
		end)

		if not finished then
			finished = true
			bindable:Fire()
		end
	end)

	task.delay(timeoutSeconds, function()
		if not finished then
			finished = true
			bindable:Fire()
		end
	end)

	bindable.Event:Wait()
	bindable:Destroy()
end

---@return RemoteFunction?
local function findReplicateToyRemote()
	local remotes = replicatedStorage:FindFirstChild("Remotes")
	local extras = remotes and remotes:FindFirstChild("Extras")
	return extras and extras:FindFirstChild("ReplicateToy")
end

---@param toyName string
---@param cooldownKey string
---@return table
local function createBombController(toyName, cooldownKey)
	local controller = {
		toyName = toyName,
		onCooldown = false,
		debounce = false,
		-- Only a fresh respawn locks the throw. Starting locked meant BOMB and GOLD did nothing
		-- until the first death after loading the script.
		justRespawned = false,
		label = nil,
	}

	local function resetCooldown()
		controller.onCooldown = false

		if controller.label then
			controller.label.Text = "READY"
		end
	end

	local function startCooldown()
		controller.onCooldown = true
		controller.debounce = false

		local duration = math.floor(State.config[cooldownKey])

		task.spawn(function()
			for seconds = duration, 1, -1 do
				if State.detached or not controller.onCooldown then
					return
				end

				if controller.label then
					controller.label.Text = tostring(seconds)
				end

				task.wait(1)
			end

			if not State.detached and controller.onCooldown then
				resetCooldown()
			end
		end)
	end

	function controller.isHolding()
		local character = localPlayer.Character
		return character ~= nil and character:FindFirstChild(toyName) ~= nil
	end

	local function getToy()
		local character = localPlayer.Character

		if not character then
			return nil
		end

		local tool = character:FindFirstChild(toyName)

		if tool then
			return tool
		end

		local backpack = localPlayer:FindFirstChildOfClass("Backpack")

		if backpack then
			tool = backpack:FindFirstChild(toyName)

			if tool then
				tool.Parent = character
				return tool
			end
		end

		local replicateToy = findReplicateToyRemote()

		if not replicateToy then
			return nil
		end

		invokeServerWithTimeout(replicateToy, 3, toyName)

		for _ = 1, BOMB_FETCH_ATTEMPTS do
			tool = character:FindFirstChild(toyName)

			if tool then
				return tool
			end

			if backpack then
				tool = backpack:FindFirstChild(toyName)

				if tool then
					tool.Parent = character
					return tool
				end
			end

			task.wait(0.05)
		end

		return nil
	end

	local function unequip()
		task.delay(BOMB_UNEQUIP_DELAY, function()
			if State.detached then
				return
			end

			local character = localPlayer.Character
			local tool = character and character:FindFirstChild(toyName)

			if tool then
				tool.Parent = localPlayer:FindFirstChildOfClass("Backpack") or character
			end
		end)
	end

	function controller.throw()
		if State.detached or controller.onCooldown or controller.debounce or controller.justRespawned then
			return false
		end

		controller.debounce = true

		task.delay(BOMB_DEBOUNCE, function()
			controller.debounce = false
		end)

		local tool = getToy()

		if not tool then
			return false
		end

		local character = localPlayer.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		local hrp = character and character:FindFirstChild("HumanoidRootPart")
		local camera = workspace.CurrentCamera

		if not (humanoid and hrp and camera) then
			return false
		end

		local position = hrp.Position + camera.CFrame.LookVector * BOMB_THROW_DISTANCE
		local remote = tool:FindFirstChild("Remote")

		if remote then
			pcall(function()
				remote:FireServer(CFrame.new(position), 50)
			end)
		end

		pcall(function()
			humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
		end)

		unequip()
		task.delay(0.1, startCooldown)
		return true
	end

	State.maid:give(localPlayer.CharacterAdded:Connect(function()
		resetCooldown()
		controller.justRespawned = true

		task.delay(1, function()
			if not State.detached then
				controller.justRespawned = false
			end
		end)
	end))

	return controller
end

---@param controller table
---@param enabledKey string
local function autoThrowIfHolding(controller, enabledKey)
	if State.config[enabledKey] and controller.isHolding() then
		controller.throw()
	end
end

