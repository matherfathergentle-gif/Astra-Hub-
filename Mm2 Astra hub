local success, retargeted = pcall(retargetShots, args[1], targetPart)
if success then
args[1] = retargeted
return oldNamecall(self, table.unpack(args, 1, args.n))
end
end
end
if method == "ScreenPointToRay" or method == "ViewportPointToRay" then
if self == workspace.CurrentCamera then
local ray = oldNamecall(self, ...)
return Ray.new(ray.Origin, redirectDirection(ray.Origin, ray.Direction, targetPart.Position))
end
end
if self == workspace then
if RAY_METHODS[method] then
local args = table.pack(...)
local ray = args[1]
if typeof(ray) == "Ray" and ray.Direction.Magnitude >= MIN_RAY_LENGTH then
args[1] = Ray.new(ray.Origin, redirectDirection(ray.Origin, ray.Direction, targetPart.Position))
return oldNamecall(self, table.unpack(args, 1, args.n))
end
elseif method == "Raycast" then
local args = table.pack(...)
local origin, direction = args[1], args[2]
if typeof(origin) == "Vector3" and typeof(direction) == "Vector3" and direction.Magnitude >= MIN_RAY_LENGTH then
args[2] = redirectDirection(origin, direction, targetPart.Position)
return oldNamecall(self, table.unpack(args, 1, args.n))
end
end
end
return oldNamecall(self, ...)
end))
local oldIndex
oldIndex = hookmetamethod(game, "__index", wrapClosure(function(self, key)
if self ~= mouse then
return oldIndex(self, key)
end
local target = State.target
if State.detached or not target or not State.hitRoll or not isAimbotActive() or not State.holdingGun or checkcaller() then
return oldIndex(self, key)
end
if key == "Hit" then
return CFrame.new(target.part.Position)
elseif key == "Target" then
