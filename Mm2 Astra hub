local function getClosestPlayer()
local closest, closestScore, candidates = nil, math.huge, {}
local currentCamera = workspace.CurrentCamera
local screenCenter = currentCamera.ViewportSize / 2
local cameraPosition = currentCamera.CFrame.Position
local config = State.config
for _, player in ipairs(playersService:GetPlayers()) do
if player == localPlayer then continue end
local character = player.Character
if not character then continue end
local hrp = character:FindFirstChild("HumanoidRootPart")
local humanoid = character:FindFirstChild("Humanoid")
if not (hrp and humanoid and humanoid.Health > 0) then continue end
if config.murdererOnly and getRole(player) ~= "Murderer" then continue end
local worldDistance = (hrp.Position - cameraPosition).Magnitude
if worldDistance > config.aimMaxDistance then continue end
local screenPos, onScreen = currentCamera:WorldToViewportPoint(hrp.Position)
if not onScreen then continue end
local dist = (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude
if dist > config.fovRadius then continue end
if config.wallCheck and not isVisible(character, hrp) then continue end
table.insert(candidates, {
player = player,
score = getScore(humanoid, dist, worldDistance),
})
end
for _, info in ipairs(candidates) do
if info.score < closestScore then
closest = info.player
closestScore = info.score
end
end
local previous = State.lastTarget
if config.stickyTarget and previous and closest ~= previous then
for _, info in ipairs(candidates) do
if info.player == previous then
if closestScore >= info.score * STICKY_MARGIN then
closest = previous
end
break
end
end
end
return closest
end
