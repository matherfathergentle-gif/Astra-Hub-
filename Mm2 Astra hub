end
local function isShotTable(value)
if typeof(value) ~= "table" then
return false
end
local first = value[1]
return typeof(first) == "table" and typeof(first.Hit) == "Instance"
end
local function redirectDirection(origin, direction, position)
local offset = position - origin
if offset.Magnitude < 0.001 then
return direction
end
return offset.Unit * direction.Magnitude
end
local function retargetShots(shots, part)
local retargeted = {}
local camera = workspace.CurrentCamera
for index, shot in ipairs(shots) do
if typeof(shot) ~= "table" then
retargeted[index] = shot
continue
end
local newShot = table.clone(shot)
local ray = shot.RayObject
local origin = typeof(ray) == "Ray" and ray.Origin or camera.CFrame.Position
newShot.RayObject = Ray.new(origin, part.Position - origin)
newShot.Distance = (part.Position - origin).Magnitude
newShot.Cframe = part.CFrame
newShot.Hit = part
retargeted[index] = newShot
end
return retargeted
end
