local function keepOnScreen(frame)
local camera = workspace.CurrentCamera
if not camera then
return
end
local viewport = camera.ViewportSize
local position, size = frame.AbsolutePosition, frame.AbsoluteSize
local margin = 44
local shiftX, shiftY = 0, 0
if position.X + size.X < margin then
shiftX = margin - (position.X + size.X)
elseif position.X > viewport.X - margin then
shiftX = (viewport.X - margin) - position.X
end
if position.Y < 0 then
shiftY = -position.Y
elseif position.Y > viewport.Y - margin then
shiftY = (viewport.Y - margin) - position.Y
end
if shiftX ~= 0 or shiftY ~= 0 then
frame.Position = frame.Position + UDim2.fromOffset(shiftX, shiftY)
end
end
local function makeDraggable(handle, frame, onClick)
local dragging, dragInput, dragStart, startPosition, moved = false, nil, nil, nil, false
State.maid:give(handle.InputBegan:Connect(function(input)
if not isPointerInput(input) then return end
dragging = true
moved = false
dragInput = input
dragStart = input.Position
startPosition = frame.Position
end))
State.maid:give(userInputService.InputChanged:Connect(function(input)
if not dragging then return end
if input ~= dragInput and input.UserInputType ~= Enum.UserInputType.MouseMovement then return end
local delta = input.Position - dragStart
if not moved and delta.Magnitude < DRAG_THRESHOLD then return end
moved = true
frame.Position = UDim2.new(startPosition.X.Scale, startPosition.X.Offset + delta.X, startPosition.Y.Scale, startPosition.Y.Offset + delta.Y)
end))
State.maid:give(userInputService.InputEnded:Connect(function(input)
if not dragging then return end
if input ~= dragInput and not isPointerInput(input) then return end
dragging = false
if moved then
keepOnScreen(frame)
elseif onClick then
onClick()
end
end))
end
