local function applySearch(query)
query = string.lower(query)
local total, pageMatches = 0, {}
for _, section in pairs(State.sections) do
local titleMatch = query ~= "" and string.find(section.title, query, 1, true) ~= nil
local anyVisible = false
for _, entry in ipairs(section.entries) do
local visible = query == "" or titleMatch or string.find(entry.text, query, 1, true) ~= nil
entry.row.Visible = visible
if visible then
anyVisible = true
total += 1
pageMatches[section.pageName] = (pageMatches[section.pageName] or 0) + 1
end
end
section.card.Visible = query == "" or anyVisible
if query ~= "" and anyVisible and section.collapsed then
section.setCollapsed(false)
end
end
emptyLabel.Visible = query ~= "" and total == 0
for name, button in pairs(tabButtons) do
tween(button, { TextTransparency = (query ~= "" and not pageMatches[name]) and 0.6 or 0 })
end
if query ~= "" and total > 0 and not pageMatches[State.currentTab] then
for _, name in ipairs(tabOrder) do
if pageMatches[name] then
selectTab(name)
break
end
end
end
end
