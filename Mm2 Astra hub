function PlayerEsp:update()
local config = State.config
local camera = workspace.CurrentCamera
local character = self.player.Character
local humanoid = character and character:FindFirstChildOfClass("Humanoid")
local hrp = character and character:FindFirstChild("HumanoidRootPart")
if not (config.espEnabled and camera and humanoid and hrp and humanoid.Health > 0) then
return self:hide()
end
local distance = (camera.CFrame.Position - hrp.Position).Magnitude
if distance > config.espMaxDistance then
return self:hide()
end
local role = getRole(self.player)
local color = ROLE_COLORS[role] or Color3.fromRGB(220, 220, 220)
self:updateChams(character, color)
local parts = {}
if config.espNames then
table.insert(parts, self.player.Name)
end
if config.espRoles then
table.insert(parts, "[" .. role .. "]")
end
if config.espDistance then
table.insert(parts, "[" .. math.floor(distance) .. "m]")
end
local labelText = table.concat(parts, " ")
if State.noDrawing then
return self:updateTag(character, labelText)
end
local rootPos, onScreen = camera:WorldToViewportPoint(hrp.Position)
if not onScreen then
return self:hideDrawings()
end
local topPos = camera:WorldToViewportPoint(hrp.Position + Vector3.new(0, 3, 0))
local bottomPos = camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3.5, 0))
local height = math.abs(bottomPos.Y - topPos.Y)
local width = height * 0.6
self.box.Visible = config.espBoxes
self.box.Color = color
self.box.Size = Vector2.new(width, height)
self.box.Position = Vector2.new(rootPos.X - width / 2, topPos.Y)
self.label.Visible = labelText ~= ""
self.label.Text = labelText
self.label.Position = Vector2.new(rootPos.X, topPos.Y - 16)
local ratio = math.clamp(humanoid.Health / humanoid.MaxHealth, 0, 1)
local barX = rootPos.X - width / 2 - 5
self.healthBar.Visible = config.espHealth
self.healthBar.Color = Color3.fromRGB(255, 0, 0):Lerp(Color3.fromRGB(0, 255, 0), ratio)
self.healthBar.From = Vector2.new(barX, topPos.Y + height)
self.healthBar.To = Vector2.new(barX, topPos.Y + height - height * ratio)
self.tracer.Visible = config.espTracers
self.tracer.Color = color
self.tracer.From = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y)
self.tracer.To = Vector2.new(rootPos.X, topPos.Y + height)
end
